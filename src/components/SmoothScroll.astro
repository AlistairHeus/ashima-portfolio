---
/**
 * Global Lenis controller synchronized with GSAP ScrollTrigger.
 * Touch scrolling remains native; wheel input receives subtle smoothing.
 */
---

<script>
  import { gsap } from 'gsap';
  import Lenis from 'lenis';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  type SmoothScrollWindow = Window & {
    __portfolioLenis?: Lenis;
    __portfolioLenisCleanup?: () => void;
  };

  const smoothWindow = window as SmoothScrollWindow;
  const reduceMotionQuery = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  );

  /**
   * Creates a Lenis instance and wires it to GSAP's animation frame.
   */
  const createSmoothScroll = (): (() => void) => {
    const lenis = new Lenis({
      autoRaf: false,
      anchors: true,
      duration: 1.05,
      easing: (time) => Math.min(1, 1.001 - Math.pow(2, -10 * time)),
      smoothWheel: true,
      syncTouch: false,
      wheelMultiplier: 0.9,
    });

    const updateScrollTrigger = () => ScrollTrigger.update();
    const updateLenis = (time: number) => lenis.raf(time * 1000);

    lenis.on('scroll', updateScrollTrigger);
    gsap.ticker.add(updateLenis);
    gsap.ticker.lagSmoothing(0);
    smoothWindow.__portfolioLenis = lenis;
    ScrollTrigger.refresh();

    return () => {
      lenis.off('scroll', updateScrollTrigger);
      gsap.ticker.remove(updateLenis);
      lenis.destroy();

      if (smoothWindow.__portfolioLenis === lenis) {
        delete smoothWindow.__portfolioLenis;
      }
    };
  };

  let destroySmoothScroll: (() => void) | undefined;

  /**
   * Enables or disables smoothing when reduced-motion preference changes.
   */
  const syncMotionPreference = () => {
    destroySmoothScroll?.();
    destroySmoothScroll = undefined;

    if (!reduceMotionQuery.matches) {
      destroySmoothScroll = createSmoothScroll();
    }
  };

  smoothWindow.__portfolioLenisCleanup?.();
  syncMotionPreference();

  /**
   * Removes global listeners and the current Lenis instance.
   */
  const cleanup = () => {
    reduceMotionQuery.removeEventListener('change', syncMotionPreference);
    destroySmoothScroll?.();
    destroySmoothScroll = undefined;

    if (smoothWindow.__portfolioLenisCleanup === cleanup) {
      delete smoothWindow.__portfolioLenisCleanup;
    }
  };

  smoothWindow.__portfolioLenisCleanup = cleanup;
  reduceMotionQuery.addEventListener('change', syncMotionPreference);
  document.addEventListener('astro:before-swap', cleanup, { once: true });
</script>
