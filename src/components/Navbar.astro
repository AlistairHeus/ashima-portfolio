---
/**
 * Site navigation — floating paper-tag bar with pin holes.
 * Hides on scroll down, reveals on scroll up.
 * Active link reads as a slight stamp (border + tilt).
 */
interface NavItem {
	readonly label: string;
	readonly href: string;
}

interface Props {
	readonly items?: readonly NavItem[];
	readonly currentPath?: string;
	readonly class?: string;
}

const {
	items = [
		{ label: 'Home', href: '/' },
		{ label: 'Work', href: '/work' },
		{ label: 'Resume', href: '/resume' },
		{ label: 'Contact', href: '#contact' },
	],
	currentPath = Astro.url.pathname,
	class: className,
} = Astro.props;

const normalizePath = (path: string) => {
	if (path.length > 1 && path.endsWith('/')) {
		return path.slice(0, -1);
	}
	return path;
};

const activePath = normalizePath(currentPath);

/** Exact match, or prefix match for nested routes (e.g. /work/himalayan-book → Work). */
const isNavItemActive = (href: string) => {
	// In-page anchors (e.g. #contact) are not route highlights.
	if (href.includes('#')) return false;
	const itemPath = normalizePath(href);
	if (activePath === itemPath) {
		return true;
	}
	if (itemPath !== '/' && activePath.startsWith(`${itemPath}/`)) {
		return true;
	}
	return false;
};
---

<header
	class:list={[
		'site-nav fixed inset-x-0 top-0 z-[100] flex justify-center px-3 pt-[var(--spacing-page-top)] transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform pointer-events-none',
		className,
	]}
	data-site-nav
>
	<nav
		class="site-nav__tag pointer-events-auto relative flex max-w-full items-center px-8 py-2 shadow-[1px_2px_5px_rgb(0_0_0_/_0.15)] xl:px-10 2xl:px-12"
		aria-label="Primary"
	>
		<ul class="m-0 flex list-none flex-wrap items-center justify-center gap-x-6 gap-y-2 p-0 xl:gap-x-7 2xl:gap-x-8">
			{
				items.map((item) => {
					const isActive = isNavItemActive(item.href);
					return (
						<li>
							<a
								href={item.href}
								aria-current={isActive ? 'page' : undefined}
								class:list={[
									'site-nav__link type-nav whitespace-nowrap no-underline transition-[color,opacity,transform,border-color] duration-200 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
									isActive ? 'site-nav__link--active' : 'site-nav__link--idle',
								]}
							>
								{item.label}
							</a>
						</li>
					);
				})
			}
		</ul>
	</nav>
</header>

<style>
	.site-nav__tag {
		background: var(--color-canvas, #f7f1ec);
	}

	/* Pin holes */
	.site-nav__tag::before,
	.site-nav__tag::after {
		content: '';
		position: absolute;
		top: 50%;
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		background: #555555;
		box-shadow:
			1px 1px 2px rgb(0 0 0 / 0.3) inset,
			1px 1px 2px rgb(0 0 0 / 0.2);
		transform: translateY(-50%);
	}

	.site-nav__tag::before {
		left: 0.75rem;
	}

	.site-nav__tag::after {
		right: 0.75rem;
	}

	.site-nav__link {
		display: inline-block;
		padding: 0.125rem 0.4rem;
	}

	.site-nav__link--idle {
		color: #444444;
		opacity: 0.8;
		text-shadow: 1px 1px 0 rgb(255 255 255 / 0.5);
	}

	.site-nav__link--idle:hover {
		opacity: 1;
	}

	.site-nav__link--active {
		color: #b54a4a;
		border-radius: 3px;
		box-shadow: 0 0 0 2px #b54a4a;
		opacity: 0.9;
		transform: rotate(-3deg);
		text-shadow: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-nav {
			transition: none;
		}

		.site-nav__link--active {
			transform: none;
		}
	}

	.site-nav[data-nav-hidden='true'] {
		transform: translate3d(0, calc(-100% - var(--spacing-page-top)), 0);
	}
</style>

<script>
	(() => {
		const nav = document.querySelector<HTMLElement>('[data-site-nav]');
		if (!nav || nav.dataset.navInit === 'true') return;
		nav.dataset.navInit = 'true';

		const prefersReduced = window.matchMedia(
			'(prefers-reduced-motion: reduce)',
		).matches;
		if (prefersReduced) return;

		const DELTA = 8;
		let lastY = window.scrollY;
		let ticking = false;

		const update = () => {
			ticking = false;
			const y = window.scrollY;
			const delta = y - lastY;

			if (y <= 8) {
				nav.dataset.navHidden = 'false';
			} else if (delta > DELTA) {
				nav.dataset.navHidden = 'true';
			} else if (delta < -DELTA) {
				nav.dataset.navHidden = 'false';
			}

			lastY = y;
		};

		window.addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(update);
			},
			{ passive: true },
		);
	})();
</script>
