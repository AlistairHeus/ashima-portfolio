---
/**
 * Site navigation matching Figma "navbar work" (node 277:1076).
 * Fixed to the viewport; hides on scroll down, reveals on scroll up.
 */
interface NavItem {
	readonly label: string;
	readonly href: string;
}

interface Props {
	readonly brandHref?: string;
	readonly brandLabel?: string;
	readonly items?: readonly NavItem[];
	readonly currentPath?: string;
	readonly showDivider?: boolean;
	readonly class?: string;
}

const {
	brandHref = '/',
	brandLabel = 'Ashima Kaushik',
	items = [
		{ label: 'Home', href: '/' },
		{ label: 'Work', href: '/work' },
		{ label: 'Resume', href: '/resume' },
		{ label: 'Contact', href: '#contact' },
	],
	currentPath = Astro.url.pathname,
	showDivider = true,
	class: className,
} = Astro.props;

const normalizePath = (path: string) => {
	if (path.length > 1 && path.endsWith('/')) {
		return path.slice(0, -1);
	}
	return path;
};

const activePath = normalizePath(currentPath);

/** Exact match, or prefix match for nested routes (e.g. /work/himalayan-book → Work). */
const isNavItemActive = (href: string) => {
	// In-page anchors (e.g. #contact) are not route highlights.
	if (href.includes('#')) return false;
	const itemPath = normalizePath(href);
	if (activePath === itemPath) {
		return true;
	}
	if (itemPath !== '/' && activePath.startsWith(`${itemPath}/`)) {
		return true;
	}
	return false;
};
---

<header
	class:list={[
		'site-nav fixed inset-x-0 top-0 z-[100] w-full bg-transparent transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform',
		className,
	]}
	data-site-nav
>
	<div class="mx-auto max-w-fit bg-surface-warm">
		<div
			class:list={[
				'flex min-h-14 flex-col items-stretch justify-between gap-0 sm:min-h-[60px] sm:flex-row sm:items-stretch sm:gap-[clamp(1rem,3vw,2rem)]',
			]}
		>
			<!-- <a
				href={brandHref}
				class="inline-flex shrink-0 items-center self-stretch py-3 font-display text-[clamp(1.25rem,2.8vw+0.5rem,2.5rem)] font-light leading-tight tracking-[0.00625rem] whitespace-nowrap text-on-surface uppercase no-underline transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:py-2"
			>
				{brandLabel}
			</a> -->

			<nav class="mx-auto flex min-w-0 items-stretch self-stretch sm:w-auto" aria-label="Primary">
				<ul
					class="m-0 flex h-full list-none flex-wrap items-stretch justify-start gap-y-1 p-0 sm:justify-end"
				>
					{
						items.map((item) => {
							const isActive = isNavItemActive(item.href);
							return (
								<li class="flex items-stretch">
									<a
										href={item.href}
										aria-current={isActive ? 'page' : undefined}
										class:list={[
											/* Figma tab: 200 wide; height fills row so active bg meets the rule */
											'inline-flex h-full min-h-10 w-[6.5rem] items-center justify-center font-display text-[clamp(0.875rem,1.2vw+0.5rem,1.5rem)] font-light leading-tight tracking-[0.00625rem] whitespace-nowrap uppercase no-underline transition-[color,background-color,opacity] duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:min-h-[60px] sm:w-[200px]',
											isActive
												? 'bg-on-surface-state text-on-surface'
												: 'bg-transparent text-primary hover:opacity-75',
										]}
									>
										{item.label}
									</a>
								</li>
							);
						})
					}
				</ul>
			</nav>
		</div>
	</div>
</header>

<style>
	@media (prefers-reduced-motion: reduce) {
		.site-nav {
			transition: none;
		}
	}

	.site-nav[data-nav-hidden='true'] {
		transform: translate3d(0, -100%, 0);
	}
</style>

<script>
	(() => {
		const nav = document.querySelector<HTMLElement>('[data-site-nav]');
		if (!nav || nav.dataset.navInit === 'true') return;
		nav.dataset.navInit = 'true';

		const prefersReduced = window.matchMedia(
			'(prefers-reduced-motion: reduce)',
		).matches;
		if (prefersReduced) return;

		const DELTA = 8;
		let lastY = window.scrollY;
		let ticking = false;

		const update = () => {
			ticking = false;
			const y = window.scrollY;
			const delta = y - lastY;

			if (y <= 8) {
				nav.dataset.navHidden = 'false';
			} else if (delta > DELTA) {
				nav.dataset.navHidden = 'true';
			} else if (delta < -DELTA) {
				nav.dataset.navHidden = 'false';
			}

			lastY = y;
		};

		window.addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(update);
			},
			{ passive: true },
		);
	})();
</script>
