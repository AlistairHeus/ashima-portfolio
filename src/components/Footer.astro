---
/**
 * Site footer — full-bleed ruler + huge magnetic name + contact.
 * Left: ASHIMA / KAUSHIK · Right: email + socials (tight stack, bottom-aligned).
 */
import MagneticChars from './MagneticChars.astro';

interface SocialLink {
	readonly label: string;
	readonly href: string;
}

interface Props {
	readonly email?: string;
	readonly emailHref?: string;
	readonly socials?: readonly SocialLink[];
	readonly class?: string;
}

const {
	email = 'ashimakaushik.design@gmail.com',
	emailHref = 'mailto:ashimakaushik.design@gmail.com',
	socials = [
		{
			label: 'Behance',
			href: 'https://www.behance.net/ashimakaushik',
		},
		{
			label: 'LinkedIn',
			href: 'https://www.linkedin.com/in/ashimakaushik17',
		},
	],
	class: className,
} = Astro.props;

const nameLines = ['ASHIMA', 'KAUSHIK'] as const;

const linkClass =
	'site-footer__link text-ink no-underline transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
---

<footer
	id="contact"
	class:list={[
		'site-footer relative z-20 w-full overflow-x-hidden border-t-[1.5px] border-ink bg-[#e8e4db]',
		className,
	]}
>
	<div class="flex min-h-0 flex-col pb-14 md:pb-24">
		<div
			class="site-footer__scale relative h-[2.1875rem] w-full"
			aria-hidden="true"
		>
			<div class="site-footer__ticks absolute inset-x-0 top-0 h-full"></div>
		</div>

		<div
			class="mx-auto flex w-full max-w-[75rem] flex-col gap-8 pt-10 md:flex-row md:items-end md:justify-between md:gap-12 md:pt-14"
		>
			<h2
				class="site-footer__name m-0 cursor-default font-display text-[#242424]"
				data-magnetic-root
			>
				{
					nameLines.map((line) => (
						<span class="site-footer__name-line">
							<MagneticChars text={line} />
						</span>
					))
				}
			</h2>

			<div
				class="site-footer__contact flex flex-col gap-8 font-display text-[clamp(1.125rem,1.2vw+0.75rem,1.5rem)]  tracking-[0.08rem] uppercase md:items-end md:text-right"
			>
				<a
					href={emailHref}
					class:list={[linkClass, 'max-w-full break-all sm:break-normal']}
				>
					{email}
				</a>

				<div class="flex flex-wrap gap-x-10 gap-y-3 md:justify-end social-links">
					{
						socials.map((social) => (
							<a
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
								class={linkClass}
							>
								{social.label}
							</a>
						))
					}
				</div>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer__name {
		/* Match hero size; tight lh for stacked caps */
		font-size: clamp(3.5rem, 10vw, 8rem);
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.site-footer__name-line {
		display: block;
	}

	/*
	  All-caps leave empty em-box below the glyph. Pull the last line up so
	  items-end lines the contact stack up with KAUSHIK’s visual bottom.
	*/
	.site-footer__name-line:last-child {
		margin-bottom: -0.2em;
	}

	/* Major / mid / minor ruler ticks */
	.site-footer__ticks {
		background-image:
			repeating-linear-gradient(
				90deg,
				#111 0,
				#111 1.5px,
				transparent 1.5px,
				transparent 100px
			),
			repeating-linear-gradient(
				90deg,
				#555 0,
				#555 1px,
				transparent 1px,
				transparent 50px
			),
			repeating-linear-gradient(
				90deg,
				#999 0,
				#999 1px,
				transparent 1px,
				transparent 10px
			);
		background-size:
			100% 35px,
			100% 25px,
			100% 15px;
		background-repeat: no-repeat;
	}

	.site-footer__link:hover {
		color: #b54a4a;
	}

	.social-links a {
		line-height: 0.8;
	}
</style>

<script>
	import { initMagneticTypeAll } from '../scripts/magnetic-type';

	initMagneticTypeAll();
</script>
