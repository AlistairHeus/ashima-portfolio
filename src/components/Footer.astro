---
/**
 * Site footer matching Figma Group 1000016089 (node 226:1282).
 * Left: What's next? — Right: Contact + Socials as one group.
 */
interface SocialLink {
	readonly label: string;
	readonly href: string;
	readonly iconSrc: string;
	readonly iconAlt: string;
}

interface Props {
	readonly nextHeading?: string;
	readonly nextBody?: string;
	readonly contactHeading?: string;
	readonly email?: string;
	readonly emailHref?: string;
	readonly socialsHeading?: string;
	readonly socials?: readonly SocialLink[];
	readonly class?: string;
}

const {
	nextHeading = "What's next?",
	nextBody = 'Hopefully, something we build together.',
	contactHeading = 'Contact',
	email = 'ashimakaushik.design@gmail.com',
	emailHref = 'mailto:ashimakaushik.design@gmail.com',
	socialsHeading = 'Socials',
	socials = [
		{
			label: '/ashimakaushik17',
			href: 'https://www.linkedin.com/in/ashimakaushik17',
			iconSrc: '/icons/linkedin.png',
			iconAlt: 'LinkedIn',
		},
		{
			label: '/ashimakaushik',
			href: 'https://www.behance.net/ashimakaushik',
			iconSrc: '/icons/behance.png',
			iconAlt: 'Behance',
		},
	],
	class: className,
} = Astro.props;
---

<footer id="contact" class:list={['relative z-20 w-full bg-footer', className]}>
	<div
		class="mx-auto max-w-[75rem] px-[clamp(1rem,3vw,2rem)] pb-16 pt-[clamp(4rem,8vw,9.125rem)] md:pb-20"
	>
		{/*
		  Desktop: col1 grows (What's next), cols 2–3 hug content and sit as
		  a right-hand Contact + Socials group. Shared heading/body rows.
		*/}
		<div
			class="grid grid-cols-1 gap-y-3 md:grid-cols-[1fr_auto_auto] md:grid-rows-[auto_auto] md:gap-x-16 lg:gap-x-24 px-[clamp(1rem,3vw,2rem)]"
		>
				<p
					class="font-display text-[clamp(1.5rem,2vw+0.75rem,2.25rem)] font-bold uppercase leading-none  text-footer-ink md:col-start-1 md:row-start-1"
				>
					{nextHeading}
				</p>
				<p
					class="font-body text-xl font-normal leading-normal tracking-[0.1rem] text-muted md:col-start-1 md:row-start-2"
				>
					{nextBody}
				</p>

				<p
					class="mt-8 font-label text-2xl font-bold uppercase leading-none tracking-[0.27rem] text-footer-ink md:col-start-2 md:row-start-1 md:mt-0"
				>
					{contactHeading}
				</p>
				<a
					href={emailHref}
					class="font-body text-xl font-normal lowercase leading-[1.6875rem] text-muted no-underline transition-opacity hover:opacity-75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary md:col-start-2 md:row-start-2"
				>
					{email}
				</a>

				<p
					class="mt-8 font-label text-2xl font-bold uppercase leading-none tracking-[0.27rem] text-footer-ink md:col-start-3 md:row-start-1 md:mt-0"
				>
					{socialsHeading}
				</p>
				<ul
					class="flex list-none flex-col gap-[0.875rem] p-0 md:col-start-3 md:row-start-2"
				>
					{
						socials.map((social) => (
							<li>
								<a
									href={social.href}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-3 font-body text-xl font-normal lowercase leading-[1.6875rem] text-muted no-underline transition-opacity hover:opacity-75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
								>
									<img
										src={social.iconSrc}
										alt={social.iconAlt}
										width="26"
										height="26"
										class="size-[26px] shrink-0 object-cover"
									/>
									<span>{social.label}</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
	</div>
</footer>
