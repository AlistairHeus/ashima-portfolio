---
/**
 * Featured case studies — stacked Figma folder shapes with scalloped tabs.
 */
import Chip from '../ui/Chip.astro';
import Container from '../ui/Container.astro';
import KraftTape from '../ui/KraftTape.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { ASSETS } from '../../constants/assets';
import {
  CASE_STUDIES,
  DEFAULT_CASE_STUDY_ID,
} from '../../constants/case-studies';
import { PROJECT_THEMES } from '../../constants/theme';

const defaultStudy =
  CASE_STUDIES.find((study) => study.id === DEFAULT_CASE_STUDY_ID) ??
  CASE_STUDIES[0];
---

<section
  id="work"
  class="case-studies relative scroll-mt-24 overflow-x-clip pb-20 pt-8 md:pb-28 md:pt-12"
  aria-labelledby="featured-heading"
  data-case-studies
>
  <Container width="wide" class="relative z-10">
    <SectionHeading id="featured-heading" title="Featured case studies" />

    <div class="folder relative mt-10 isolate md:mt-14" data-folder>
      <!-- Stacked folder bodies from Figma (scalloped tab headers) -->
      <div
        class="pointer-events-none absolute inset-0"
        aria-hidden="true"
      >
        {
          CASE_STUDIES.map((study, index) => {
            const isActive = study.id === defaultStudy.id;
            return (
              <img
                src={ASSETS.folders[study.themeKey]}
                alt=""
                data-folder-shape={study.id}
                class="absolute inset-0 size-full"
                style={`z-index: ${isActive ? 10 : index + 1}`}
                decoding="async"
              />
            );
          })
        }
      </div>

      <!-- Tab hit targets sit on the scalloped headers -->
      <div
        class="relative grid grid-cols-[repeat(4,21.2%)] gap-x-[2.4%]"
        role="tablist"
        aria-label="Featured case studies"
      >
        {
          CASE_STUDIES.map((study, index) => {
            const theme = PROJECT_THEMES[study.themeKey];
            const isActive = study.id === defaultStudy.id;

            return (
              <button
                type="button"
                role="tab"
                id={`case-tab-${study.id}`}
                aria-controls={`case-panel-${study.id}`}
                aria-selected={isActive ? 'true' : 'false'}
                tabindex={isActive ? 0 : -1}
                data-case-tab={study.id}
                class="folder-tab relative flex h-[clamp(2rem,3vw,3.5rem)] items-center justify-center px-1 py-2 font-sans text-[0.65rem] font-bold uppercase leading-none tracking-[0.18em] transition-opacity sm:text-sm md:text-xl md:tracking-[0.18em]"
                style={`color: ${theme.label}`}
              >
                <span class="sm:hidden">{`P${index + 1}`}</span>
                <span class="hidden sm:inline">{study.tabLabel}</span>
              </button>
            );
          })
        }
      </div>

      <!-- Case study content sits in the folder body -->
      <div class="relative grid px-4 pb-8 pt-6 sm:px-8 sm:pb-10 sm:pt-8 md:px-14 md:pb-14 md:pt-10">
        {
          CASE_STUDIES.map((study) => {
            const theme = PROJECT_THEMES[study.themeKey];
            const isActive = study.id === defaultStudy.id;

            return (
              <article
                id={`case-panel-${study.id}`}
                role="tabpanel"
                aria-labelledby={`case-tab-${study.id}`}
                hidden={!isActive}
                data-case-panel={study.id}
                class="case-panel relative col-start-1 row-start-1 grid items-center gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-12 xl:gap-16"
              >
                <div
                  class="relative mx-auto w-full max-w-xl p-10 lg:mx-0"
                  data-case-media
                >
                  <div class="relative rotate-[-3deg]">
                    <div class="overflow-hidden rounded-xl bg-white p-2 shadow-[0_1px_6.6px_rgba(0,0,0,0.25)] sm:p-3">
                      <img
                        src={study.imageSrc}
                        alt={study.imageAlt}
                        class="aspect-square w-full object-cover"
                        loading={isActive ? 'eager' : 'lazy'}
                        decoding="async"
                        sizes="(max-width: 1024px) 90vw, 690px"
                      />
                    </div>
                    <KraftTape class="-right-10 -top-0 rotate-[-140deg] md:-right-10 md:-top-5" />
                    <KraftTape class="-bottom-4 -left-2 rotate-[40deg] md:-bottom-5 md:-left-10" />
                  </div>
                </div>

                <div class="flex flex-col" data-case-copy>
                  <h3
                    class="font-display text-[2rem] font-bold leading-tight md:text-[3.5rem] md:leading-[1.05]"
                    style={`color: ${theme.label}`}
                  >
                    {study.title}
                  </h3>
                  <p class="mt-5 max-w-md font-body text-base leading-relaxed text-dark md:text-lg md:leading-[1.4]">
                    {study.description}
                  </p>
                  <ul class="mt-8 flex flex-wrap gap-2 md:mt-10">
                    {study.tags.map((tag) => (
                      <li>
                        <Chip label={tag} />
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </Container>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  type PortfolioLenis = {
    readonly scroll: number;
    scrollTo: (
      target: number,
      options?: { immediate?: boolean; force?: boolean },
    ) => void;
  };

  const smoothWindow = window as typeof window & {
    __portfolioLenis?: PortfolioLenis;
  };

  const root = document.querySelector('[data-case-studies]');
  if (
    root instanceof HTMLElement &&
    root.dataset.scrollEnhanced !== 'true'
  ) {
    root.dataset.scrollEnhanced = 'true';

    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-case-tab]'),
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>('[data-case-panel]'),
    );
    const shapes = Array.from(
      root.querySelectorAll<HTMLElement>('[data-folder-shape]'),
    );

    const abortController = new AbortController();
    const { signal } = abortController;
    const matchMedia = gsap.matchMedia();
    let activeIndex = Math.max(
      0,
      tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true'),
    );
    let highestRevealedIndex = activeIndex;
    let queuedRevealIndex = activeIndex;
    const revealQueue: number[] = [];
    let revealDelay: gsap.core.Tween | undefined;
    let scrollTrigger: ScrollTrigger | undefined;
    let isEscapingPin = false;
    let isResumingPin = false;

    /**
     * Returns the vertical offset that places an element just below the viewport.
     */
    const getViewportRevealOffset = (element: HTMLElement) => {
      const previousTransform = element.style.transform;
      element.style.transform = 'none';
      const naturalTop = element.getBoundingClientRect().top;
      element.style.transform = previousTransform;

      return Math.max(0, window.innerHeight - naturalTop + 16);
    };

    /**
     * Performs an immediate jump while keeping Lenis's internal target synced.
     */
    const jumpToScrollPosition = (position: number) => {
      window.scrollTo({ top: position, behavior: 'auto' });

      if (smoothWindow.__portfolioLenis) {
        smoothWindow.__portfolioLenis.scrollTo(position, {
          immediate: true,
          force: true,
        });
      }
    };

    /**
     * Skips the pinned sequence immediately when scrolling back toward it.
     */
    const escapePinnedSection = (trigger: ScrollTrigger) => {
      if (isEscapingPin || isResumingPin) return;

      isEscapingPin = true;
      jumpToScrollPosition(Math.max(0, trigger.start - 2));
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          isEscapingPin = false;
        });
      });
    };

    /**
     * Promotes a project and optionally reveals a new folder permanently.
     */
    const activate = (
      nextIndex: number,
      animate = true,
      reveal = false,
    ) => {
      const boundedIndex = gsap.utils.clamp(0, tabs.length - 1, nextIndex);
      const previousIndex = activeIndex;
      const direction = boundedIndex >= previousIndex ? 1 : -1;
      const selectedId = tabs[boundedIndex]?.dataset.caseTab;
      const previousId = tabs[previousIndex]?.dataset.caseTab;
      const isNewReveal =
        reveal && boundedIndex > highestRevealedIndex;
      const isTransitioning = animate && boundedIndex !== previousIndex;

      if (!selectedId) return;

      if (reveal) {
        highestRevealedIndex = Math.max(
          highestRevealedIndex,
          boundedIndex,
        );
      }

      activeIndex = boundedIndex;
      gsap.killTweensOf([...tabs, ...shapes, ...panels]);

      tabs.forEach((tab, index) => {
        const selected = index === boundedIndex;
        const revealed = index <= highestRevealedIndex;

        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.setAttribute('aria-hidden', revealed ? 'false' : 'true');
        tab.tabIndex = selected ? 0 : -1;
        tab.style.pointerEvents = revealed ? 'auto' : 'none';
        tab.style.zIndex = selected ? '50' : '40';

        if (
          revealed &&
          selected &&
          isNewReveal &&
          animate &&
          boundedIndex !== previousIndex
        ) {
          gsap.fromTo(
            tab,
            {
              autoAlpha: 1,
              y: getViewportRevealOffset(tab),
              scale: 0.995,
            },
            {
              autoAlpha: 1,
              y: 0,
              scale: 1,
              duration: 0.7,
              ease: 'power3.out',
              overwrite: true,
            },
          );
        } else {
          gsap.set(tab, {
            autoAlpha: revealed ? 1 : 0,
            y: 0,
            scale: 1,
          });
        }
      });

      shapes.forEach((shape, index) => {
        const selected = shape.dataset.folderShape === selectedId;
        const revealed = index <= highestRevealedIndex;

        shape.style.zIndex = selected ? '30' : String(index + 1);

        if (!revealed) {
          gsap.set(shape, {
            autoAlpha: 0,
            xPercent: 0,
            yPercent: 105,
            y: 0,
            scale: 1,
          });
        } else if (selected) {
          if (animate && boundedIndex !== previousIndex) {
            gsap.fromTo(
              shape,
              {
                autoAlpha: 1,
                xPercent: 0,
                yPercent: 0,
                y: isNewReveal
                  ? getViewportRevealOffset(shape)
                  : direction * 18,
                scale: 0.995,
              },
              {
                autoAlpha: 1,
                xPercent: 0,
                yPercent: 0,
                y: 0,
                scale: 1,
                duration: 0.7,
                ease: 'power3.out',
                overwrite: true,
              },
            );
          } else {
            gsap.set(shape, {
              autoAlpha: 1,
              xPercent: 0,
              yPercent: 0,
              y: 0,
              scale: 1,
            });
          }
        } else {
          gsap.set(shape, {
            autoAlpha: 1,
            xPercent: 0,
            yPercent: 0,
            y: 0,
            scale: 1,
          });
        }
      });

      panels.forEach((panel) => {
        const selected = panel.dataset.casePanel === selectedId;
        const previous = panel.dataset.casePanel === previousId;
        panel.hidden = !selected && !(isTransitioning && previous);
        panel.style.zIndex = selected ? '40' : '20';

        if (selected) {
          if (isTransitioning) {
            gsap.fromTo(
              panel,
              {
                autoAlpha: 1,
                y: isNewReveal
                  ? getViewportRevealOffset(panel)
                  : direction * 18,
                scale: 0.995,
              },
              {
                autoAlpha: 1,
                y: 0,
                scale: 1,
                duration: 0.7,
                ease: 'power3.out',
                overwrite: true,
                onComplete: () => {
                  if (activeIndex !== boundedIndex) return;

                  panels.forEach((otherPanel) => {
                    otherPanel.hidden =
                      otherPanel.dataset.casePanel !== selectedId;
                  });
                },
              },
            );
          } else {
            gsap.set(panel, { autoAlpha: 1, y: 0, scale: 1 });
          }
        } else if (previous && isTransitioning) {
          gsap.set(panel, { autoAlpha: 1, y: 0, scale: 1 });
        }
      });
    };

    /**
     * Plays every newly crossed reveal in order, even after a fast scroll.
     */
    const processRevealQueue = () => {
      if (revealDelay || revealQueue.length === 0) return;

      const nextIndex = revealQueue.shift();
      if (nextIndex === undefined) return;

      activate(nextIndex, true, true);
      revealDelay = gsap.delayedCall(0.72, () => {
        revealDelay = undefined;
        processRevealQueue();
      });
    };

    /**
     * Adds missing folders to the one-time reveal queue.
     */
    const queueRevealsThrough = (targetIndex: number) => {
      const boundedTarget = gsap.utils.clamp(
        0,
        tabs.length - 1,
        targetIndex,
      );

      for (
        let index = queuedRevealIndex + 1;
        index <= boundedTarget;
        index += 1
      ) {
        revealQueue.push(index);
      }

      queuedRevealIndex = Math.max(queuedRevealIndex, boundedTarget);
      processRevealQueue();
    };

    /**
     * Activates a project from a direct user interaction.
     */
    const selectFromTab = (index: number) => {
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      activate(index, !reduceMotion, false);
    };

    tabs.forEach((tab, tabIndex) => {
      tab.addEventListener('click', () => {
        selectFromTab(tabIndex);
      }, { signal });

      tab.addEventListener('keydown', (event) => {
        const currentIndex = tabs.indexOf(tab);
        if (currentIndex < 0) return;

        const revealedCount = highestRevealedIndex + 1;
        let nextIndex = currentIndex;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          nextIndex = (currentIndex + 1) % revealedCount;
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          nextIndex =
            (currentIndex - 1 + revealedCount) % revealedCount;
        } else if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = revealedCount - 1;
        } else {
          return;
        }

        event.preventDefault();
        const next = tabs[nextIndex];
        next?.focus();
        selectFromTab(nextIndex);
      }, { signal });
    });

    activate(activeIndex, false, false);

    matchMedia.add(
      {
        supportsPinnedScroll: '(min-width: 768px)',
        reduceMotion: '(prefers-reduced-motion: reduce)',
      },
      (context) => {
        const { supportsPinnedScroll, reduceMotion } = context.conditions ?? {};

        if (!supportsPinnedScroll || reduceMotion || tabs.length < 2) {
          highestRevealedIndex = tabs.length - 1;
          queuedRevealIndex = tabs.length - 1;
          activate(activeIndex, false, false);
          return;
        }

        scrollTrigger = ScrollTrigger.create({
          trigger: root,
          start: 'top top',
          end: () =>
            `+=${Math.max(
              (tabs.length - 1) * window.innerHeight * 0.52,
              (tabs.length - 1) * 416,
            )}`,
          pin: true,
          pinSpacing: true,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onEnter: (self) => {
            if (
              isEscapingPin ||
              isResumingPin ||
              highestRevealedIndex === 0
            ) {
              return;
            }

            const resumeProgress =
              highestRevealedIndex / (tabs.length - 1);
            const resumePosition =
              self.start + (self.end - self.start) * resumeProgress;

            isResumingPin = true;
            jumpToScrollPosition(resumePosition);
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                isResumingPin = false;
              });
            });
          },
          onEnterBack: (self) => {
            escapePinnedSection(self);
          },
          onLeave: (self) => {
            const pinDistance = self.end - self.start;
            const currentScroll =
              smoothWindow.__portfolioLenis?.scroll ?? window.scrollY;

            scrollTrigger = undefined;
            self.kill(true, true);
            ScrollTrigger.refresh();
            jumpToScrollPosition(
              Math.max(0, currentScroll - pinDistance),
            );
          },
          onUpdate: (self) => {
            if (isEscapingPin || isResumingPin) return;

            if (self.direction < 0 && self.isActive && self.progress > 0) {
              escapePinnedSection(self);
              return;
            }

            const nextIndex = Math.round(
              self.progress * (tabs.length - 1),
            );

            if (nextIndex > queuedRevealIndex) {
              queueRevealsThrough(nextIndex);
            }
          },
        });

        const restoredIndex = Math.round(
          scrollTrigger.progress * (tabs.length - 1),
        );
        activate(restoredIndex, false, true);
        queuedRevealIndex = Math.max(
          queuedRevealIndex,
          restoredIndex,
        );

        return () => {
          scrollTrigger = undefined;
          isEscapingPin = false;
          isResumingPin = false;
        };
      },
    );

    document.fonts.ready.then(() => ScrollTrigger.refresh());

    const cleanup = () => {
      revealDelay?.kill();
      revealQueue.length = 0;
      abortController.abort();
      matchMedia.revert();
      root.dataset.scrollEnhanced = 'false';
    };

    document.addEventListener('astro:before-swap', cleanup, {
      once: true,
      signal,
    });
  }
</script>

<style>
  .folder-tab {
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .folder-tab:focus-visible {
    outline: 2px solid var(--color-muted);
    outline-offset: 2px;
  }

  [data-folder-shape],
  .case-panel {
    will-change: transform, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-folder-shape],
    .case-panel {
      will-change: auto;
    }
  }
</style>
