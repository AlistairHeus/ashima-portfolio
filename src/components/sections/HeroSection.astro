---
/**
 * Hero introduction: portrait, greeting, bio, and experience panel.
 */
import Container from "../ui/Container.astro";
import HeroExperience from "./HeroExperience.astro";
import { ASSETS } from "../../constants/assets";
import { PERSON } from "../../constants/person";

const roleStart = PERSON.bio.indexOf(PERSON.role);
const hasRoleHighlight = roleStart >= 0;
const bioBefore = hasRoleHighlight
  ? PERSON.bio.slice(0, roleStart)
  : PERSON.bio;
const bioAfter = hasRoleHighlight
  ? PERSON.bio.slice(roleStart + PERSON.role.length)
  : "";
---

<section
  class="relative flex justify-center w-full py-24"
  aria-labelledby="hero-heading"
>
  <Container class="flex mx-auto items-center">
    <div class="w-1/2 lg:pt-2 flex justify-end">
      <img
        src={PERSON.portraitSrc}
        alt={PERSON.portraitAlt}
        class="rotate-[-2deg]"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <div class="flex w-1/2 flex-col lg:pt-6">
      <div class="px-16">
        <p
          class="font-sans text-lg font-light uppercase tracking-[0.18em] text-ink md:text-2xl"
        >
          {PERSON.greeting}
        </p>

        <h1
          id="hero-heading"
          class="mt-3 font-display text-[2.35rem] font-normal leading-[0.95] tracking-[-0.04em] text-ink md:text-5xl"
        >
          {PERSON.headline}
        </h1>

        <p
          class="relative mt-6 max-w-md font-body text-lg leading-relaxed text-muted md:text-xl md:leading-[1.35]"
        >
          {
            hasRoleHighlight ? (
              <>
                {bioBefore}
                <span class="role-underline relative inline whitespace-nowrap">
                  {PERSON.role}
                  <img
                    src={ASSETS.underline}
                    alt=""
                    aria-hidden="true"
                    class="pointer-events-none absolute left-0 top-[1.1em] w-full max-w-none select-none object-fill object-left"
                    loading="eager"
                    decoding="async"
                  />
                </span>
                {bioAfter}
              </>
            ) : (
              PERSON.bio
            )
          }
        </p>
      </div>

      <div class="mt-10 w-full max-w-lg md:mt-12">
        <HeroExperience />
      </div>
    </div>
  </Container>
</section>
