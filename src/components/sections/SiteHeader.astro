---
/**
 * Site header with brand mark and primary navigation.
 */
import Container from '../ui/Container.astro';
import { NAV_ITEMS, SITE } from '../../constants';

const currentPath = Astro.url.pathname;
---

<header class="relative z-40 pt-8 md:pt-12">
  <Container
    as="div"
    class="flex flex-col gap-6 border-b border-muted/40 pb-5 sm:flex-row sm:items-end sm:justify-between"
  >
    <a
      href="/"
      class="font-display text-[1.65rem] font-light uppercase leading-none tracking-[0.04em] text-ink transition-opacity hover:opacity-70 md:text-[2.5rem]"
      aria-current={currentPath === '/' ? 'page' : undefined}
    >
      {SITE.brandName}
    </a>

    <nav aria-label="Primary" class="flex flex-wrap items-center gap-x-8 gap-y-2 sm:gap-x-12">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class="font-display text-base font-light uppercase tracking-[0.08em] text-muted transition-colors hover:text-ink md:text-2xl"
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </Container>
</header>
