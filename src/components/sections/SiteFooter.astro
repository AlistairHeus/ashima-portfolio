---
/**
 * Closing contact band with social destinations.
 */
import Container from '../ui/Container.astro';
import { FOOTER_COPY, SOCIAL_LINKS } from '../../constants/social';
---

<footer id="contact" class="scroll-mt-24 bg-footer-wash">
  <Container class="flex flex-col gap-8 border-b border-muted/40 py-14 md:flex-row md:items-end md:justify-between md:gap-12 md:py-16">
    <div>
      <p class="font-sans text-lg font-bold uppercase tracking-[0.18em] text-ink md:text-2xl">
        {FOOTER_COPY.eyebrow}
      </p>
      <p class="mt-2 font-body text-base tracking-[0.08em] text-muted md:text-lg">
        {FOOTER_COPY.message}
      </p>
    </div>

    <nav
      aria-label="Contact"
      class="flex flex-wrap gap-x-8 gap-y-3 border-t border-muted/40 pt-5 md:border-t-0 md:pt-0"
    >
      {
        SOCIAL_LINKS.map((link) => (
          <a
            href={link.href}
            class="font-display text-lg font-light uppercase tracking-[0.06em] text-muted transition-colors hover:text-ink md:text-2xl"
            target={link.id === 'email' ? undefined : '_blank'}
            rel={link.id === 'email' ? undefined : 'noopener noreferrer'}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </Container>
</footer>
