---
/**
 * Decorative kraft tape strip used on case-study imagery.
 */
type Props = {
  /** Extra positioning / transform classes. */
  class?: string;
};

import { ASSETS } from '../../constants/assets';

const { class: className } = Astro.props;
---

<img
  src={ASSETS.tape}
  alt=""
  aria-hidden="true"
  class:list={['pointer-events-none absolute z-10 w-28 select-none md:w-36', className]}
  loading="lazy"
  decoding="async"
/>
