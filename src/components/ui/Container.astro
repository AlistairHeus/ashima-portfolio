---
/**
 * Centers page content with a shared max width.
 * Horizontal padding stays modest so large screens are not double-guttered.
 */
type Props = {
  /** Extra class names on the container. */
  class?: string;
  /** HTML element to render. */
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
  /**
   * Horizontal padding scale.
   * - `page` (default): shared site gutter
   * - `tight`: reduced inset for header-like bands
   * - `none`: no horizontal padding
   */
  pad?: 'page' | 'tight' | 'none';
  /**
   * Maximum container width.
   * - `content` (default): standard page sections
   * - `wide`: visual sections that need more horizontal space
   */
  width?: 'content' | 'wide';
};

const {
  class: className,
  as: Tag = 'div',
  pad = 'page',
  width = 'content',
} = Astro.props;

const padClass =
  pad === 'none' ? '' : pad === 'tight' ? 'px-4 sm:px-6' : 'px-page';
const widthClass = width === 'wide' ? 'max-w-wide' : 'max-w-content';
---

<Tag class:list={['mx-auto w-full', widthClass, padClass, className]}>
  <slot />
</Tag>
