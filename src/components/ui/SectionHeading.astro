---
/**
 * Centered uppercase section title matching the Figma homepage rhythm.
 */
type Props = {
  /** Section heading text. */
  title: string;
  /** Optional id for in-page anchors. */
  id?: string;
};

const { title, id } = Astro.props;
---

<h2
  id={id}
  class="font-display text-center text-[1.75rem] uppercase leading-tight tracking-[0.02em] text-dark md:text-[2rem]"
>
  {title}
</h2>
