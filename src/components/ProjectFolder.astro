---
/**
 * Reusable project folder visual (Figma node 405:1224).
 *
 * Layers (back → front):
 * 1. Tabbed back — CSS gradient clipped to the folder SVG path
 * 2. Index number on the tab
 * 3. Front flap panel (rounded gradient rect — the pocket)
 * 4. Tilted project image
 * 5. Paperclip
 *
 * Accent: when `accentColor` is set (case-study hero band), a second gradient
 * layer crossfades in on hover / focus. Clip-path only shapes the paint;
 * color transitions stay on normal CSS backgrounds.
 *
 * Optional default slot for title / description / chips below.
 */
interface Props {
	readonly number: string;
	readonly imageSrc: string;
	readonly imageAlt: string;
	/** Accessible name when `href` is set (defaults to imageAlt). */
	readonly linkLabel?: string;
	readonly href?: string;
	readonly paperclipSrc?: string;
	/**
	 * Project accent (hero band hex). Enables hover recolor of folder chrome.
	 */
	readonly accentColor?: string;
	/** Show the tab index number. Defaults to true. */
	readonly showNumber?: boolean;
	readonly class?: string;
}

const {
	number,
	imageSrc,
	imageAlt,
	linkLabel,
	href,
	paperclipSrc = '/icons/paperclip.png',
	accentColor,
	showNumber = true,
	class: className,
} = Astro.props;

const Wrapper = href ? 'a' : 'div';
/** Unique clip id so multiple folders on one page do not collide. */
const clipId = `pf-clip-${crypto.randomUUID()}`;

const rootStyle = accentColor
	? `--pf-accent: ${accentColor}`
	: undefined;

/**
 * Folder silhouette normalized to objectBoundingBox (0–1).
 * Source path: folder-shape.svg content box 510 × 370.5 (shadow pad removed).
 */
const folderClipPath =
	'M0 0.05938V0.22084V0.94062C0 0.97341 0.01931 1 0.04314 1H0.95686C0.98069 1 1 0.97341 1 0.94062V0.12983C1 0.09704 0.98095 0.07045 0.95713 0.07045H0.39177C0.36822 0.07045 0.35134 0.05201 0.34046 0.034C0.3292 0.01536 0.31363 0 0.29602 0H0.04314C0.01931 0 0 0.02659 0 0.05938Z';
---

<div
	class:list={['group/folder relative w-full max-w-[510px]', className]}
	data-project-folder
	data-has-accent={accentColor ? 'true' : undefined}
	style={rootStyle}
>
	<Wrapper
		href={href}
		aria-label={href ? (linkLabel ?? imageAlt) : undefined}
		class:list={[
			'project-folder relative block w-full overflow-visible',
			href &&
				'no-underline outline-offset-4 focus-visible:outline-2 focus-visible:outline-primary',
		]}
	>
		{/* Frame: 510 × 370.5 */}
		<div class="relative w-full pt-[72.65%]">
			{/*
			  Hidden defs SVG — keep overflow hidden (not width/height 0) so
			  clip-path: url(#id) resolves in Safari.
			*/}
			<svg
				class="pointer-events-none absolute h-px w-px overflow-hidden opacity-0"
				aria-hidden="true"
				focusable="false"
			>
				<defs>
					{/*
					  objectBoundingBox so the clip scales with the responsive frame.
					  Absolute CSS path() coords would break at every breakpoint.
					*/}
					<clipPath id={clipId} clipPathUnits="objectBoundingBox">
						<path d={folderClipPath}></path>
					</clipPath>
				</defs>
			</svg>

			{/*
			  1. Tabbed back — drop-shadow on wrapper (clip-path hides own shadows).
			  Base beige + accent layer; opacity crossfade (gradients don’t transition).
			*/}
			<div
				class="project-folder__back-shadow pointer-events-none absolute inset-0 z-0"
				aria-hidden="true"
			>
				<div class="project-folder__back absolute inset-0" style={`clip-path: url(#${clipId})`}>
					<div class="project-folder__back-base absolute inset-0"></div>
					<div class="project-folder__back-accent absolute inset-0"></div>
				</div>
			</div>

			{/* 2. Index number — Figma 405:1227 · Lato Bold 70 · #FFEFE2 */}
			{
				showNumber && (
					<p
						class="project-folder__number absolute top-[1.9%] left-[7.45%] z-[1] w-[18.2%] font-label text-[clamp(2.5rem,8vw,4.375rem)] font-bold leading-none"
						aria-hidden="true"
					>
						{number}
					</p>
				)
			}

			{/*
			  3. Front flap — Figma 405:1228
			  top 69 / 370.5 ≈ 18.6%, height 302 / 370.5 ≈ 81.5%
			  No overflow:hidden — soft shadow must cast onto the back/tab.
			*/}
			<div
				class="project-folder__flap pointer-events-none absolute top-[18.6%] right-0 bottom-0 left-0 z-[2] rounded-[22px]"
				aria-hidden="true"
			>
				<div class="project-folder__flap-base absolute inset-0 rounded-[22px]"></div>
				<div class="project-folder__flap-accent absolute inset-0 rounded-[22px]"></div>
			</div>

			{/*
			  4 + 5. Image + paperclip — Figma 149:566
			*/}
			<div
				class="absolute top-[23.55%] left-[9.06%] z-[3] flex h-[71.65%] w-[81.9%] items-center justify-center"
			>
				<div
					class="project-folder__photo relative aspect-[402/238] w-[96.3%] -rotate-4 overflow-hidden rounded-xl shadow-[0px_1px_5.5px_0px_rgba(0,0,0,0.25)] transition-transform duration-300 ease-out group-hover/folder:rotate-0 group-hover/card:rotate-0 motion-reduce:transition-none"
				>
					<img
						src={imageSrc}
						alt={imageAlt}
						class="absolute inset-0 size-full object-cover"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>

			<img
				src={paperclipSrc}
				alt=""
				aria-hidden="true"
				class="pointer-events-none absolute top-[10.8%] left-[73.5%] z-[4] h-[22.1%] w-[4.9%] object-contain select-none"
			/>
		</div>
	</Wrapper>

	{
		Astro.slots.has('default') && (
			<div class="mt-6">
				<slot />
			</div>
		)
	}
</div>

<style is:global>
	/*
	  Drop shadow must live outside the clipped element — clip-path chops box-shadow.
	  Matches Figma filter: offset 1 / 4, blur ~6.8, 25% black.
	*/
	[data-project-folder] .project-folder__back-shadow {
		filter: drop-shadow(1px 4px 6.8px rgb(0 0 0 / 0.25));
	}

	/*
	  Back fill mirrors folder-shape.svg userSpaceOnUse gradient
	  (y −106 → 215 on a ~370px body). Negative start = tab/shoulder
	  already warmer than pure #F3EAE3, so the flap lip reads as a seam.
	*/
	[data-project-folder] .project-folder__back-base {
		background-image: linear-gradient(180.41deg, #f3eae3 -9%, #ddc3ae 57%);
	}

	[data-project-folder] .project-folder__back-accent {
		background-image: linear-gradient(
			180.41deg,
			color-mix(in srgb, var(--pf-accent, #f3eae3) 42%, white) -9%,
			color-mix(in srgb, var(--pf-accent, #ddc3ae) 78%, #7a5c45) 57%
		);
		opacity: 0;
		transition: opacity 0.35s ease;
	}

	/*
	  Flap — Figma 405:1228 gradient + soft lift onto the back
	  (composite in Figma reads as a separate sheet; fill alone is too close).
	*/
	[data-project-folder] .project-folder__flap {
		box-shadow:
			0 1px 2px rgb(93 64 51 / 0.1),
			0 4px 14px rgb(0 0 0 / 0.1);
	}

	[data-project-folder] .project-folder__flap-base {
		background-image: linear-gradient(180.41deg, #f3eae3 2.53%, #bfa693 196.18%);
	}

	[data-project-folder] .project-folder__flap-accent {
		background-image: linear-gradient(
			180.41deg,
			color-mix(in srgb, var(--pf-accent, #f3eae3) 50%, white) 2.53%,
			color-mix(in srgb, var(--pf-accent, #bfa693) 70%, #5c4033) 196.18%
		);
		opacity: 0;
		transition: opacity 0.35s ease;
	}

	[data-project-folder] .project-folder__number {
		color: #ffefe2;
		transition: color 0.35s ease;
	}

	/*
	  Show accent layer on hover / focus (folder or parent ProjectCard).
	*/
	[data-project-folder][data-has-accent='true']:is(:hover, :focus-within)
		.project-folder__back-accent,
	[data-project-folder][data-has-accent='true']:is(:hover, :focus-within)
		.project-folder__flap-accent,
	.group\/card:is(:hover, :focus-within) > [data-project-folder][data-has-accent='true']
		.project-folder__back-accent,
	.group\/card:is(:hover, :focus-within) > [data-project-folder][data-has-accent='true']
		.project-folder__flap-accent {
		opacity: 1;
	}

	[data-project-folder][data-has-accent='true']:is(:hover, :focus-within)
		.project-folder__number,
	.group\/card:is(:hover, :focus-within) > [data-project-folder][data-has-accent='true']
		.project-folder__number {
		color: color-mix(in srgb, var(--pf-accent) 22%, white);
	}

	@media (prefers-reduced-motion: reduce) {
		[data-project-folder] .project-folder__back-accent,
		[data-project-folder] .project-folder__flap-accent,
		[data-project-folder] .project-folder__number {
			transition: none;
		}
	}
</style>
