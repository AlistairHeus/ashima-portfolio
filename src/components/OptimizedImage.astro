---
/**
 * Site-wide optimized image — Astro `<Picture>` for rasters (AVIF/WebP + srcset).
 * Animated GIFs stay as plain `<img>` so frames are preserved.
 *
 * Width/height props are layout hints only. Output dimensions always keep the
 * source aspect ratio so Astro’s image service never crops to a mismatched box.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getAsset } from '../lib/images';

interface Props {
	readonly src: string | ImageMetadata;
	readonly alt: string;
	readonly class?: string;
	readonly widths?: number[];
	readonly sizes?: string;
	readonly loading?: 'lazy' | 'eager';
	readonly decoding?: 'async' | 'auto' | 'sync';
	readonly fetchpriority?: 'high' | 'low' | 'auto';
	readonly width?: number;
	readonly height?: number;
	/** Aria / decorative helpers passed through to the img. */
	readonly 'aria-hidden'?: boolean | 'true' | 'false';
}

const {
	src,
	alt,
	class: className,
	widths = [480, 800, 1200, 1600],
	sizes = '100vw',
	loading = 'lazy',
	decoding = 'async',
	fetchpriority,
	width,
	'aria-hidden': ariaHidden,
} = Astro.props;

const meta: ImageMetadata = typeof src === 'string' ? getAsset(src) : src;
const isGif = meta.format === 'gif';

/** Cap at intrinsic width — never request an upscaled / wrong-aspect transform. */
const outWidth = Math.min(width ?? meta.width, meta.width);
const outHeight = Math.round((outWidth / meta.width) * meta.height);
const safeWidths = [
	...new Set(
		widths
			.map((w) => Math.min(Math.round(w), meta.width))
			.filter((w) => w > 0),
	),
].sort((a, b) => a - b);
---

{
	isGif ? (
		<img
			src={meta.src}
			alt={alt}
			width={outWidth}
			height={outHeight}
			class={className}
			loading={loading}
			decoding={decoding}
			fetchpriority={fetchpriority}
			aria-hidden={ariaHidden}
		/>
	) : (
		<Picture
			src={meta}
			alt={alt}
			formats={['avif', 'webp']}
			widths={safeWidths}
			sizes={sizes}
			width={outWidth}
			height={outHeight}
			class={className}
			loading={loading}
			decoding={decoding}
			fetchpriority={fetchpriority}
			aria-hidden={ariaHidden}
		/>
	)
}
