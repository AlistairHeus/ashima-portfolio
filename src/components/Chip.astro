---
/**
 * Bordered suggestion chip (Figma Suggestion chip).
 */
interface Props {
	readonly label: string;
	readonly muted?: boolean;
	readonly class?: string;
}

const { label, muted = false, class: className } = Astro.props;
---

<span
	class:list={[
		'type-chip inline-flex items-center justify-center rounded-md border px-2.5 py-1 text-on-surface-variant 2xl:rounded-lg 2xl:px-4 2xl:py-1.5',
		muted ? 'border-outline/80 opacity-50' : 'border-[#484848]',
		className,
	]}
>
	{label}
</span>
