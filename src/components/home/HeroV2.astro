---
/**
 * Experimental home hero — home name intro + rotating polaroid fan.
 * Fan images already include the Polaroid matte and caption.
 */
import OptimizedImage from '../OptimizedImage.astro';
import { getAsset } from '../../lib/images';

const gridSrc = getAsset('/images/home/grid.webp').src;

interface FanPolaroid {
	readonly src: string;
	readonly alt: string;
}

const heroFanPolaroids: readonly FanPolaroid[] = [
	{
		src: '/images/home-polaroids/air-india.png',
		alt: 'Reimagining the Boarding Pass',
	},
	{
		src: '/images/home-polaroids/akshar-chitra.png',
		alt: 'Hindi Typography',
	},
	{
		src: '/images/home-polaroids/convergence.png',
		alt: 'Convergence book cover',
	},
	{
		src: '/images/home-polaroids/igl-2.png',
		alt: 'IGL social media posts',
	},
	{
		src: '/images/home-polaroids/igl.png',
		alt: 'IGL brand identity system',
	},
	{
		src: '/images/home-polaroids/illustrations.png',
		alt: 'Illustrations',
	},
	{
		src: '/images/home-polaroids/mythila.png',
		alt: 'Devanagari display typeface',
	},
	{
		src: '/images/home-polaroids/tghe.png',
		alt: 'Editorial and publication',
	},
	{
		src: '/images/home-polaroids/vivan.png',
		alt: 'Vivan brand identity extension',
	},
];

const fanItems = [...heroFanPolaroids, ...heroFanPolaroids];
---

<section
	class="hero-v2 relative z-2 flex min-h-svh flex-col overflow-x-clip"
	aria-labelledby="hero-heading"
	data-hero
>
	<div
		class="relative z-[1] flex flex-1 flex-col pt-[calc(var(--spacing-page-chrome)+1.25rem)]"
	>
		<div class="page-shell flex flex-col items-center">
			<div
				class="hero-title-group relative z-10 flex w-full flex-col items-center justify-center"
			>
				<h1
					id="hero-heading"
					class="hero-name cursor-default whitespace-nowrap text-center font-display uppercase text-[#242424]"
				>
					Ashima Kaushik
				</h1>
				<p
					class="hero-subtitle type-body-xl mt-5 max-w-prose text-pretty text-center text-[#242424] md:mt-6"
				>
					A visual communication designer creating thoughtful visual
					systems through{' '}
					<strong class="font-bold">research</strong>,{' '}
					<strong class="font-bold">strategy</strong>,{' '}
					<strong class="font-bold">typography</strong>
					{' '}and{' '}
					<strong class="font-bold">storytelling</strong>.
				</p>
			</div>
		</div>

		<div class="hero-v2-fan-slot" data-hero-fan-slot aria-hidden="true"></div>
		<div
			class="hero-v2-fan w-full"
			data-hero-fan
			data-hero-fan-unique={heroFanPolaroids.length}
			style={`--count: ${fanItems.length}`}
			aria-hidden="true"
		>
			{
				fanItems.map((card, index) => (
					<div
						class="hero-v2-card"
						data-hero-fan-card
						style={`--index: ${index}`}
					>
						<OptimizedImage
							src={card.src}
							alt=""
							class="hero-v2-card__img block h-auto w-full"
							loading={
								index === 0 ||
								index === 1 ||
								index === fanItems.length - 1
									? 'eager'
									: 'lazy'
							}
							sizes="(max-width: 1023px) 220px, 400px"
							widths={[240, 400]}
						/>
					</div>
				))
			}
		</div>
	</div>
</section>

<script is:inline>
	(() => {
		const hero = document.querySelector('[data-hero]');
		if (!hero) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			hero.setAttribute('data-hero-intro', 'done');
			return;
		}
		hero.setAttribute('data-hero-intro', 'pending');
	})();
</script>

<script>
	import { initHeroIntro } from '../../scripts/hero-intro';
	import { initHeroFan } from '../../scripts/hero-fan';
	import {
		buildWordRanges,
		initMagneticType,
	} from '../../scripts/magnetic-type';

	const nameText = 'ASHIMA KAUSHIK';

	const enhanceHeroName = (root: HTMLElement): void => {
		if (root.dataset.heroNameEnhanced === 'true') return;

		const lineElement = document.createElement('span');
		lineElement.className =
			'hero-name-line whitespace-nowrap font-display text-[#242424]';

		for (const character of Array.from(nameText)) {
			if (character === ' ') {
				const space = document.createElement('span');
				space.className = 'hero-name-char magnetic-type__char';
				space.dataset.magneticChar = '';
				space.textContent = '\u00a0';
				lineElement.append(space);
				continue;
			}

			const inWord = lineElement.lastElementChild?.classList.contains(
				'magnetic-type__word',
			);
			const existingWord = lineElement.lastElementChild;
			const wordElement =
				inWord && existingWord instanceof HTMLElement
					? existingWord
					: document.createElement('span');

			if (wordElement.parentElement !== lineElement) {
				wordElement.className = 'magnetic-type__word';
				wordElement.dataset.magneticWord = '';
				lineElement.append(wordElement);
			}

			const characterElement = document.createElement('span');
			characterElement.className = 'hero-name-char magnetic-type__char';
			characterElement.dataset.magneticChar = '';
			characterElement.textContent = character;
			wordElement.append(characterElement);
		}

		root.replaceChildren(lineElement);
		root.dataset.heroNameEnhanced = 'true';
	};

	const startMagnetic = () => {
		const root = document.getElementById('hero-heading');
		if (!(root instanceof HTMLElement)) return;
		if (root.dataset.magneticInit === 'true') return;
		root.dataset.magneticInit = 'true';
		const magnetic = initMagneticType({
			root,
			wordRanges: buildWordRanges(nameText),
		});
		magnetic.playAutoplay({ delay: 0, duration: 1200 });
	};

	const boot = () => {
		const nameRoot = document.getElementById('hero-heading');
		if (nameRoot instanceof HTMLElement) {
			enhanceHeroName(nameRoot);
		}

		initHeroFan();
		initHeroIntro(() => {
			startMagnetic();
		});
	};

	void Promise.all([document.fonts?.ready ?? Promise.resolve()]).then(boot);
</script>

<style>
	.hero-name,
	:global(.hero-name-line) {
		font-size: 3.5rem;
		line-height: 1;
		letter-spacing: 0;
	}

	@media (width >= 80rem) {
		.hero-name,
		:global(.hero-name-line) {
			font-size: 6rem;
		}
	}

	@media (width >= 96rem) {
		.hero-name,
		:global(.hero-name-line) {
			font-size: 7.5rem;
		}
	}

	:global(.hero-name-char) {
		display: inline-block;
	}

	.hero-v2-fan,
	.hero-v2-fan-slot {
		--size-unit: 16;
		--size-container-ideal: 1440;
		font-size: clamp(
			calc(992px * var(--size-unit) / var(--size-container-ideal)),
			calc(100vw * var(--size-unit) / var(--size-container-ideal)),
			calc(1920px * var(--size-unit) / var(--size-container-ideal))
		);
	}

	.hero-v2-fan-slot {
		display: none;
		flex-shrink: 0;
		width: 100%;
		height: 20em;
		margin-top: auto;
		transform: translateY(-10%);
		pointer-events: none;
	}

	.hero-v2-fan-slot.is-active {
		display: block;
	}

	.hero-v2-fan {
		position: relative;
		height: 20em;
		margin-top: auto;
		overflow: visible;
		transform: translateY(-10%);
	}

	.hero-v2-fan.is-overlay {
		position: fixed;
		inset: 0;
		z-index: 1;
		width: 100%;
		height: 100%;
		margin: 0;
		transform: none;
		overflow: hidden;
		pointer-events: none;
	}

	.hero-v2-card {
		position: absolute;
		top: 0;
		left: 0;
		width: 18.125em;
		transform-origin: 50% 100%;
		contain: layout style;
		opacity: 0;
		pointer-events: none;
	}

	.hero-v2-card :global(picture),
	.hero-v2-card :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.hero-v2-fan.is-spinning .hero-v2-card {
		will-change: transform;
	}
</style>
