---
/**
 * Home hero — fixed cream grid + name lockup + project polaroids.
 * Scroll (200svh spacer): folder swallow first, then Featured slides over.
 * Folder matches ProjectFolder (back → cards → front flap).
 */
import Polaroid from '../Polaroid.astro';

const nameLine1 = 'ASHIMA';
const nameLine2 = 'KAUSHIK';

/** Left / right subtitles — single-line, Lato Bold, all caps. */
const roleLabel = 'VISUAL DESIGNER';
const locationLabel = 'BASED IN INDIA';

const gridSrc = '/images/home/grid.webp';
const folderSrc = '/images/folder-shape.svg';

const nameLines = [nameLine1, nameLine2] as const;
const splitChars = (text: string) => text.split('');

/** Flat char index ranges per word/line — used to smooth horizontal push. */
const wordRanges = nameLines.map((line, lineIndex) => {
	const startIdx = nameLines.slice(0, lineIndex).reduce((sum, l) => sum + l.length, 0);
	return { startIdx, endIdx: startIdx + line.length - 1 };
});

interface HeroPolaroid {
	readonly src: string;
	readonly alt: string;
	readonly top: string;
	readonly left: string;
	readonly width: string;
	readonly aspectRatio: string;
	readonly rotate: number;
	/** Show on small screens (only a few so the name stays readable). */
	readonly mobileShow?: boolean;
}

/** Oval scatter around the name — mixed sizes/tilts from work thumbs. */
const heroPolaroids: readonly HeroPolaroid[] = [
	{
		src: '/images/work/02-igl.png',
		alt: 'IGL rebrand',
		top: '6%',
		left: '6%',
		width: 'clamp(6.5rem, 13vw, 10rem)',
		aspectRatio: '3 / 4',
		rotate: -9,
		mobileShow: true,
	},
	{
		src: '/images/case-studies/mythila/animation.gif',
		alt: 'Mythila typeface',
		top: '4%',
		left: '78%',
		width: 'clamp(7rem, 15vw, 11.5rem)',
		aspectRatio: '1 / 1',
		rotate: 7,
		mobileShow: true,
	},
	{
		
		src: '/images/case-studies/igl/final-after.png',
		alt: 'IGL logo',
		top: '22%',
		left: '2%',
		width: 'clamp(5.5rem, 11vw, 8.5rem)',
		aspectRatio: '5 / 6',
		rotate: 11,
	},
	{
		src: '/images/work/04-akshar-chitra.png',
		alt: 'Akshar Chitra',

		top: '18%',
		left: '86%',
		width: 'clamp(6rem, 12vw, 9.5rem)',
		aspectRatio: '5 / 4',
		rotate: -6,
	},
	{
		
		src: '/images/work/maharaja-bg.png',
		alt: 'Air India brand',
		top: '64%',
		left: '4%',
		width: 'clamp(7.5rem, 16vw, 12rem)',
		aspectRatio: '5 / 4',
		rotate: -12,
		mobileShow: true,
	},
	{
		src: '/images/case-studies/himalayan/gallery-storyteller.png',
		alt: 'Himalayan book',
		top: '52%',
		left: '82%',
		width: 'clamp(5.5rem, 12vw, 9rem)',
		aspectRatio: '1 / 1',
		rotate: 8,
	},
	{
		src: '/images/case-studies/vivan/brochure.png',
		alt: 'Vivan Hospital',
		top: '78%',
		left: '12%',
		width: 'clamp(6rem, 13vw, 10rem)',
		aspectRatio: '5 / 4',
		rotate: 5,
	},
	{
		src: '/images/case-studies/convergence/convergence_cover.gif',
		alt: 'Convergence',
		top: '70%',
		left: '72%',
		width: 'clamp(6.5rem, 14vw, 10.5rem)',
		aspectRatio: '3 / 4',
		rotate: -8,
		mobileShow: true,
	},
];

/**
 * Absolute cards that live in the pocket (back → stuff → flap).
 * They pop up from under the flap mid-swallow so the folder looks stuffed.
 */
interface FolderStuffCard {
	readonly src: string;
	readonly alt: string;
	readonly left: string;
	readonly top: string;
	readonly width: string;
	readonly aspectRatio: string;
	readonly rotate: number;
	readonly z: number;
}

const folderStuff: readonly FolderStuffCard[] = [
	{
		src: '/images/work/01-air-india.png',
		alt: '',
		left: '4%',
		top: '0%',
		width: '46%',
		aspectRatio: '5 / 4',
		rotate: -16,
		z: 1,
	},
	{
		src: '/images/work/02-igl.png',
		alt: '',
		left: '22%',
		top: '-2%',
		width: '42%',
		aspectRatio: '3 / 4',
		rotate: 9,
		z: 3,
	},
	{
		src: '/images/case-studies/mythila/animation.gif',
		alt: '',
		left: '48%',
		top: '1%',
		width: '44%',
		aspectRatio: '1 / 1',
		rotate: -7,
		z: 2,
	},
	{
		src: '/images/work/04-akshar-chitra.png',
		alt: '',
		left: '30%',
		top: '3%',
		width: '40%',
		aspectRatio: '5 / 6',
		rotate: 14,
		z: 4,
	},
	{
		src: '/images/work/09-vivan.png',
		alt: '',
		left: '58%',
		top: '-1%',
		width: '38%',
		aspectRatio: '4 / 5',
		rotate: -11,
		z: 1,
	},
];
---

<section
	class="hero fixed inset-0 z-0 flex h-svh w-full flex-col overflow-hidden bg-canvas"
	aria-labelledby="hero-heading"
	data-hero
>
	<div
		class="pointer-events-none absolute inset-0 z-0"
		style={`background-image: url('${gridSrc}'); background-size: 80%; background-position: center center; background-repeat: repeat; mask-image: linear-gradient(black 0%, black 85%, transparent 85%); -webkit-mask-image: linear-gradient(black 0%, black 85%, transparent 85%);`}
	>
	</div>

	{/*
	  Single folder stage (ProjectFolder layers):
	  back → mid (polaroids, fixed to viewport) → front flap.
	  No transform on this wrapper so position:fixed scatter stays correct.
	*/}
	<div
		class="pointer-events-none absolute bottom-[5%] left-0 right-0 z-[4] mx-auto w-[min(52vw,22rem)]"
		data-hero-folder
		aria-hidden="true"
	>
		<div class="relative w-full pt-[72.65%]">
			{/* 1. Tabbed back */}
			<div
				class="absolute inset-[-0.76%_-1.53%_-2.91%_-1.14%] z-0"
				data-hero-folder-back
			>
				<img
					src={folderSrc}
					alt=""
					class="size-full object-fill select-none"
					draggable="false"
					loading="eager"
					decoding="async"
				/>
			</div>

			{/* 2. Mid pocket — scatter + stuffed cards sit under the flap */}
			<div
				class="absolute inset-0 z-[1] overflow-visible"
				data-hero-folder-mid
			>
				<div
					class="absolute top-[40%] left-1/2 size-0 -translate-x-1/2"
					data-hero-folder-pocket
				></div>
				{
					folderStuff.map((card) => (
						<div
							class="hero-stuff absolute origin-bottom"
							data-hero-stuff
							data-rotate={card.rotate}
							style={`left: ${card.left}; top: ${card.top}; width: ${card.width}; z-index: ${card.z};`}
						>
							<Polaroid
								imageSrc={card.src}
								imageAlt={card.alt}
								variant="classic"
								rotate={0}
								aspectRatio={card.aspectRatio}
								class="!max-w-none w-full"
							/>
						</div>
					))
				}
				{
					heroPolaroids.map((card) => (
						<div
							class:list={[
								'hero-polaroid',
								card.mobileShow ? 'block' : 'hidden md:block',
							]}
							data-hero-polaroid
							data-rotate={card.rotate}
							data-mobile-show={card.mobileShow ? 'true' : undefined}
							style={`position: fixed; top: ${card.top}; left: ${card.left}; width: ${card.width}; transform: rotate(${card.rotate}deg);`}
						>
							<Polaroid
								imageSrc={card.src}
								imageAlt={card.alt}
								variant="classic"
								rotate={0}
								aspectRatio={card.aspectRatio}
								class="!max-w-none w-full"
							/>
						</div>
					))
				}
			</div>

			{/* 3. Front flap — cards slide under this */}
			<div
				class="hero-folder-flap absolute top-[18.6%] right-0 bottom-0 left-0 z-[2] rounded-[22px]"
				data-hero-folder-flap
			></div>
		</div>
	</div>

	<div
		class="hero-title-group relative z-10 flex w-full items-center justify-center"
		style="margin-top: auto; margin-bottom: 40vh;"
	>
		{/* Desktop: role label */}
		<div
			class="hero-lines absolute hidden items-center md:flex"
			style="left: 5%; right: 50%; margin-right: min(25vw, 400px);"
		>
			<span
				class="hero-subtitle-text ml-auto whitespace-nowrap font-label text-[clamp(0.875rem,1.1vw,1.125rem)] font-bold uppercase leading-none tracking-[0.06em] text-[#242424]"
			>
				{roleLabel}
			</span>
		</div>

		{/* Mobile role */}
		<p
			class="hero-mobile-subtitle mb-3 whitespace-nowrap text-center font-label text-sm font-bold uppercase leading-none tracking-[0.06em] text-[#242424] md:hidden"
		>
			{roleLabel}
		</p>

		<h1 id="hero-heading" class="hero-name cursor-default whitespace-nowrap text-center">
			{
				nameLines.map((line) => (
					<span class="hero-name-line block font-display text-[#242424]">
						{splitChars(line).map((ch) => (
							<span class="hero-name-char" data-hero-char>
								{ch}
							</span>
						))}
					</span>
				))
			}
		</h1>

		{/* Mobile location */}
		<p
			class="hero-mobile-subtitle mt-3 whitespace-nowrap text-center font-label text-sm font-bold uppercase leading-none tracking-[0.06em] text-[#242424] md:hidden"
		>
			{locationLabel}
		</p>

		{/* Desktop: location label */}
		<div
			class="hero-lines absolute hidden items-center md:flex"
			style="right: 5%; left: 50%; margin-left: min(25vw, 400px);"
		>
			<span
				class="hero-subtitle-text whitespace-nowrap font-label text-[clamp(0.875rem,1.1vw,1.125rem)] font-bold uppercase leading-none tracking-[0.06em] text-[#242424]"
			>
				{locationLabel}
			</span>
		</div>
	</div>

</section>

{/*
  Two-stage scroll stand-in:
  1) first viewport — folder swallow plays (Featured still below)
  2) second viewport — Featured slides over the fixed hero
*/}
<div
	class="pointer-events-none relative -mt-[var(--spacing-page-chrome)] h-[200svh] w-full"
	data-hero-spacer
	aria-hidden="true"
></div>

<style>
	.hero-name-line {
		font-size: clamp(3.5rem, 10vw, 8rem);
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.hero-name-char {
		display: inline-block;
		font-weight: 100;
		font-variation-settings: 'wght' 100;
		text-align: center;
		will-change: transform, font-variation-settings;
	}

	.hero-polaroid {
		will-change: transform, opacity;
	}

	.hero-stuff {
		will-change: transform, opacity;
		opacity: 0;
		pointer-events: none;
	}

	.hero-folder-flap {
		background-image: linear-gradient(
			180.41deg,
			rgb(190, 215, 237) 17.9%,
			rgb(145, 165, 198) 164.13%
		);
	}

	[data-hero-folder-back],
	[data-hero-folder-flap] {
		will-change: opacity;
		opacity: 0;
	}
</style>

<script>
	import { initHeroPolaroids } from '../../scripts/hero-polaroids';
	initHeroPolaroids();
</script>

<script
	define:vars={{
		wordRanges,
		weightMin: 100,
		weightMax: 700,
		minDesktopWidth: 1000,
	}}
>
	(() => {
		/**
		 * Magnetic name interaction (desktop).
		 * Soft exponential easing + mouse damping; char widths locked at bold
		 * so variable weight doesn't reflow and jitter the line.
		 */
		const root = document.getElementById('hero-heading');
		if (!(root instanceof HTMLElement)) return;

		const prefersReduced = window.matchMedia(
			'(prefers-reduced-motion: reduce)',
		).matches;
		if (prefersReduced) return;

		const chars = Array.from(root.querySelectorAll('[data-hero-char]'));
		const count = chars.length;
		if (count === 0) return;

		/** Softer than the reference's 0.3 — keeps motion creamy. */
		const LERP_ACTIVE = 0.07;
		const LERP_SETTLE = 0.045;
		const MOUSE_LERP = 0.1;
		const EPSILON = 0.02;

		const targetProx = new Float32Array(count);
		const targetPush = new Float32Array(count);
		const currentProx = new Float32Array(count);
		const currentPush = new Float32Array(count);

		let rects = null;
		let rafId = 0;
		let pointerInside = false;
		let rawX = 0;
		let rawY = 0;
		let smoothX = 0;
		let smoothY = 0;
		let mouseInitialized = false;

		/** Freeze each glyph's advance at bold width to stop reflow jitter. */
		const lockCharWidths = () => {
			for (const el of chars) {
				el.style.fontWeight = String(weightMax);
				el.style.fontVariationSettings = `'wght' ${weightMax}`;
			}
			void root.offsetWidth;
			for (const el of chars) {
				el.style.width = `${el.getBoundingClientRect().width}px`;
			}
			for (const el of chars) {
				el.style.fontWeight = String(weightMin);
				el.style.fontVariationSettings = `'wght' ${weightMin}`;
			}
		};

		const captureRects = () => {
			rects = chars.map((el) => {
				const r = el.getBoundingClientRect();
				return {
					left: r.left,
					top: r.top,
					width: r.width,
					height: r.height,
					cx: r.left + r.width / 2,
					cy: r.top + r.height / 2,
				};
			});
		};

		const ensureRects = () => {
			if (!rects) captureRects();
			return rects;
		};

		const smoothPush = (values) => {
			const out = [...values];
			const n = out.length;
			if (n === 0) return out;
			for (let i = 1; i < n; i++) {
				if (out[i - 1] > 0 && out[i] < out[i - 1]) out[i] = out[i - 1];
			}
			for (let i = n - 2; i >= 0; i--) {
				if (out[i + 1] < 0 && out[i] > out[i + 1]) out[i] = out[i + 1];
			}
			return out;
		};

		const computeTargets = (clientX, clientY) => {
			targetProx.fill(0);
			targetPush.fill(0);
			const bounds = ensureRects();

			for (const range of wordRanges) {
				const pushes = [];
				const proxes = [];
				const len = range.endIdx - range.startIdx + 1;

				for (let i = range.startIdx; i <= range.endIdx; i++) {
					const rect = bounds[i];
					if (!rect) {
						pushes.push(0);
						proxes.push(0);
						continue;
					}
					const dx = rect.cx - clientX;
					const dy = rect.cy - clientY;
					const dist = Math.sqrt(dx * dx + dy * dy);
					const radius = 3 * rect.width;

					if (dist < radius && dist > 0) {
						const proximity = Math.max(0, 1 - dist / radius);
						const force = proximity * proximity * 3;
						pushes.push((dx / dist) * force);
						proxes.push(proximity);
					} else {
						pushes.push(0);
						proxes.push(0);
					}
				}

				const smoothed = smoothPush(pushes);
				for (let e = 0; e < len; e++) {
					const idx = range.startIdx + e;
					targetProx[idx] = proxes[e];
					targetPush[idx] = smoothed[e];
				}
			}
		};

		const applyStyles = () => {
			for (let i = 0; i < count; i++) {
				const el = chars[i];
				const prox = currentProx[i];
				const push = currentPush[i];
				const weight = weightMin + (weightMax - weightMin) * prox;
				el.style.transform = `translate3d(${push.toFixed(2)}px, 0, 0)`;
				el.style.fontWeight = String(weight);
				el.style.fontVariationSettings = `'wght' ${weight.toFixed(1)}`;
			}
		};

		const stillMoving = () => {
			if (pointerInside) return true;
			for (let i = 0; i < count; i++) {
				if (
					Math.abs(currentProx[i]) > EPSILON ||
					Math.abs(currentPush[i]) > EPSILON ||
					Math.abs(targetProx[i] - currentProx[i]) > EPSILON ||
					Math.abs(targetPush[i] - currentPush[i]) > EPSILON
				) {
					return true;
				}
			}
			return false;
		};

		const tick = () => {
			if (pointerInside) {
				if (!mouseInitialized) {
					smoothX = rawX;
					smoothY = rawY;
					mouseInitialized = true;
				} else {
					smoothX += (rawX - smoothX) * MOUSE_LERP;
					smoothY += (rawY - smoothY) * MOUSE_LERP;
				}
				computeTargets(smoothX, smoothY);
			} else {
				targetProx.fill(0);
				targetPush.fill(0);
			}

			const settling = !pointerInside;
			const lerp = settling ? LERP_SETTLE : LERP_ACTIVE;

			for (let i = 0; i < count; i++) {
				currentProx[i] += (targetProx[i] - currentProx[i]) * lerp;
				currentPush[i] += (targetPush[i] - currentPush[i]) * lerp;
			}

			applyStyles();

			if (stillMoving()) {
				rafId = requestAnimationFrame(tick);
			} else {
				rafId = 0;
				currentProx.fill(0);
				currentPush.fill(0);
				applyStyles();
			}
		};

		const startLoop = () => {
			if (rafId || prefersReduced) return;
			rafId = requestAnimationFrame(tick);
		};

		const onMove = (event) => {
			if (window.innerWidth < minDesktopWidth) return;
			rawX = event.clientX;
			rawY = event.clientY;
			pointerInside = true;
			startLoop();
		};

		const onLeave = () => {
			pointerInside = false;
			mouseInitialized = false;
			startLoop();
		};

		const onResize = () => {
			for (const el of chars) {
				el.style.width = '';
				el.style.transform = '';
			}
			lockCharWidths();
			rects = null;
			captureRects();
		};

		const boot = () => {
			lockCharWidths();
			captureRects();
		};

		if (document.fonts?.ready) {
			document.fonts.ready.then(boot);
		} else {
			boot();
		}

		root.addEventListener('mousemove', onMove);
		root.addEventListener('mouseleave', onLeave);
		window.addEventListener('resize', onResize);
	})();
</script>
