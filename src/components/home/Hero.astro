---
/**
 * Home hero — sticky cream grid + name lockup + project polaroids.
 * Its bounded 200svh track contains the folder swallow before About follows.
 * Folder matches ProjectFolder (back → cards → front flap).
 */
import Polaroid from '../Polaroid.astro';
import { getAsset } from '../../lib/images';

/** Role eyebrow above the name — single-line, Lato Bold, all caps. */
const roleLabel = 'VISUAL DESIGNER';

const gridSrc = getAsset('/images/home/grid.webp').src;

/**
 * Folder silhouette (objectBoundingBox) — same path as ProjectFolder.
 * Hero paints blue chrome; shared ProjectFolder / folder-shape.svg stay beige.
 */
const folderClipPath =
	'M0 0.05938V0.22084V0.94062C0 0.97341 0.01931 1 0.04314 1H0.95686C0.98069 1 1 0.97341 1 0.94062V0.12983C1 0.09704 0.98095 0.07045 0.95713 0.07045H0.39177C0.36822 0.07045 0.35134 0.05201 0.34046 0.034C0.3292 0.01536 0.31363 0 0.29602 0H0.04314C0.01931 0 0 0.02659 0 0.05938Z';

const heroFolderClipId = 'hero-folder-clip';

interface HeroPolaroid {
	readonly src: string;
	readonly alt: string;
	readonly top: string;
	readonly left: string;
	readonly width: string;
	/** Phone-only resting position; desktop keeps the values above. */
	readonly mobileTop?: string;
	readonly mobileLeft?: string;
	readonly mobileWidth?: string;
	readonly aspectRatio: string;
	readonly rotate: number;
	/** Stacking order — higher sits above. */
	readonly z?: number;
	/** Show on small screens (only a few so the name stays readable). */
	readonly mobileShow?: boolean;
}

/** Oval scatter — left column kept; right column is its horizontal mirror. */
const heroPolaroids: readonly HeroPolaroid[] = [
	{
		src: '/images/work/02-igl.png',
		alt: 'IGL rebrand',
		top: '2.4%',
		left: '11.9%',
		width: 'clamp(7.7rem, 15.5vw, 11.8rem)',
		mobileTop: '4%',
		mobileLeft: '2%',
		mobileWidth: 'clamp(6rem, 29vw, 8.25rem)',
		aspectRatio: '3 / 4',
		rotate: -9,
		z: 1,
		mobileShow: true,
	},
	{
		src: '/images/work/03-mythila.png',
		alt: 'Mythila typeface',
		top: '64.6%',
		left: '85.7%',
		width: 'clamp(8.3rem, 17.7vw, 13.5rem)',
		mobileTop: '71%',
		mobileLeft: '68%',
		mobileWidth: 'clamp(6.5rem, 30vw, 8.25rem)',
		aspectRatio: '5 / 4',
		rotate: 4,
		z: 47,
		mobileShow: true,
	},
	{
		src: '/images/work/igl-logo.jpeg',
		alt: 'IGL logo',
		top: '15.8%',
		left: '3.7%',
		width: 'clamp(8.9rem, 19vw, 14.2rem)',
		aspectRatio: '5 / 4',
		rotate: 11,
		z: 3,
	},
	{
		src: '/images/work/aksharchitraletter.png',
		alt: 'Akshar Chitra',
		top: '12.7%',
		left: '85.5%',
		width: 'clamp(7.4rem, 14.8vw, 11.6rem)',
		aspectRatio: '5 / 6',
		rotate: -11,
		z: 49,
	},
	{
		src: '/images/work/maharaja-bg.png',
		alt: 'Air India brand',
		top: '64.2%',
		left: '5.2%',
		width: 'clamp(8.9rem, 19vw, 14.2rem)',
		mobileTop: '70%',
		mobileLeft: '-2%',
		mobileWidth: 'clamp(6.75rem, 33vw, 9rem)',
		aspectRatio: '5 / 4',
		rotate: -10,
		z: 11,
		mobileShow: true,
	},
	{
		src: '/images/case-studies/himalayan/gallery-storyteller.png',
		alt: 'Himalayan book',
		top: '75.2%',
		left: '77.5%',
		width: 'clamp(8.1rem, 17.3vw, 12.9rem)',
		aspectRatio: '5 / 4',
		rotate: -4,
		z: 48,
	},
	{
		src: '/images/case-studies/vivan/brochure.png',
		alt: 'Vivan Hospital',
		top: '76.7%',
		left: '14.1%',
		width: 'clamp(7.1rem, 15.5vw, 11.8rem)',
		aspectRatio: '5 / 4',
		rotate: 4,
		z: 7,
	},
	{
		src: '/images/case-studies/convergence/cover.png',
		alt: 'Convergence',
		top: '40.9%',
		left: '83.8%',
		width: 'clamp(9.8rem, 21.1vw, 15.8rem)',
		mobileTop: '23%',
		mobileLeft: '68%',
		mobileWidth: 'clamp(6.75rem, 34vw, 9.5rem)',
		aspectRatio: '16 / 9',
		rotate: -5,
		z: 42,
		mobileShow: true,
	},
	{
		src: '/images/work/whatsapp-image-2026-08-04-at-23-10-58.jpg',
		alt: 'whatsapp image 2026 08 04 at 23 10 58',
		top: '41.1%',
		left: '1.7%',
		width: 'clamp(11.6rem, 23.4vw, 17.7rem)',
		aspectRatio: '2.2 / 1',
		rotate: 5,
		z: 9,
	},
	{
		src: '/images/work/whatsapp-image-2026-08-05-at-00-26-22.jpg',
		alt: 'whatsapp image 2026 08 05 at 00 26 22',
		top: '4.6%',
		left: '76.3%',
		width: 'clamp(7.9rem, 16vw, 12.2rem)',
		aspectRatio: '5 / 4',
		rotate: 9,
		z: 50,
	},
