/**
 * Absolute cards that live in the pocket (back → stuff → flap).
 * They pop up from under the flap mid-swallow so the folder looks stuffed.
 */
interface FolderStuffCard {
	readonly src: string;
	readonly alt: string;
	readonly left: string;
	readonly top: string;
	readonly width: string;
	readonly aspectRatio: string;
	readonly rotate: number;
	readonly z: number;
}

const folderStuff: readonly FolderStuffCard[] = [
	{
		src: '/images/work/01-air-india.png',
		alt: '',
		left: '4%',
		top: '0%',
		width: '46%',
		aspectRatio: '5 / 4',
		rotate: -16,
		z: 1,
	},
	{
		src: '/images/work/02-igl.png',
		alt: '',
		left: '22%',
		top: '-2%',
		width: '42%',
		aspectRatio: '3 / 4',
		rotate: 9,
		z: 3,
	},
	{
		src: '/images/work/03-mythila.png',
		alt: '',
		left: '48%',
		top: '1%',
		width: '44%',
		aspectRatio: '5 / 4',
		rotate: -7,
		z: 2,
	},
	{
		src: '/images/work/04-akshar-chitra.png',
		alt: '',
		left: '30%',
		top: '3%',
		width: '40%',
		aspectRatio: '5 / 6',
		rotate: 14,
		z: 4,
	},
	{
		src: '/images/work/09-vivan.png',
		alt: '',
		left: '58%',
		top: '-1%',
		width: '38%',
		aspectRatio: '4 / 5',
		rotate: -11,
		z: 1,
	},
];
---

<div
	class="hero-track relative -mt-[var(--spacing-page-chrome)] h-[200svh] w-full"
	data-hero-track
>
	<section
		class="hero sticky top-0 z-0 flex h-svh w-full flex-col overflow-hidden bg-canvas"
		aria-labelledby="hero-heading"
		data-hero
	>
	<div
		class="pointer-events-none absolute inset-0 z-0"
		style={`background-image: url('${gridSrc}'); background-size: 80%; background-position: center center; background-repeat: repeat; mask-image: linear-gradient(black 0%, black 85%, transparent 85%); -webkit-mask-image: linear-gradient(black 0%, black 85%, transparent 85%);`}
	>
	</div>

	{/*
	  Scroll cue — bottom-center, under the folder (z-3 < folder z-4)
	  so the rising pocket covers it during the swallow.
	*/}
	<div
		class="hero-scroll-hint pointer-events-none absolute bottom-[8%] left-1/2 z-[3] flex -translate-x-1/2 flex-col items-center gap-3"
		data-hero-scroll-hint
		aria-hidden="true"
	>
		<span
			class="font-label text-sm font-bold uppercase tracking-[0.12em] text-ink"
		>
			Scroll
		</span>
		<span class="hero-scroll-hint__mouse" aria-hidden="true">
			<span class="hero-scroll-hint__wheel"></span>
		</span>
	</div>

	{/*
	  Single folder stage (ProjectFolder layers):
	  back → mid (polaroids, fixed to viewport) → front flap.
	  No transform on this wrapper so position:fixed scatter stays correct.
	*/}
	<div
		class="pointer-events-none absolute bottom-[5%] left-0 right-0 z-[4] mx-auto w-[min(52vw,22rem)]"
		data-hero-folder
		aria-hidden="true"
	>
		<div class="relative w-full pt-[72.65%]">
			<svg
				class="pointer-events-none absolute h-px w-px overflow-hidden opacity-0"
				aria-hidden="true"
				focusable="false"
			>
				<defs>
					<clipPath id={heroFolderClipId} clipPathUnits="objectBoundingBox">
						<path d={folderClipPath}></path>
					</clipPath>
				</defs>
			</svg>

			{/* 1. Tabbed back — blue chrome (hero-only) */}
			<div
				class="hero-folder-back-shadow pointer-events-none absolute inset-0 z-0"
				data-hero-folder-back
				aria-hidden="true"
			>
				<div
					class="hero-folder-back absolute inset-0"
					style={`clip-path: url(#${heroFolderClipId})`}
				></div>
			</div>

			{/* 2. Mid pocket — scatter + stuffed cards sit under the flap */}
			<div
				class="absolute inset-0 z-[1] overflow-visible"
				data-hero-folder-mid
			>
				<div
					class="absolute top-[40%] left-1/2 size-0 -translate-x-1/2"
					data-hero-folder-pocket
				></div>
				{
					folderStuff.map((card) => (
						<div
							class="hero-stuff absolute origin-bottom"
							data-hero-stuff
							data-rotate={card.rotate}
							style={`left: ${card.left}; top: ${card.top}; width: ${card.width}; z-index: ${card.z};`}
						>
							<Polaroid
								imageSrc={card.src}
								imageAlt={card.alt}
								variant="classic"
								rotate={0}
								aspectRatio={card.aspectRatio}
								class="!max-w-none w-full"
							/>
						</div>
					))
				}
				{
					heroPolaroids.map((card, index) => (
						<div
							class:list={[
								'hero-polaroid',
								card.mobileShow ? 'block' : 'hidden md:block',
							]}
							data-hero-polaroid
							data-rotate={card.rotate}
							data-mobile-show={card.mobileShow ? 'true' : undefined}
							style={`--hero-polaroid-top: ${card.top}; --hero-polaroid-left: ${card.left}; --hero-polaroid-width: ${card.width}; --hero-polaroid-mobile-top: ${card.mobileTop ?? card.top}; --hero-polaroid-mobile-left: ${card.mobileLeft ?? card.left}; --hero-polaroid-mobile-width: ${card.mobileWidth ?? card.width}; z-index: ${card.z ?? index + 1}; transform: rotate(${card.rotate}deg);`}
						>
							<Polaroid
								imageSrc={card.src}
								imageAlt={card.alt}
								variant="classic"
								rotate={0}
								aspectRatio={card.aspectRatio}
								class="!max-w-none w-full"
							/>
						</div>
					))
				}
			</div>

			{/* 3. Front flap — cards slide under this */}
			<div
				class="hero-folder-flap absolute top-[18.6%] right-0 bottom-0 left-0 z-[2] rounded-[22px]"
				data-hero-folder-flap
			></div>
		</div>
	</div>

	<div
		class="hero-title-group relative z-10 flex w-full flex-col items-center justify-center"
		style="margin-top: auto; margin-bottom: 40vh;"
	>
		<h1
			id="hero-heading"
			class="hero-name cursor-default whitespace-nowrap text-center font-display uppercase text-[#242424]"
		>
			Ashima Kaushik
		</h1>

		<p
			class="hero-subtitle mt-3 type-label-md whitespace-nowrap text-center text-[#242424]"
		>
			{roleLabel}
		</p>
	</div>

	</section>

{/*
  Two-stage scroll stand-in:
  1) first viewport — folder swallow plays (Featured still below)
  2) second viewport — Featured slides over the fixed hero
*/}
	<div
		class="pointer-events-none absolute inset-0"
		data-hero-spacer
		aria-hidden="true"
	></div>
</div>

<style>
	.hero {
		/* Keep fixed scatter cards bound to this sticky section after release. */
		transform: translateZ(0);
	}

	.hero-name,
	:global(.hero-name-line) {
		font-size: clamp(3.5rem, 10vw, 8rem);
		line-height: 1;
		letter-spacing: -0.03em;
	}

	:global(.hero-name-char) {
		display: inline-block;
	}

	.hero-polaroid,
	.hero-stuff {
		opacity: 0;
		pointer-events: none;
	}

	.hero-polaroid {
		position: fixed;
		top: var(--hero-polaroid-mobile-top);
		left: var(--hero-polaroid-mobile-left);
		width: var(--hero-polaroid-mobile-width);
	}

	@media (width >= 48rem) {
		.hero-polaroid {
			top: var(--hero-polaroid-top);
			left: var(--hero-polaroid-left);
			width: var(--hero-polaroid-width);
		}
	}

	.hero[data-hero-intro='done'] .hero-polaroid {
		opacity: 1;
		pointer-events: none;
	}

	.hero.is-animating .hero-polaroid,
	.hero.is-animating .hero-stuff,
	.hero.is-animating :global(.hero-name-char) {
		will-change: transform, opacity;
	}

	.hero-scroll-hint {
		opacity: 0;
		transition: opacity 0.45s ease;
	}

	.hero[data-hero-intro='done'] .hero-scroll-hint:not([data-hidden='true']) {
		opacity: 1;
	}

	.hero-scroll-hint[data-hidden='true'] {
		opacity: 0;
	}

	.hero-scroll-hint__mouse {
		display: block;
		width: 1.375rem;
		height: 2.25rem;
		border: 1.5px solid rgb(24 24 24 / 0.45);
		border-radius: 999px;
		position: relative;
	}

	.hero-scroll-hint__wheel {
		position: absolute;
		top: 0.4rem;
		left: 50%;
		width: 0.2rem;
		height: 0.45rem;
		margin-left: -0.1rem;
		border-radius: 999px;
		background: var(--color-ink);
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero[data-hero-intro='done']
			.hero-scroll-hint:not([data-hidden='true'])
			.hero-scroll-hint__wheel {
			animation: hero-scroll-wheel 1.6s ease-in-out infinite;
		}
	}

	@keyframes hero-scroll-wheel {
		0% {
			transform: translateY(0);
			opacity: 1;
		}
		60% {
			transform: translateY(0.45rem);
			opacity: 0;
		}
		100% {
			transform: translateY(0);
			opacity: 0;
		}
	}

	.hero-folder-back-shadow {
		filter: drop-shadow(1px 4px 6.8px rgb(0 0 0 / 0.25));
	}

	.hero-folder-back {
		background-image: linear-gradient(180.41deg, #d6e8f6 -9%, #9bb8d4 57%);
	}

	.hero-folder-flap {
		background-image: linear-gradient(
			180.41deg,
			#bed7ed 2.53%,
			#7a9fbe 196.18%
		);
		box-shadow:
			0 1px 2px rgb(59 87 110 / 0.12),
			0 4px 14px rgb(0 0 0 / 0.1);
	}

	[data-hero-folder-back],
	[data-hero-folder-flap] {
		opacity: 0;
	}

	/*
	  Hide intro targets until JS takes over (avoids a hard pop-in).
	  Reduced-motion skips the pending state via the inline bootstrap.
	*/
	@media (prefers-reduced-motion: no-preference) {
		.hero[data-hero-intro='pending']
			.hero-name:not([data-hero-name-enhanced='true']),
		.hero[data-hero-intro='pending'] :global(.hero-name-char),
		.hero[data-hero-intro='pending'] .hero-subtitle,
		.hero[data-hero-intro='pending'] .hero-polaroid,
		.hero[data-hero-intro='running'] :global(.hero-name-char),
		.hero[data-hero-intro='running'] .hero-subtitle,
		.hero[data-hero-intro='running'] .hero-polaroid {
			opacity: 0;
		}
	}
</style>

<script is:inline>
	(() => {
		const hero = document.querySelector('[data-hero]');
		if (!hero) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			hero.setAttribute('data-hero-intro', 'done');
			return;
		}
		hero.setAttribute('data-hero-intro', 'pending');
	})();
</script>

<script>
	import { initHeroIntro } from '../../scripts/hero-intro';
	import { initHeroPolaroids } from '../../scripts/hero-polaroids';
	import {
		buildLineRanges,
		initMagneticType,
	} from '../../scripts/magnetic-type';

	const nameLines = ['ASHIMA', 'KAUSHIK'] as const;

	/**
	 * Progressively enhance the semantic server-rendered name into the glyph
	 * wrappers used by the intro and magnetic-type animations.
	 */
	const enhanceHeroName = (root: HTMLElement): void => {
		if (root.dataset.heroNameEnhanced === 'true') return;

		const fragment = document.createDocumentFragment();
		for (const line of nameLines) {
			const lineElement = document.createElement('span');
			lineElement.className =
				'hero-name-line magnetic-type__word block font-display text-[#242424]';
			lineElement.dataset.magneticWord = '';

			for (const character of Array.from(line)) {
				const characterElement = document.createElement('span');
				characterElement.className =
					'hero-name-char magnetic-type__char';
				characterElement.dataset.magneticChar = '';
				characterElement.textContent = character;
				lineElement.append(characterElement);
			}

			fragment.append(lineElement);
		}

		root.replaceChildren(fragment);
		root.dataset.heroNameEnhanced = 'true';
	};

	const startMagnetic = () => {
		const root = document.getElementById('hero-heading');
		if (!(root instanceof HTMLElement)) return;
		if (root.dataset.magneticInit === 'true') return;
		root.dataset.magneticInit = 'true';
		const magnetic = initMagneticType({
			root,
			wordRanges: buildLineRanges(nameLines),
		});
		// Phantom cursor sweeps the gap between ASHIMA / KAUSHIK, then settles.
		// Real hover still interrupts and takes over.
		magnetic.playAutoplay({ delay: 0, duration: 1200 });
	};

	const boot = () => {
		const nameRoot = document.getElementById('hero-heading');
		if (nameRoot instanceof HTMLElement) {
			enhanceHeroName(nameRoot);
		}

		const scrollHint = document.querySelector<HTMLElement>(
			'[data-hero-scroll-hint]',
		);
		const hideScrollHint = () => {
			if (!scrollHint || scrollHint.dataset.hidden === 'true') return;
			if (window.scrollY > 24) {
				scrollHint.dataset.hidden = 'true';
			}
		};
		window.addEventListener('scroll', hideScrollHint, { passive: true });
		hideScrollHint();

		initHeroIntro(() => {
			initHeroPolaroids();
			startMagnetic();
		});
	};

	void Promise.all([document.fonts?.ready ?? Promise.resolve()]).then(boot);
</script>
