---
/**
 * Home hero — polaroid portrait + intro + experience panel (Figma 149:877).
 */
import Polaroid from '../Polaroid.astro';

const specialises = [
	'Brand Identity',
	'Editorial Design',
	'Typography',
	'Design Research',
];
---

<section
	class="hero mx-auto grid max-w-[75rem] items-center gap-10 px-[clamp(1rem,3vw,2rem)] pb-16 pt-8 md:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] md:gap-12 md:pb-20 md:pt-12 lg:gap-16"
	aria-labelledby="hero-heading"
>
	<div class="flex justify-center md:justify-start">
		<Polaroid
			imageSrc="/images/home/polaroid-hero-demo.png"
			imageAlt="Ashima Kaushik"
			variant="classic"
			rotate={-2}
			aspectRatio="341 / 493"
			class="w-full max-w-[min(100%,26rem)]"
		/>
	</div>

	<div class="min-w-0">
		<p
			class="font-label text-2xl font-light tracking-[0.27rem] text-footer-ink"
		>
			HELLO!
		</p>
		<h1
			id="hero-heading"
			class="type-h2 mt-3 text-footer-ink md:mt-4"
		>
			I’m Ashima Kaushik
		</h1>

		<div class="relative mt-5 max-w-[27.5rem]">
			<p class="type-body-md text-primary">
				A <span class="hero__underline">visual communication designer</span> creating
				thoughtful visual systems through research, strategy, typography and
				storytelling.
			</p>
			<img
				src="/images/home/underline.svg"
				alt=""
				aria-hidden="true"
				class="pointer-events-none absolute top-[1.55rem] left-1.5 w-[min(100%,16.25rem)] select-none"
			/>
		</div>

		<div
			class="mt-10 grid max-w-[36rem] grid-cols-1 gap-8 border border-primary/40 px-6 py-6 sm:grid-cols-2 sm:gap-0 sm:px-0 sm:py-0"
		>
			<div class="sm:border-r sm:border-primary/40 sm:px-8 sm:py-7">
				<p class="type-label-md text-primary">Experience</p>
				<p class="mt-3 font-hand text-lg leading-6 text-primary">4 years</p>
			</div>
			<div class="sm:px-8 sm:py-7">
				<p class="type-label-md text-primary">Specialises in</p>
				<ul class="mt-3 list-none space-y-0 p-0 font-hand text-lg leading-6 text-primary">
					{
						specialises.map((item) => (
							<li>→ {item}</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

<style>
	.hero__underline {
		position: relative;
		z-index: 1;
	}
</style>
