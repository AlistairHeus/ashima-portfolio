---
/**
 * Home hero — fixed cream grid + name lockup + project polaroids.
 * Scroll (200svh spacer): folder swallow first, then Featured slides over.
 * Folder matches ProjectFolder (back → cards → front flap).
 */
import Polaroid from '../Polaroid.astro';

/** Left / right subtitles — single-line, Lato Bold, all caps. */
const roleLabel = 'VISUAL DESIGNER';
const locationLabel = 'BASED IN INDIA';

const gridSrc = '/images/home/grid.webp';

/**
 * Folder silhouette (objectBoundingBox) — same path as ProjectFolder.
 * Hero paints blue chrome; shared ProjectFolder / folder-shape.svg stay beige.
 */
const folderClipPath =
	'M0 0.05938V0.22084V0.94062C0 0.97341 0.01931 1 0.04314 1H0.95686C0.98069 1 1 0.97341 1 0.94062V0.12983C1 0.09704 0.98095 0.07045 0.95713 0.07045H0.39177C0.36822 0.07045 0.35134 0.05201 0.34046 0.034C0.3292 0.01536 0.31363 0 0.29602 0H0.04314C0.01931 0 0 0.02659 0 0.05938Z';

const heroFolderClipId = 'hero-folder-clip';

interface HeroPolaroid {
	readonly src: string;
	readonly alt: string;
	readonly top: string;
	readonly left: string;
	readonly width: string;
	readonly aspectRatio: string;
	readonly rotate: number;
	/** Show on small screens (only a few so the name stays readable). */
	readonly mobileShow?: boolean;
}

/** Oval scatter around the name — mixed sizes/tilts from work thumbs. */
const heroPolaroids: readonly HeroPolaroid[] = [
	{
		src: '/images/work/02-igl.png',
		alt: 'IGL rebrand',
		top: '6%',
		left: '6%',
		width: 'clamp(7.7rem, 15.5vw, 11.8rem)',
		aspectRatio: '3 / 4',
		rotate: -9,
		mobileShow: true,
	},
	{
		src: '/images/case-studies/mythila/animation.gif',
		alt: 'Mythila typeface',
		top: '4%',
		left: '78%',
		width: 'clamp(8.25rem, 17.7vw, 13.5rem)',
		aspectRatio: '1 / 1',
		rotate: 7,
		mobileShow: true,
	},
	{
		
		src: '/images/case-studies/igl/final-after.png',
		alt: 'IGL logo',
		top: '22%',
		left: '2%',
		width: 'clamp(6.5rem, 13vw, 10rem)',
		aspectRatio: '5 / 6',
		rotate: 11,
	},
	{
		src: '/images/work/04-akshar-chitra.png',
		alt: 'Akshar Chitra',

		top: '18%',
		left: '86%',
		width: 'clamp(7.1rem, 14.2vw, 11.2rem)',
		aspectRatio: '5 / 4',
		rotate: -6,
	},
	{
		
		src: '/images/work/maharaja-bg.png',
		alt: 'Air India brand',
		top: '64%',
		left: '4%',
		width: 'clamp(8.85rem, 19vw, 14.2rem)',
		aspectRatio: '5 / 4',
		rotate: -12,
		mobileShow: true,
	},
	{
		src: '/images/case-studies/himalayan/gallery-storyteller.png',
		alt: 'Himalayan book',
		top: '52%',
		left: '82%',
		width: 'clamp(8.85rem, 19vw, 14.2rem)',
		aspectRatio: '5 / 4',
		rotate: 8,
	},
	{
		src: '/images/case-studies/vivan/brochure.png',
		alt: 'Vivan Hospital',
		top: '78%',
		left: '12%',
		width: 'clamp(7.1rem, 15.5vw, 11.8rem)',
		aspectRatio: '5 / 4',
		rotate: 5,
	},
	{
		src: '/images/case-studies/convergence/convergence_cover.gif',
		alt: 'Convergence',
		top: '70%',
		left: '72%',
		width: 'clamp(7.7rem, 16.5vw, 12.4rem)',
		aspectRatio: '3 / 4',
		rotate: -8,
		mobileShow: true,
	},
];

/**
 * Absolute cards that live in the pocket (back → stuff → flap).
 * They pop up from under the flap mid-swallow so the folder looks stuffed.
 */
interface FolderStuffCard {
	readonly src: string;
	readonly alt: string;
	readonly left: string;
	readonly top: string;
	readonly width: string;
	readonly aspectRatio: string;
	readonly rotate: number;
	readonly z: number;
}

const folderStuff: readonly FolderStuffCard[] = [
	{
		src: '/images/work/01-air-india.png',
		alt: '',
		left: '4%',
		top: '0%',
		width: '46%',
		aspectRatio: '5 / 4',
		rotate: -16,
		z: 1,
	},
	{
		src: '/images/work/02-igl.png',
		alt: '',
		left: '22%',
		top: '-2%',
		width: '42%',
		aspectRatio: '3 / 4',
		rotate: 9,
		z: 3,
	},
	{
		src: '/images/case-studies/mythila/animation.gif',
		alt: '',
		left: '48%',
		top: '1%',
		width: '44%',
		aspectRatio: '1 / 1',
		rotate: -7,
		z: 2,
	},
	{
		src: '/images/work/04-akshar-chitra.png',
		alt: '',
		left: '30%',
		top: '3%',
		width: '40%',
		aspectRatio: '5 / 6',
		rotate: 14,
		z: 4,
	},
	{
		src: '/images/work/09-vivan.png',
		alt: '',
		left: '58%',
		top: '-1%',
		width: '38%',
		aspectRatio: '4 / 5',
		rotate: -11,
		z: 1,
	},
];
---

<section
	class="hero fixed inset-0 z-0 flex h-svh w-full flex-col overflow-hidden bg-canvas"
	aria-labelledby="hero-heading"
	data-hero
>
	<div
		class="pointer-events-none absolute inset-0 z-0"
		style={`background-image: url('${gridSrc}'); background-size: 80%; background-position: center center; background-repeat: repeat; mask-image: linear-gradient(black 0%, black 85%, transparent 85%); -webkit-mask-image: linear-gradient(black 0%, black 85%, transparent 85%);`}
	>
	</div>

	{/*
	  Single folder stage (ProjectFolder layers):
	  back → mid (polaroids, fixed to viewport) → front flap.
	  No transform on this wrapper so position:fixed scatter stays correct.
	*/}
	<div
		class="pointer-events-none absolute bottom-[5%] left-0 right-0 z-[4] mx-auto w-[min(52vw,22rem)]"
		data-hero-folder
		aria-hidden="true"
	>
		<div class="relative w-full pt-[72.65%]">
			<svg
				class="pointer-events-none absolute h-px w-px overflow-hidden opacity-0"
				aria-hidden="true"
				focusable="false"
			>
				<defs>
					<clipPath id={heroFolderClipId} clipPathUnits="objectBoundingBox">
						<path d={folderClipPath}></path>
					</clipPath>
				</defs>
			</svg>

			{/* 1. Tabbed back — blue chrome (hero-only) */}
			<div
				class="hero-folder-back-shadow pointer-events-none absolute inset-0 z-0"
				data-hero-folder-back
				aria-hidden="true"
			>
				<div
					class="hero-folder-back absolute inset-0"
					style={`clip-path: url(#${heroFolderClipId})`}
				></div>
			</div>

			{/* 2. Mid pocket — scatter + stuffed cards sit under the flap */}
			<div
				class="absolute inset-0 z-[1] overflow-visible"
				data-hero-folder-mid
			>
				<div
					class="absolute top-[40%] left-1/2 size-0 -translate-x-1/2"
					data-hero-folder-pocket
				></div>
				{
					folderStuff.map((card) => (
						<div
							class="hero-stuff absolute origin-bottom"
							data-hero-stuff
							data-rotate={card.rotate}
							style={`left: ${card.left}; top: ${card.top}; width: ${card.width}; z-index: ${card.z};`}
						>
							<Polaroid
								imageSrc={card.src}
								imageAlt={card.alt}
								variant="classic"
								rotate={0}
								aspectRatio={card.aspectRatio}
								class="!max-w-none w-full"
							/>
						</div>
					))
				}
				{
					heroPolaroids.map((card) => (
						<div
							class:list={[
								'hero-polaroid',
								card.mobileShow ? 'block' : 'hidden md:block',
							]}
							data-hero-polaroid
							data-rotate={card.rotate}
							data-mobile-show={card.mobileShow ? 'true' : undefined}
							style={`position: fixed; top: ${card.top}; left: ${card.left}; width: ${card.width}; transform: rotate(${card.rotate}deg);`}
						>
							<Polaroid
								imageSrc={card.src}
								imageAlt={card.alt}
								variant="classic"
								rotate={0}
								aspectRatio={card.aspectRatio}
								class="!max-w-none w-full"
							/>
						</div>
					))
				}
			</div>

			{/* 3. Front flap — cards slide under this */}
			<div
				class="hero-folder-flap absolute top-[18.6%] right-0 bottom-0 left-0 z-[2] rounded-[22px]"
				data-hero-folder-flap
			></div>
		</div>
	</div>

	<div
		class="hero-title-group relative z-10 flex w-full items-center justify-center"
		style="margin-top: auto; margin-bottom: 40vh;"
	>
		{/* Desktop: role label */}
		<div
			class="hero-lines absolute hidden items-center md:flex"
			style="left: 5%; right: 50%; margin-right: min(25vw, 400px);"
		>
			<span
				class="hero-subtitle-text ml-auto whitespace-nowrap font-label text-[clamp(0.875rem,1.1vw,1.125rem)] font-bold uppercase leading-none tracking-[0.06em] text-[#242424]"
			>
				{roleLabel}
			</span>
		</div>

		{/* Mobile role */}
		<p
			class="hero-mobile-subtitle mb-3 whitespace-nowrap text-center font-label text-sm font-bold uppercase leading-none tracking-[0.06em] text-[#242424] md:hidden"
		>
			{roleLabel}
		</p>

		<h1
			id="hero-heading"
			class="hero-name cursor-default whitespace-nowrap text-center font-display uppercase text-[#242424]"
		>
			Ashima Kaushik
		</h1>

		{/* Mobile location */}
		<p
			class="hero-mobile-subtitle mt-3 whitespace-nowrap text-center font-label text-sm font-bold uppercase leading-none tracking-[0.06em] text-[#242424] md:hidden"
		>
			{locationLabel}
		</p>

		{/* Desktop: location label */}
		<div
			class="hero-lines absolute hidden items-center md:flex"
			style="right: 5%; left: 50%; margin-left: min(25vw, 400px);"
		>
			<span
				class="hero-subtitle-text whitespace-nowrap font-label text-[clamp(0.875rem,1.1vw,1.125rem)] font-bold uppercase leading-none tracking-[0.06em] text-[#242424]"
			>
				{locationLabel}
			</span>
		</div>
	</div>

</section>

{/*
  Two-stage scroll stand-in:
  1) first viewport — folder swallow plays (Featured still below)
  2) second viewport — Featured slides over the fixed hero
*/}
<div
	class="pointer-events-none relative -mt-[var(--spacing-page-chrome)] h-[200svh] w-full"
	data-hero-spacer
	aria-hidden="true"
></div>

<style>
	.hero-name,
	:global(.hero-name-line) {
		font-size: clamp(3.5rem, 10vw, 8rem);
		line-height: 1;
		letter-spacing: -0.03em;
	}

	:global(.hero-name-char) {
		will-change: transform, font-variation-settings, opacity;
	}

	.hero-polaroid {
		will-change: transform, opacity;
	}

	.hero-stuff {
		will-change: transform, opacity;
		opacity: 0;
		pointer-events: none;
	}

	.hero-folder-back-shadow {
		filter: drop-shadow(1px 4px 6.8px rgb(0 0 0 / 0.25));
	}

	.hero-folder-back {
		background-image: linear-gradient(180.41deg, #d6e8f6 -9%, #9bb8d4 57%);
	}

	.hero-folder-flap {
		background-image: linear-gradient(
			180.41deg,
			#bed7ed 2.53%,
			#7a9fbe 196.18%
		);
		box-shadow:
			0 1px 2px rgb(59 87 110 / 0.12),
			0 4px 14px rgb(0 0 0 / 0.1);
	}

	[data-hero-folder-back],
	[data-hero-folder-flap] {
		will-change: opacity;
		opacity: 0;
	}

	/*
	  Hide intro targets until JS takes over (avoids a hard pop-in).
	  Reduced-motion skips the pending state via the inline bootstrap.
	*/
	@media (prefers-reduced-motion: no-preference) {
		.hero[data-hero-intro='pending']
			.hero-name:not([data-hero-name-enhanced='true']),
		.hero[data-hero-intro='pending'] :global(.hero-name-char),
		.hero[data-hero-intro='pending'] .hero-subtitle-text,
		.hero[data-hero-intro='pending'] .hero-mobile-subtitle,
		.hero[data-hero-intro='pending'] .hero-polaroid,
		.hero[data-hero-intro='running'] :global(.hero-name-char),
		.hero[data-hero-intro='running'] .hero-subtitle-text,
		.hero[data-hero-intro='running'] .hero-mobile-subtitle,
		.hero[data-hero-intro='running'] .hero-polaroid {
			opacity: 0;
		}
	}
</style>

<script is:inline>
	(() => {
		const hero = document.querySelector('[data-hero]');
		if (!hero) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			hero.setAttribute('data-hero-intro', 'done');
			return;
		}
		hero.setAttribute('data-hero-intro', 'pending');
	})();
</script>

<script>
	import { initHeroIntro } from '../../scripts/hero-intro';
	import { initHeroPolaroids } from '../../scripts/hero-polaroids';
	import {
		buildLineRanges,
		initMagneticType,
	} from '../../scripts/magnetic-type';

	const nameLines = ['ASHIMA', 'KAUSHIK'] as const;

	/**
	 * Progressively enhance the semantic server-rendered name into the glyph
	 * wrappers used by the intro and magnetic-type animations.
	 */
	const enhanceHeroName = (root: HTMLElement): void => {
		if (root.dataset.heroNameEnhanced === 'true') return;

		const fragment = document.createDocumentFragment();
		for (const line of nameLines) {
			const lineElement = document.createElement('span');
			lineElement.className =
				'hero-name-line magnetic-type__word block font-display text-[#242424]';
			lineElement.dataset.magneticWord = '';

			for (const character of Array.from(line)) {
				const characterElement = document.createElement('span');
				characterElement.className =
					'hero-name-char magnetic-type__char';
				characterElement.dataset.magneticChar = '';
				characterElement.textContent = character;
				lineElement.append(characterElement);
			}

			fragment.append(lineElement);
		}

		root.replaceChildren(fragment);
		root.dataset.heroNameEnhanced = 'true';
	};

	const startMagnetic = () => {
		const root = document.getElementById('hero-heading');
		if (!(root instanceof HTMLElement)) return;
		if (root.dataset.magneticInit === 'true') return;
		root.dataset.magneticInit = 'true';
		const magnetic = initMagneticType({
			root,
			wordRanges: buildLineRanges(nameLines),
		});
		// Phantom cursor sweeps the gap between ASHIMA / KAUSHIK, then settles.
		// Real hover still interrupts and takes over.
		magnetic.playAutoplay({ delay: 0, duration: 1200 });
	};

	const boot = () => {
		const nameRoot = document.getElementById('hero-heading');
		if (nameRoot instanceof HTMLElement) {
			enhanceHeroName(nameRoot);
		}

		initHeroIntro(() => {
			initHeroPolaroids();
			startMagnetic();
		});
	};

	void Promise.all([document.fonts?.ready ?? Promise.resolve()]).then(boot);
</script>
