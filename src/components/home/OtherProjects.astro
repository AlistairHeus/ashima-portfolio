---
/**
 * Other projects — list + stacked Polaroids (Figma home, ~149:921).
 * Background continues #FDFBF9 from Featured (no dots).
 * First item is active by default; last hovered/focused item stays active.
 * Non-active rows render as inactive (dimmed).
 */
import Chip from '../Chip.astro';
import Polaroid from '../Polaroid.astro';
import { otherWorkProjects } from '../../data/work';

const projects = otherWorkProjects.map((project) => ({
	id: project.id,
	title: project.title,
	chips: project.chips,
	href: project.href,
	imageSrc: project.imageSrc,
	imageAlt: project.imageAlt,
	/** Dim entries that do not yet have a dedicated case-study page. */
	muted: !project.href || project.href === '/work',
}));

/**
 * Stack slots from back → front. Length matches project count so every
 * polaroid gets a distinct offset / tilt in the pile.
 */
const stackSlots = [
	{ rotate: -9, left: '4%', top: '20%', width: '74%' },
	{ rotate: 7, left: '18%', top: '6%', width: '76%' },
	{ rotate: -4, left: '2%', top: '12%', width: '78%' },
	{ rotate: 5, left: '16%', top: '22%', width: '75%' },
	{ rotate: -6, left: '8%', top: '4%', width: '80%' },
	{ rotate: 3, left: '14%', top: '16%', width: '79%' },
	{ rotate: -2, left: '10%', top: '10%', width: '84%' },
] as const;
---

<section
	class="other-projects bg-surface-warm gutter-x-md pb-20 pt-6 md:pb-28 md:pt-10"
	aria-labelledby="other-projects-heading"
	data-other-projects
>
	<div class="page-max">
		<h2
			id="other-projects-heading"
			class="type-h5 text-center text-ink uppercase"
		>
			Other projects
		</h2>

		<div
			class="mt-10 grid items-center gap-12 lg:mt-14 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-16"
		>
			<ul class="m-0 list-none divide-y divide-muted/30 border-y border-muted/30 p-0">
				{
					projects.map((project, index) => (
						<li
							class:list={[
								'other-projects__item py-5 transition-opacity duration-200',
								project.muted && 'other-projects__item--muted',
							]}
							data-other-project-id={project.id}
							data-active={index === 0 ? 'true' : 'false'}
						>
							{project.href ? (
								<a
									href={project.href}
									class="flex items-center gap-5 text-heading no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
								>
									<div class="min-w-0 flex-1">
										<p class="type-h6">{project.title}</p>
										<div class="mt-3 flex flex-wrap gap-2">
											{project.chips.map((chip) => (
												<Chip label={chip} muted={project.muted} />
											))}
										</div>
									</div>
									<span
										class="other-projects__arrow shrink-0"
										aria-hidden="true"
									></span>
								</a>
							) : (
								<>
									<p class="type-h6 text-heading">{project.title}</p>
									<div class="mt-3 flex flex-wrap gap-2">
										{project.chips.map((chip) => (
											<Chip label={chip} muted={project.muted} />
										))}
									</div>
								</>
							)}
						</li>
					))
				}
			</ul>

			<div
				class="other-projects__stack relative mx-auto aspect-[4/5] w-full max-w-[34rem]"
				aria-hidden="true"
				data-other-projects-stack
				data-stack-slots={JSON.stringify(stackSlots.slice(0, projects.length))}
			>
				{
					projects.map((project, index) => {
						const slot = stackSlots[Math.min(index, stackSlots.length - 1)]!;
						return (
							<div
								class="other-projects__polaroid absolute"
								data-other-polaroid={project.id}
								style={`left: ${slot.left}; top: ${slot.top}; width: ${slot.width}; z-index: ${index + 1}; --polaroid-rotate: ${slot.rotate}deg;`}
							>
								<Polaroid
									imageSrc={project.imageSrc}
									imageAlt=""
									variant="classic"
									rotate={0}
									aspectRatio="442 / 408"
									class="other-projects__polaroid-frame max-w-none w-full"
									widths={[400, 640, 960]}
									sizes="(min-width: 1024px) 34rem, 90vw"
								/>
							</div>
						);
					})
				}
			</div>
		</div>
	</div>
</section>

<style>
	.other-projects__item {
		opacity: 0.4;
	}

	.other-projects__item--muted {
		opacity: 0.28;
	}

	.other-projects__item[data-active='true'] {
		opacity: 1;
	}

	.other-projects__item--muted[data-active='true'] {
		opacity: 0.7;
	}

	/* Arrow reveals on row hover / keyboard focus; ink matches title */
	.other-projects__arrow {
		display: block;
		width: 2.75rem;
		height: 3rem;
		background-color: currentColor;
		opacity: 0;
		transform: translateX(-0.25rem);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
		-webkit-mask-image: url('/icons/arrow-right.svg');
		mask-image: url('/icons/arrow-right.svg');
		-webkit-mask-size: contain;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-position: center;
		mask-position: center;
	}

	@media (width >= 48rem) {
		.other-projects__arrow {
			width: 3.25rem;
			height: 3.5rem;
		}
	}

	.other-projects__item:hover .other-projects__arrow,
	.other-projects__item:focus-within .other-projects__arrow {
		opacity: 1;
		transform: translateX(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.other-projects__arrow {
			transition: none;
			transform: none;
		}
	}

	.other-projects__polaroid {
		transform: rotate(var(--polaroid-rotate, 0deg));
		transition:
			left 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			top 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			z-index 0s linear 0.15s;
	}

	.other-projects__polaroid[data-active='true'] :global(.polaroid) {
		box-shadow: 0 8px 24px rgb(0 0 0 / 0.22);
		transition: box-shadow 0.35s ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.other-projects__polaroid {
			transition: none;
		}
	}
</style>

<script>
	import { initOtherProjectsStack } from '../../scripts/other-projects-stack';

	initOtherProjectsStack();
</script>
