---
/**
 * Featured case studies — sticky scroll folder stack.
 * Each folder carries its own tab label + content; tabs jump scroll to that step.
 * Figma Group 149:898. Folder assets: /images/home/folder-{1..4}.svg
 * Content from work catalogue case studies (first four).
 */
import Chip from '../Chip.astro';
import MagneticChars from '../MagneticChars.astro';
import OptimizedImage from '../OptimizedImage.astro';
import { caseStudies } from '../../data/work';
import { getCaseStudyById } from '../../data/case-studies';

interface FolderMeta {
	readonly folderSrc: string;
}

/**
 * Per-folder SVG silhouette (tab cutouts differ by index).
 * Kept in `public/images` — CSS mask-image breaks on Vite data-URI SVGs
 * (attribute quotes truncate `url('...')`).
 */
const folderMeta: readonly FolderMeta[] = [
	{ folderSrc: '/images/home/folder-1.svg' },
	{ folderSrc: '/images/home/folder-2.svg' },
	{ folderSrc: '/images/home/folder-3.svg' },
	{ folderSrc: '/images/home/folder-4.svg' },
];

const dotsUrl = '/images/home/dots.svg';

const projects = caseStudies.slice(0, folderMeta.length).map((study, index) => {
	const folder = folderMeta[index]!;
	const detail = getCaseStudyById(study.id);
	/** Hero band — drives ProjectFolder-style gradient fill. */
	const bandColor = detail?.heroBandColor || '#efe8e0';
	/** Folder accent — solid SVG outline / edge color. */
	const folderColor = detail?.folderColor || bandColor;
	/**
	 * Fill accent for the brand gradient layer.
	 * Mythila: old kraft inactive (`#ddc3ae`) reads better than teal folder / empty hero.
	 */
	const accentColor = study.id === 'mythila' ? '#ddc3ae' : bandColor;
	return {
		id: study.id,
		label: `PROJECT ${index + 1}`,
		folderSrc: folder.folderSrc,
		bandColor: accentColor,
		folderColor,
		/** Case-study page naming: category above, short title below. */
		category: detail?.category ?? '',
		title: detail?.title ?? study.title,
		description: study.description,
		imageSrc: study.imageSrc,
		imageAlt: study.imageAlt,
		chips: study.chips,
		href: study.href ?? '/work',
	};
});

/**
 * Tab hit-areas + labels aligned to each folder SVG’s flat tab top
 * (viewBox width 1495 — see folder-{1..4}.svg path geometry).
 * Vertically: tab strip is ~0.8%–6.6% of folder height.
 */
const FOLDER_VB = 1495;
const tabFlatRanges = [
	{ start: 28.5, end: 277.863 },
	{ start: 378.089, end: 627.451 },
	{ start: 727.672, end: 977.034 },
	{ start: 1077.26, end: 1326.62 },
] as const;

const tabSlots = tabFlatRanges.map(({ start, end }) => ({
	left: `${(start / FOLDER_VB) * 100}%`,
	width: `${((end - start) / FOLDER_VB) * 100}%`,
})) as readonly { readonly left: string; readonly width: string }[];

/** Scroll track: one viewport per folder step, plus a half-viewport dwell so
 *  the last folder can settle briefly before Other Projects takes over. */
const trackHeightVh = Math.max(1, projects.length) * 100 + 50;
---

<section
	class="featured overflow-x-clip bg-surface-warm"
	aria-label="Featured case studies"
	data-featured
>
	{/*
	  Same project data; chrome swaps at lg (stacked cards vs sticky folders).
	  Layout fork only — copy is not duplicated in the data.
	*/}
	<div class="featured-mobile relative overflow-hidden page-shell py-16 md:py-24 lg:hidden">
		<div
			class="featured__dots pointer-events-none absolute inset-0 z-0"
			aria-hidden="true"
			style={`background-image: url('${dotsUrl}')`}
		></div>

		<div class="relative z-[1] mx-auto max-w-[32rem]">
			<p class="type-label-md text-primary">Selected work</p>
			<h2 class="type-h5 mt-2 text-balance text-ink">Featured case studies</h2>
			<p class="type-body mt-4 max-w-[32rem] text-muted">
				Research-led identity, editorial, and experience design projects.
			</p>

			<div class="mt-10 flex flex-col gap-10">
				{
					projects.map((project, index) => (
						<article
							class="featured-mobile__project relative pt-8"
							style={`--featured-accent: ${project.bandColor}; --featured-outline: ${project.folderColor};`}
						>
							<div
								class="featured-mobile__tab absolute top-0 left-0 z-[1] flex h-10 min-w-[8.5rem] items-center px-4 font-label text-xs font-bold tracking-[0.16em] text-ink uppercase"
								aria-hidden="true"
							>
								{String(index + 1).padStart(2, '0')} · Case study
							</div>

							<a
								href={project.href}
								class="featured-mobile__card group relative block overflow-hidden rounded-[0_1.25rem_1.25rem_1.25rem] border border-ink/15 text-ink no-underline shadow-[0_8px_24px_rgb(24_24_24_/_0.12)] outline-offset-4 focus-visible:outline-2 focus-visible:outline-primary"
							>
								<div class="relative aspect-[4/3] overflow-hidden bg-canvas">
									<OptimizedImage
										src={project.imageSrc}
										alt={project.imageAlt}
										class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.025]"
										loading="lazy"
										decoding="async"
										widths={[320, 480, 640, 800]}
										sizes="(max-width: 1023px) calc(100vw - 2rem), 32rem"
									/>
								</div>

								<div class="min-w-0 p-5 sm:p-6">
									{project.category ? (
										<p class="type-eyebrow text-ink">{project.category}</p>
									) : null}
									<h3 class="type-featured mt-1 text-ink">
										{project.title}
									</h3>
									<p class="type-body mt-4 text-pretty text-ink">{project.description}</p>

									<div class="mt-5 flex flex-wrap gap-2">
										{project.chips.map((chip) => (
											<Chip label={chip} class="bg-canvas/45 px-3" />
										))}
									</div>

									<span
										class="mt-6 inline-flex min-h-11 items-center gap-3 type-label-md text-ink"
									>
										View case study
										<span class="text-2xl leading-none transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
									</span>
								</div>
							</a>
						</article>
					))
				}
			</div>
		</div>
	</div>

	{/* Tall track creates scroll distance; stage sticks while folders stack */}
	<div
		class="featured__track relative hidden lg:block"
		style={`height: ${trackHeightVh}vh`}
		data-featured-track
	>
		{/*
		  Overflow clips folders rising from below the viewport.
		  Folder size is capped by both width and remaining viewport height.
		*/}
		<div
			class="featured__sticky sticky top-0 flex h-svh flex-col overflow-hidden py-8 2xl:py-6"
			data-featured-pin
		>
			{/* Soft dotted field — pinned with the stage so it stays put while folders stack */}
			<div
				class="featured__dots pointer-events-none absolute inset-0 z-0"
				aria-hidden="true"
				style={`background-image: url('${dotsUrl}')`}
			></div>

			{/*
			  Scroll cue — bottom-center, under the folders (z-1 < content z-10)
			  so rising cards cover it as they stack.
			*/}
			<div
				class="featured-scroll-hint pointer-events-none absolute bottom-[4%] left-1/2 z-[1] flex -translate-x-1/2 flex-col items-center gap-3"
				data-featured-scroll-hint
				aria-hidden="true"
			>
				<span
					class="font-label text-sm font-bold uppercase tracking-[0.12em] text-ink"
				>
					Scroll
				</span>
				<span class="featured-scroll-hint__mouse" aria-hidden="true">
					<span class="featured-scroll-hint__wheel"></span>
				</span>
			</div>

			<div class="featured__fit relative z-10 page-shell flex min-h-0 flex-1 items-center justify-center">
				<div
					class="featured__stage relative"
					data-featured-stage
				>
					<div class="featured__frame relative w-full overflow-visible">
						{
							projects.map((project, index) => (
								<article
									id={`featured-card-${project.id}`}
									data-featured-card={project.id}
									data-featured-index={index}
									data-inactive="false"
									class="featured__card absolute inset-0 size-full"
									style={`z-index: ${index + 1}; transform: translate3d(0, ${index === 0 ? 0 : 100}vh, 0); --featured-accent: ${project.bandColor}; --featured-outline: ${project.folderColor}; --featured-folder-mask: url('${project.folderSrc}');`}
									aria-hidden={index === 0 ? 'false' : 'true'}
								>
									{/*
									  Beige underlay always opaque; brand gradient fades over it.
									  Avoids a see-through hole to n-2 when scrolling back up.
									*/}
									<div
										class="featured__folder-neutral pointer-events-none absolute inset-0"
										aria-hidden="true"
									></div>
									<div
										class="featured__folder-brand pointer-events-none absolute inset-0"
										aria-hidden="true"
									></div>

									{/* Visual tab label — travels with this folder (not the click target) */}
									<h3
										data-featured-tab-label={project.id}
										class="featured__tab featured__tab-label type-label pointer-events-none absolute top-[0.85%] z-20 m-0 flex h-[5.7%] items-center justify-center truncate px-1 leading-none text-ink"
										style={`left: ${tabSlots[index].left}; width: ${tabSlots[index].width}`}
									>
										{project.label}
									</h3>

									{/* Content area links to the case study; tabs stay scroll-only */}
									<a
										href={project.href}
										class="featured__pocket absolute inset-[16%_8%_8%] overflow-visible outline-offset-4 focus-visible:outline-2 focus-visible:outline-primary"
										style={`pointer-events: ${index === 0 ? 'auto' : 'none'}`}
										tabindex={index === 0 ? 0 : -1}
										data-featured-link={project.id}
										aria-label={`View ${project.category ? `${project.category} — ` : ''}${project.title} case study`}
										aria-hidden={index === 0 ? 'false' : 'true'}
									>
										<div class="grid h-full min-h-0 grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] items-center gap-4 xl:gap-8 2xl:gap-12">
											<div class="grid h-full min-h-0 min-w-0 place-items-center">
												<div class="relative aspect-square w-[min(100%,100cqh)]">
													<div class="size-full overflow-hidden rounded-xl shadow-[0px_1px_6.6px_0_rgba(0,0,0,0.25)]">
														<OptimizedImage
															src={project.imageSrc}
															alt=""
															aria-hidden="true"
															class="size-full object-cover"
															loading={index === 0 ? 'eager' : 'lazy'}
															decoding="async"
															widths={[480, 720, 960, 1200]}
															sizes="(min-width: 1536px) 43rem, (min-width: 1024px) 36vw, 90vw"
														/>
													</div>
													<OptimizedImage
														src="/images/home/kraft-tape.png"
														alt=""
														aria-hidden="true"
														class="pointer-events-none absolute -top-[8%] -right-[6%] z-20 w-[28%] max-w-40 -rotate-[140deg] select-none"
														widths={[160, 240, 320]}
														sizes="10rem"
													/>
													<OptimizedImage
														src="/images/home/kraft-tape.png"
														alt=""
														aria-hidden="true"
														class="pointer-events-none absolute -bottom-[6%] -left-[6%] z-20 w-[28%] max-w-40 rotate-[40deg] select-none"
														widths={[160, 240, 320]}
														sizes="10rem"
													/>
												</div>
											</div>

											<div class="min-h-0 min-w-0">
												{
													project.category ? (
														<p class="type-eyebrow text-ink">
															{project.category}
														</p>
													) : null
												}
												<p
													class:list={[
														'type-featured cursor-default text-ink',
														project.category && 'mt-1',
													]}
													data-magnetic-root
													data-magnetic-invert
												>
													<MagneticChars text={project.title} />
												</p>
												<p class="type-body mt-3 max-w-md text-pretty text-ink xl:mt-4 2xl:mt-5">
													{project.description}
												</p>
												<div class="mt-4 flex flex-wrap gap-2 xl:mt-5 2xl:mt-7">
													{project.chips.map((chip) => (
														<Chip label={chip} />
													))}
												</div>
											</div>
										</div>
									</a>
								</article>
							))
						}
					</div>

					{/*
					  Invisible hit targets over tab slots. Enabled only after that folder
					  has landed — visible titles live on each card and travel with it.
					*/}
					<div
						class="pointer-events-none absolute top-[0.85%] right-0 left-0 z-40 h-[5.7%]"
						role="tablist"
						aria-label="Featured projects"
					>
						{
							projects.map((project, index) => (
								<button
									type="button"
									role="tab"
									id={`featured-tab-${project.id}`}
									aria-selected={index === 0 ? 'true' : 'false'}
									aria-controls={`featured-card-${project.id}`}
									aria-label={project.label}
									aria-disabled={index === 0 ? 'false' : 'true'}
									data-featured-tab={project.id}
									data-featured-tab-index={index}
									tabindex={index === 0 ? 0 : -1}
									class="featured__tab absolute top-0 h-full cursor-pointer truncate px-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:cursor-default"
									style={`left: ${tabSlots[index].left}; width: ${tabSlots[index].width}; pointer-events: ${index === 0 ? 'auto' : 'none'}`}
									disabled={index !== 0}
								>
									<span class="sr-only">{project.label}</span>
								</button>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.featured__dots {
		background-size: 14px 14px;
		background-position: 0 0;
		background-repeat: repeat;
	}

	/*
	  Folder stays compact on 13" / 15" (lg–xl).
	  2xl (16" and desktop) is the only size-up.
	*/
	.featured__fit {
		container-type: size;
	}

	.featured__stage {
		container-type: inline-size;
		width: min(50rem, 100%, calc(62svh * 1495 / 918.127));
	}

	@media (min-width: 1536px) {
		.featured__stage {
			width: min(70rem, 100%, calc(78svh * 1495 / 918.127));
		}
	}

	.featured__frame {
		aspect-ratio: 1495 / 918.127;
	}

	.featured__pocket {
		container-type: size;
	}

	.featured-mobile__tab,
	.featured-mobile__card {
		background: linear-gradient(
			155deg,
			color-mix(in srgb, var(--featured-accent, #efe8e0) 78%, #ffffff),
			color-mix(in srgb, var(--featured-accent, #efe8e0) 34%, #ffffff)
		);
	}

	.featured-mobile__tab {
		border: 1px solid rgb(24 24 24 / 0.15);
		border-bottom: 0;
		border-radius: 0.75rem 0.75rem 0 0;
	}

	.featured__card {
		will-change: transform;
		contain: layout paint;
	}

	.featured-scroll-hint {
		transition: opacity 0.45s ease;
	}

	.featured-scroll-hint[data-hidden='true'] {
		opacity: 0;
	}

	.featured-scroll-hint__mouse {
		display: block;
		width: 1.375rem;
		height: 2.25rem;
		border: 1.5px solid rgb(24 24 24 / 0.45);
		border-radius: 999px;
		position: relative;
	}

	.featured-scroll-hint__wheel {
		position: absolute;
		top: 0.4rem;
		left: 50%;
		width: 0.2rem;
		height: 0.45rem;
		margin-left: -0.1rem;
		border-radius: 999px;
		background: var(--color-ink);
	}

	@media (prefers-reduced-motion: no-preference) {
		.featured-scroll-hint__wheel {
			animation: featured-scroll-wheel 1.6s ease-in-out infinite;
		}
	}

	@keyframes featured-scroll-wheel {
		0% {
			transform: translateY(0);
			opacity: 1;
		}
		60% {
			transform: translateY(0.45rem);
			opacity: 0;
		}
		100% {
			transform: translateY(0);
			opacity: 0;
		}
	}

	/*
	  Folder chrome — masked to SVG silhouette so tab cutouts stay correct.
	  Neutral beige stays fully opaque underneath; only the brand layer fades.
	  That way reactivation never punches a hole through to n-2.
	  No drop-shadow / box-shadow: masks + filters while transforming are costly.
	*/
	.featured__folder-neutral,
	.featured__folder-brand {
		-webkit-mask-image: var(--featured-folder-mask);
		mask-image: var(--featured-folder-mask);
		-webkit-mask-size: 100% 100%;
		mask-size: 100% 100%;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-position: center;
		mask-position: center;
	}

	.featured__folder-neutral {
		/* Covered / inactive fill — solid so stacked tabs read as paper, not brand tint */
		background: #f7f1ec;
	}

	.featured__folder-brand {
		background-image: linear-gradient(
			180.6deg,
			color-mix(in srgb, var(--featured-accent, #ddc3ae) 100%, #7a5c45) -9%,
			color-mix(in srgb, var(--featured-accent, #f3eae3) 49%, #ffffff) 74%
		);
		transition: opacity 0.45s ease;
	}

	.featured__tab-label {
		transition: color 0.45s ease;
	}

	/* Covered folders: brand fades out over always-opaque beige; muted tab ink */
	.featured__card[data-inactive='true'] .featured__folder-brand {
		opacity: 0;
	}

	.featured__card[data-inactive='true'] .featured__tab-label {
		color: #7a5c45;
	}

	@media (prefers-reduced-motion: reduce) {
		.featured__folder-brand,
		.featured__tab-label {
			transition: none;
		}
	}
</style>

<script>
	import { initFeaturedScroll } from '../../scripts/featured-scroll';
	import { initMagneticTypeAll } from '../../scripts/magnetic-type';

	initFeaturedScroll();
	initMagneticTypeAll();
</script>
