---
/**
 * Home clients strip — infinite logo marquee on surface-warm, white cards.
 */
import { clientLogos } from '../../data/clients';

const itemClass =
	'clients__item flex h-[4.75rem] w-[7.5rem] shrink-0 items-center justify-center rounded-xl border border-outline/30 bg-white p-4 md:h-24 md:w-36 md:p-5 2xl:h-28 2xl:w-44 2xl:rounded-2xl';
---

<section
	class="bg-surface-warm py-16 md:py-24 2xl:py-32"
	aria-labelledby="clients-heading"
	data-clients
>
	<div class="page-shell">
		<h2 id="clients-heading" class="type-h5 text-center text-ink uppercase">
			Clients
		</h2>
	</div>

	<div
		class="clients-marquee mt-10 overflow-hidden md:mt-12 2xl:mt-16"
		data-clients-marquee
	>
		<div class="clients-marquee__track">
			<ul class="clients-marquee__list m-0 flex list-none items-center p-0">
				{
					clientLogos.map((logo) => (
						<li class={itemClass}>
							<img
								src={logo.src}
								alt={logo.alt}
								class="max-h-full max-w-full object-contain"
								loading="lazy"
								decoding="async"
							/>
						</li>
					))
				}
			</ul>
			<ul
				class="clients-marquee__list clients-marquee__clone m-0 flex list-none items-center p-0"
				aria-hidden="true"
			>
				{
					clientLogos.map((logo) => (
						<li class={itemClass}>
							<img
								src={logo.src}
								alt=""
								class="max-h-full max-w-full object-contain"
								loading="lazy"
								decoding="async"
							/>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.clients-marquee {
		mask-image: linear-gradient(
			to right,
			transparent,
			#000 5%,
			#000 95%,
			transparent
		);
	}

	.clients-marquee__track {
		display: flex;
		width: max-content;
	}

	.clients-marquee__list {
		gap: 0.75rem;
		padding-inline: 0.375rem;
	}

	@media (min-width: 768px) {
		.clients-marquee__list {
			gap: 1rem;
			padding-inline: 0.5rem;
		}
	}

	@media (min-width: 1536px) {
		.clients-marquee__list {
			gap: 1.25rem;
			padding-inline: 0.625rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.clients-marquee__track {
			animation: clients-marquee 48s linear infinite;
		}

		.clients-marquee:hover .clients-marquee__track {
			animation-play-state: paused;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.clients-marquee {
			mask-image: none;
		}

		.clients-marquee__track {
			width: 100%;
			flex-wrap: wrap;
			justify-content: center;
		}

		.clients-marquee__list {
			flex-wrap: wrap;
			justify-content: center;
			row-gap: 0.75rem;
		}

		.clients-marquee__clone {
			display: none;
		}
	}

	@keyframes clients-marquee {
		from {
			transform: translateX(0);
		}

		to {
			transform: translateX(-50%);
		}
	}
</style>
