---
/**
 * About me + what shapes my work — panel between Hero and Featured.
 * Portrait, torn paper, and quote are one asset.
 */
import OptimizedImage from "../OptimizedImage.astro";

interface Pillar {
	readonly title: string;
	readonly body: string;
	readonly bg: string;
	readonly titleColor: string;
	readonly bodyColor: string;
	readonly rotate: number;
	readonly clipRotate: number;
}

const aboutQuote =
	"I believe in creating thoughtful visual systems through research, strategy, typography and storytelling.";

const pillars: readonly Pillar[] = [
	{
		title: "Observe",
		body: "Notice people, places and systems with curiosity.",
		bg: "#b5a45c",
		titleColor: "#4a3a06",
		bodyColor: "#f7e5ae",
		rotate: -1,
		clipRotate: 0,
	},
	{
		title: "Absorb",
		body: "Learn through conversations, books, critique and collaboration.",
		bg: "#c76e3a",
		titleColor: "#7c340a",
		bodyColor: "#ffddca",
		rotate: 1,
		clipRotate: 1,
	},
	{
		title: "Collect",
		body: "Gather stories, objects and visual ephemera that spark future ideas.",
		bg: "#b0beca",
		titleColor: "#3b576e",
		bodyColor: "#40688b",
		rotate: 0,
		clipRotate: 0,
	},
	{
		title: "Translate",
		body: "Turn insights into visual systems that people can understand and use.",
		bg: "#7e846e",
		titleColor: "#2e3716",
		bodyColor: "#dee0d6",
		rotate: -1,
		clipRotate: -1,
	},
];
---

<section
	class="about-me relative mt-12 min-h-dvh overflow-x-clip bg-[#E5D8CE]"
	aria-label="About me"
	data-about-me
>
	<div
		class="page-shell flex min-h-dvh flex-col items-center justify-center gap-8 py-16 md:py-24 md:gap-10 2xl:py-32 2xl:gap-14"
	>
		<div class="w-full">
			<h2 class="type-eyebrow text-center text-footer-ink">About me</h2>

			<figure class="mx-auto mt-6 w-full max-w-[55.1875rem]">
				<OptimizedImage
					src="/images/home/torn-page-with-badge-and-text.png"
					alt="Illustrated portrait of Ashima holding a cat, on a torn paper strip"
					class="h-auto w-full"
					widths={[640, 883]}
					sizes="(min-width: 883px) 883px, 100vw"
					decoding="async"
				/>
				<blockquote class="sr-only">
					<p>{aboutQuote}</p>
				</blockquote>
			</figure>
		</div>

		<div class="w-full">
			<h2 class="type-eyebrow text-center text-footer-ink">
				What shapes my work
			</h2>

			<ul
				class="mt-8 grid w-full list-none grid-cols-1 gap-x-6 gap-y-10 p-0 md:mt-10 md:grid-cols-2 lg:grid-cols-4 2xl:gap-x-8"
			>
				{
					pillars.map((pillar) => (
						<li
							class="about-me__pillar relative mx-auto w-full max-w-[17.625rem] pt-[2.65rem]"
							style={`transform: rotate(${pillar.rotate}deg)`}
						>
							<div
								class="about-me__clip pointer-events-none absolute -top-2 left-1/2 z-20 w-16 select-none drop-shadow-[0_4px_4px_rgb(0_0_0_/_0.33)] 2xl:w-20"
								style={`transform: translateX(-50%) rotate(${pillar.clipRotate}deg)`}
							>
								<OptimizedImage
									src="/images/home/binder-clip.png"
									alt=""
									aria-hidden="true"
									class="block h-auto w-full"
									decoding="async"
									widths={[96, 160, 240]}
									sizes="5.75rem"
								/>
							</div>
							<article
								class="flex min-h-44 flex-col items-center justify-center gap-3 px-5 py-6 text-center shadow-[0_4px_4px_rgb(0_0_0_/_0.25)]"
								style={`background: ${pillar.bg}`}
							>
								<h3
									class="type-note leading-none"
									style={`color: ${pillar.titleColor}`}
								>
									{pillar.title}
								</h3>
								<p
									class="type-body max-w-[16rem] font-display leading-snug"
									style={`color: ${pillar.bodyColor}`}
								>
									{pillar.body}
								</p>
							</article>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.about-me__clip {
		transform-origin: center bottom;
	}
</style>
