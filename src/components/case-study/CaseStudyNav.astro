---
/**
 * Case study footer carousel — always two projects; arrows rotate to the next pair.
 * Folders link to case studies; arrows only advance the carousel (circular).
 */
import { getImage } from 'astro:assets';
import ProjectFolder from '../ProjectFolder.astro';
import SectionHeading from '../SectionHeading.astro';
import { getCaseStudyById, type NamedWorkProject } from '../../data/case-studies';
import { tryGetAsset } from '../../lib/images';

interface Props {
	readonly projects: readonly NamedWorkProject[];
}

interface NavProject extends NamedWorkProject {
	readonly accentColor?: string;
	/** Browser-loadable URL for JS carousel swaps (Picture sources get stripped). */
	readonly carouselImageSrc: string;
}

const { projects } = Astro.props;

/**
 * Resolve a browser-loadable URL for client-side carousel swaps.
 * Raw `/images/...` paths are not in `public/` (assets live under src/assets).
 */
const resolveCarouselImageSrc = async (imageSrc: string): Promise<string> => {
	const asset = tryGetAsset(imageSrc);
	if (!asset) return imageSrc;
	if (asset.format === 'gif') return asset.src;
	const optimized = await getImage({
		src: asset,
		width: 960,
		format: 'webp',
	});
	return optimized.src;
};

const navProjects: readonly NavProject[] = await Promise.all(
	projects.map(async (project) => ({
		...project,
		accentColor: getCaseStudyById(project.id)?.folderColor,
		carouselImageSrc: await resolveCarouselImageSrc(project.imageSrc),
	})),
);

/** Start on the next two catalogue projects in order. */
const initialLeft = navProjects[0];
const initialRight = navProjects[1];
const canCarousel = navProjects.length >= 2 && initialLeft && initialRight;
const initialOffset = 0;

const arrowBtnClass =
	'inline-flex items-center justify-center border-0 bg-transparent p-0 text-heading no-underline transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:cursor-default disabled:opacity-40';
---

{
	canCarousel && (
		<nav
			class="case-study-nav mx-auto mt-20 w-full max-w-[90rem] gutter-x-md pb-16 md:mt-28 md:pb-24"
			aria-labelledby="case-study-nav-heading"
			data-case-study-nav
			data-nav-projects={JSON.stringify(navProjects)}
			data-nav-offset={String(initialOffset)}
		>
			<SectionHeading
				id="case-study-nav-heading"
				title="More projects"
				class="page-max"
			/>

			{/*
			  Desktop: 4 columns × 2 rows
			  Row 1 — arrow | folder | folder | arrow
			  Row 2 —       | copy   | copy   |
			  items-start so a taller description does not vertically
			  center the other column's eyebrow + title.
			*/}
			<div
				class="case-study-nav__stage mt-10 grid grid-cols-1 gap-y-6 overflow-x-clip md:mt-14 md:grid-cols-[2.75rem_minmax(0,1fr)_minmax(0,1fr)_2.75rem] md:items-start md:gap-x-8 md:gap-y-6 lg:gap-x-12 xl:gap-x-16"
			>
				<button
					type="button"
					class:list={[arrowBtnClass, 'justify-self-start md:col-start-1 md:row-start-1 md:self-center md:justify-self-center']}
					data-nav-dir="-1"
					aria-label="Show previous projects"
				>
					<span
						class="case-study-nav__arrow case-study-nav__arrow--prev"
						aria-hidden="true"
					></span>
				</button>

				{/* Left slot */}
				<div class="w-full md:col-start-2 md:row-start-1" data-nav-slot="0">
					<ProjectFolder
						number={initialLeft.number}
						imageSrc={initialLeft.imageSrc}
						imageAlt={initialLeft.imageAlt}
						linkLabel={initialLeft.title}
						href={initialLeft.href}
						accentColor={initialLeft.accentColor}
						showNumber={false}
						class="mx-auto max-w-none"
					/>
				</div>
				<div
					class="flex w-full flex-col items-center gap-3 text-center md:col-start-2 md:row-start-2"
					data-nav-copy="0"
				>
					<p
						class:list={[
							'type-eyebrow-sm w-full text-ink',
							!initialLeft.category && 'hidden',
						]}
						data-nav-category
					>
						{initialLeft.category}
					</p>
					<h3 class="type-h6 w-full uppercase text-heading text-balance" data-nav-title>
						{initialLeft.title}
					</h3>
					<p class="type-body w-full text-ink text-pretty" data-nav-description>
						{initialLeft.description}
					</p>
				</div>

				{/* Right slot */}
				<div class="w-full md:col-start-3 md:row-start-1" data-nav-slot="1">
					<ProjectFolder
						number={initialRight.number}
						imageSrc={initialRight.imageSrc}
						imageAlt={initialRight.imageAlt}
						linkLabel={initialRight.title}
						href={initialRight.href}
						accentColor={initialRight.accentColor}
						showNumber={false}
						class="mx-auto max-w-none"
					/>
				</div>
				<div
					class="flex w-full flex-col items-center gap-3 text-center md:col-start-3 md:row-start-2"
					data-nav-copy="1"
				>
					<p
						class:list={[
							'type-eyebrow-sm w-full text-ink',
							!initialRight.category && 'hidden',
						]}
						data-nav-category
					>
						{initialRight.category}
					</p>
					<h3 class="type-h6 w-full uppercase text-heading text-balance" data-nav-title>
						{initialRight.title}
					</h3>
					<p class="type-body w-full text-ink text-pretty" data-nav-description>
						{initialRight.description}
					</p>
				</div>

				<button
					type="button"
					class:list={[arrowBtnClass, 'justify-self-end md:col-start-4 md:row-start-1 md:self-center md:justify-self-center']}
					data-nav-dir="1"
					aria-label="Show next projects"
				>
					<span
						class="case-study-nav__arrow case-study-nav__arrow--next"
						aria-hidden="true"
					></span>
				</button>
			</div>
		</nav>
	)
}

<style>
	.case-study-nav__arrow {
		display: block;
		width: 2.75rem;
		height: 3rem;
		background-color: currentColor;
		-webkit-mask-size: contain;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-position: center;
		mask-position: center;
	}

	.case-study-nav__arrow--prev {
		-webkit-mask-image: url('/icons/arrow-left.svg');
		mask-image: url('/icons/arrow-left.svg');
		transform: rotate(180deg);
	}

	.case-study-nav__arrow--next {
		-webkit-mask-image: url('/icons/arrow-right.svg');
		mask-image: url('/icons/arrow-right.svg');
	}

	@media (width >= 64rem) {
		.case-study-nav__arrow {
			width: 3rem;
			height: 3.25rem;
		}
	}
</style>

<script>
	import { initCaseStudyNav } from '../../scripts/case-study-nav';

	initCaseStudyNav();
</script>
