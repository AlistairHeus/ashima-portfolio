---
/**
 * Mythila applications gallery — large active preview + four thumbnails.
 * Click / keyboard on a thumb swaps the left preview.
 */
import type { CaseStudyImage } from '../../data/case-studies';

interface Props {
	readonly images: readonly CaseStudyImage[];
}

const { images } = Astro.props;
const initial = images[0];
---

{
	images.length > 0 && initial && (
		<div
			class="mythila-apps"
			data-mythila-apps
			style="--mythila-apps-gap: clamp(0.35rem, 0.8vw, 0.6rem);"
		>
			<p class="type-label-md mb-3 text-ink/70 md:mb-4">
				Select a specimen to enlarge
			</p>

			<div
				class="grid grid-cols-1 gap-[var(--mythila-apps-gap)] md:grid-cols-[minmax(0,1fr)_minmax(6.5rem,18%)] md:grid-rows-4"
			>
				{/* Active preview — spans all thumbnail rows on desktop */}
				<div
					class="relative aspect-square overflow-hidden bg-[#e8e4de] md:row-span-4 md:aspect-auto md:min-h-0"
				>
					<img
						data-mythila-apps-preview
						src={initial.src}
						alt={initial.alt}
						class="absolute inset-0 size-full object-cover transition-opacity duration-200"
						width="1130"
						height="797"
						decoding="async"
					/>
				</div>

				{/* Thumbnails — row on mobile, column on desktop via md:contents */}
				<div
					class="grid grid-cols-4 gap-[var(--mythila-apps-gap)] md:contents"
					role="listbox"
					aria-label="Application specimens"
				>
					{images.map((image, index) => (
						<button
							type="button"
							role="option"
							aria-selected={index === 0 ? 'true' : 'false'}
							aria-label={`View specimen ${index + 1} of ${images.length}`}
							data-mythila-apps-thumb
							data-src={image.src}
							data-alt={image.alt}
							class="mythila-apps__thumb relative aspect-square overflow-hidden bg-[#e8e4de] p-0"
						>
							<img
								src={image.src}
								alt=""
								class="absolute inset-0 size-full object-cover"
								width="797"
								height="797"
								loading="lazy"
								decoding="async"
							/>
							<span class="mythila-apps__thumb-frame" aria-hidden="true" />
						</button>
					))}
				</div>
			</div>
		</div>
	)
}

<style>
	.mythila-apps__thumb {
		cursor: pointer;
		border: 0;
		outline-offset: 3px;
		isolation: isolate;
		transition:
			transform 160ms ease,
			filter 160ms ease;
	}

	.mythila-apps__thumb:focus-visible {
		outline: 2px solid var(--color-primary);
	}

	.mythila-apps__thumb img {
		transition: filter 160ms ease;
		filter: brightness(0.72) saturate(0.85);
	}

	.mythila-apps__thumb-frame {
		pointer-events: none;
		position: absolute;
		inset: 0;
		z-index: 1;
		box-shadow: inset 0 0 0 0 transparent;
		transition:
			box-shadow 160ms ease,
			background-color 160ms ease;
		background-color: rgb(0 0 0 / 0.12);
	}

	.mythila-apps__thumb:hover img {
		filter: brightness(0.88) saturate(0.95);
	}

	.mythila-apps__thumb:hover .mythila-apps__thumb-frame {
		background-color: rgb(0 0 0 / 0.04);
	}

	.mythila-apps__thumb:hover {
		transform: scale(1.02);
	}

	.mythila-apps__thumb[aria-selected='true'] {
		transform: none;
		z-index: 1;
	}

	.mythila-apps__thumb[aria-selected='true'] img {
		filter: none;
	}

	.mythila-apps__thumb[aria-selected='true'] .mythila-apps__thumb-frame {
		background-color: transparent;
		box-shadow:
			inset 0 0 0 2px #f7f1ec,
			inset 0 0 0 4px #1a1a1a;
	}
</style>

<script>
	const initMythilaApps = () => {
		const roots = document.querySelectorAll<HTMLElement>('[data-mythila-apps]');

		roots.forEach((root) => {
			if (root.dataset.ready === 'true') return;
			root.dataset.ready = 'true';

			const preview = root.querySelector<HTMLImageElement>('[data-mythila-apps-preview]');
			const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-mythila-apps-thumb]')];
			if (!preview || thumbs.length === 0) return;

			const activate = (thumb: HTMLButtonElement) => {
				const src = thumb.dataset.src;
				const alt = thumb.dataset.alt ?? '';
				if (!src || thumb.getAttribute('aria-selected') === 'true') return;

				preview.style.opacity = '0';
				window.setTimeout(() => {
					preview.src = src;
					preview.alt = alt;
					preview.style.opacity = '1';
				}, 120);

				thumbs.forEach((item) => {
					item.setAttribute('aria-selected', item === thumb ? 'true' : 'false');
				});
			};

			thumbs.forEach((thumb, index) => {
				thumb.addEventListener('click', () => activate(thumb));
				thumb.addEventListener('keydown', (event) => {
					if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') {
						return;
					}
					event.preventDefault();
					const delta =
						event.key === 'ArrowDown' || event.key === 'ArrowRight' ? 1 : -1;
					const next = thumbs[(index + delta + thumbs.length) % thumbs.length];
					next?.focus();
					if (next) activate(next);
				});
			});
		});
	};

	initMythilaApps();
	document.addEventListener('astro:page-load', initMythilaApps);
</script>
