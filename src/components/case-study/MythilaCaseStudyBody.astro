---
/**
 * Mythila Devanagari body — sketches, process, features, applications, purchase.
 * Landing (hero + intro) stays in CaseStudyLanding; prev/next in CaseStudyNav.
 */
import type { MythilaCaseStudyContent } from '../../data/case-studies';
import MythilaApplications from './MythilaApplications.astro';
import OptimizedImage from '../OptimizedImage.astro';

interface Props {
	readonly content: MythilaCaseStudyContent;
}

const { content } = Astro.props;
---

<div class="mythila-body">
	{/*
	  Tagline band tucks under the sketches/quote panels (Figma overlap):
	  panels stay above; full-bleed banner pulls up behind them.
	*/}
	<div class="relative">
		<section
			class="relative z-[1] page-shell mt-12 md:mt-16"
			aria-label="Letterform studies"
		>
			<div class="grid grid-cols-1 md:grid-cols-[minmax(0,0.4fr)_minmax(0,0.6fr)]">
				<figure class="m-0 overflow-hidden">
					<OptimizedImage
						src={content.sketches.src}
						alt={content.sketches.alt}
						class="h-auto w-full"
						width={481}
						height={740}
						loading="lazy"
						decoding="async"
						widths={[480, 640, 960]}
						sizes="(min-width: 768px) 50vw, 100vw"
					/>
				</figure>
				<figure class="m-0 overflow-hidden">
					<OptimizedImage
						src={content.quote.src}
						alt={content.quote.alt}
						class="h-auto w-full"
						width={714}
						height={740}
						loading="lazy"
						decoding="async"
						widths={[640, 960, 1280, 1600]}
						sizes="(min-width: 75rem) 75rem, 100vw"
					/>
				</figure>
			</div>
		</section>

		<section
			class="relative z-0 -mt-[clamp(2.75rem,7vw,5.5rem)] w-full"
			aria-label="Project tagline"
		>
			<figure class="m-0">
				<OptimizedImage
					src={content.tagline.src}
					alt={content.tagline.alt}
					class="h-auto w-full"
					width={1024}
					height={313}
					loading="lazy"
					decoding="async"
					widths={[640, 960, 1280, 1600]}
					sizes="100vw"
				/>
			</figure>
		</section>
	</div>

	{/* Process flowchart */}
	<section
		class="relative z-[1] pt-5 page-shell"
		aria-label="Process"
	>
		<figure class="m-0 overflow-hidden">
			<OptimizedImage
				src={content.process.src}
				alt={content.process.alt}
				class="h-auto w-full"
				width={1200}
				height={400}
				loading="lazy"
				decoding="async"
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 75rem) 75rem, 100vw"
			/>
		</figure>
	</section>

	{/* Process documentation photos */}
	<section
		class="page-shell mt-10 md:mt-14"
		aria-label="Making of"
	>
		<figure class="m-0 overflow-hidden">
			<OptimizedImage
				src={content.processPhotos.src}
				alt={content.processPhotos.alt}
				class="h-auto w-full"
				width={1222}
				height={434}
				loading="lazy"
				decoding="async"
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 75rem) 75rem, 100vw"
			/>
		</figure>

		<div class="mt-4 grid grid-cols-1 gap-4 md:mt-5 md:grid-cols-[minmax(0,0.37fr)_minmax(0,0.63fr)] md:gap-5">
			<figure class="m-0 overflow-hidden">
				<OptimizedImage
					src={content.glyphsApp.src}
					alt={content.glyphsApp.alt}
					class="h-auto w-full"
					width={458}
					height={378}
					loading="lazy"
					decoding="async"
				widths={[480, 640, 960]}
				sizes="(min-width: 768px) 50vw, 100vw"
			/>
			</figure>
			<figure class="m-0 overflow-hidden">
				<OptimizedImage
					src={content.workshop.src}
					alt={content.workshop.alt}
					class="h-auto w-full"
					width={797}
					height={424}
					loading="lazy"
					decoding="async"
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 75rem) 75rem, 100vw"
			/>
			</figure>
		</div>
	</section>

	{/*
	  Features sit above; applications.png tucks under their bottom edge and
	  carries the enlarge-specimen gallery (+ purchase) — bridging like Figma.
	*/}
	<div class="relative">
		<section
			class="page-shell relative z-[1] mt-16 md:mt-20"
			aria-label="Features of the font"
		>
			<figure class="m-0 overflow-hidden">
				<OptimizedImage
					src={content.features.src}
					alt={content.features.alt}
					class="h-auto w-full"
					width={1200}
					height={849}
					loading="lazy"
					decoding="async"
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 75rem) 75rem, 100vw"
			/>
			</figure>
		</section>

		<div
			class="relative -mt-[clamp(3.5rem,10vw,8rem)]"
		>
			{
				content.applicationsBgSrc && (
					<OptimizedImage
						src={content.applicationsBgSrc}
						alt=""
						aria-hidden="true"
						class="pointer-events-none absolute inset-0 z-0 h-full w-full select-none object-cover object-top opacity-20"
						width={1137}
						height={782}
						loading="lazy"
						decoding="async"
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 75rem) 75rem, 100vw"
			/>
				)
			}

			{/* Applications gallery */}
			<section
				class="relative z-[1] page-shell pt-[clamp(3.5rem,10vw,8rem)] md:pt-[clamp(4.5rem,12vw,10rem)]"
				aria-label="Type in use"
			>
				<MythilaApplications images={content.applications} />
			</section>
		</div>
	</div>

	{
		content.purchaseHref && (
			<section
				class="page-shell mt-12 flex justify-center pb-6 md:mt-16 md:pb-8"
				aria-label="Purchase license"
			>
				<a
					href={content.purchaseHref}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center bg-[#C76E3A] px-[clamp(1.75rem,4vw,3rem)] py-[clamp(0.85rem,1.8vw,1.15rem)] text-[clamp(0.8rem,1.4vw,1.05rem)] font-medium tracking-[0.06em] text-white no-underline uppercase shadow-[0_4px_14px_rgb(199_110_58/0.28)] outline-offset-4 transition-[transform,box-shadow,background-color] duration-200 hover:-translate-y-px hover:bg-[#552001] hover:shadow-[0_6px_18px_rgb(85_32_1/0.32)] focus-visible:outline-2 focus-visible:outline-[#C76E3A]"
				>
					Purchase license here
				</a>
			</section>
		)
	}
</div>
