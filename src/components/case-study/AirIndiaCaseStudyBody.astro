---
/**
 * Air India brand extension body — narrative after the shared landing.
 * Matches Figma Project 01 (307:1936).
 *
 * Composed panels carry dense visual systems (identity, heat-map, applications).
 * Research / opportunity / boarding reframe / quote / stats stay as HTML.
 */
import type { AirIndiaCaseStudyContent } from '../../data/case-studies';

interface Props {
	readonly content: AirIndiaCaseStudyContent;
}

const { content } = Astro.props;
const {
	brandIdentity,
	research,
	opportunity,
	reimagining,
	designingPurpose,
	boardingShowcase,
	quote,
	touchpointsIntro,
	collaterals,
	environmental,
	process,
} = content;

const inkDeep = '#1a001d';
const accent = '#825579';
const roseBand = '#ebc4cb';
const roseSoft = '#fcebee';
const roseStat = '#f3c4cb';
---

<div class="air-india-body">
	{/* Brand Identity + chakra — full-bleed composed panel */}
	<section class="mt-10 bg-white md:mt-14" aria-label="Brand identity">
		<figure class="m-0 w-full">
			<img
				src={brandIdentity.src}
				alt={brandIdentity.alt}
				class="block h-auto w-full"
				width="1920"
				height="901"
				loading="lazy"
				decoding="async"
			/>
		</figure>
	</section>

	{/* Research & Discovery */}
	<section
		class="bg-white"
		aria-labelledby="air-india-research-title"
	>
		<div
			class="mx-auto grid max-w-[75rem] grid-cols-1 items-start gap-8 px-[clamp(1rem,3vw,2rem)] py-[clamp(2.5rem,5vw,3.75rem)] md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:gap-10 lg:gap-12"
		>
			<div>
				<h2
					id="air-india-research-title"
					class="type-label-lg"
					style={`color: ${inkDeep}`}
				>
					{research.title}
				</h2>
				<p class="type-body mt-4 max-w-[30.5rem] text-ink">
					{research.body}
				</p>

				<h3
					class="type-label-lg mt-8 md:mt-10"
					style={`color: ${inkDeep}`}
				>
					{research.challengesTitle}
				</h3>
				<ul
					class="type-body mt-4 list-disc space-y-2.5 pl-[1.7rem] text-ink marker:text-ink"
				>
					{
						research.challenges.map((challenge) => (
							<li class="pl-1">{challenge}</li>
						))
					}
				</ul>
			</div>

			<figure class="m-0">
				<img
					src={research.diagram.src}
					alt={research.diagram.alt}
					class="block h-auto w-full"
					width="824"
					height="486"
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	{/* Opportunity Mapping */}
	<section
		class="mx-auto mt-12 max-w-[75rem] px-[clamp(1rem,3vw,2rem)] md:mt-16"
		aria-labelledby="air-india-opportunity-title"
	>
		<div
			class="grid grid-cols-1 items-start gap-10 md:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] md:gap-8 lg:gap-10"
		>
			<div class="md:pt-[clamp(4rem,8vw,8.5rem)]">
				<h2
					id="air-india-opportunity-title"
					class="type-label-lg"
					style={`color: ${inkDeep}`}
				>
					{opportunity.title}
				</h2>
				<p class="type-body mt-4 max-w-[24rem] text-ink">
					{opportunity.lead}
				</p>
				<ol
					class="mt-4 list-decimal space-y-0 pl-[1.9rem] font-display text-xl font-bold uppercase leading-normal"
					style={`color: #7f4386`}
				>
					{
						opportunity.objectives.map((objective) => (
							<li class="whitespace-nowrap pl-1">{objective}</li>
						))
					}
				</ol>
				<p class="type-body mt-5 max-w-[24rem] text-ink">
					{opportunity.framework}
				</p>
				<figure class="m-0 mt-8 max-w-[28rem] -rotate-2">
					<img
						src={opportunity.sticky.src}
						alt={opportunity.sticky.alt}
						class="block h-auto w-full"
						width="449"
						height="265"
						loading="lazy"
						decoding="async"
					/>
				</figure>
			</div>

			<figure class="m-0">
				<img
					src={opportunity.venn.src}
					alt={opportunity.venn.alt}
					class="block h-auto w-full"
					width="820"
					height="790"
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	{/* Reimagining the Boarding Pass — pink band; Maharaja sits on baked white banner */}
	<section
		class="relative mt-12 overflow-hidden md:mt-16"
		style={`background-color: ${roseBand}`}
		aria-labelledby="air-india-reimagining-title"
	>
		<div
			class="relative z-10 mx-auto max-w-[75rem] px-[clamp(1rem,3vw,2rem)] py-[clamp(2rem,4vw,3rem)] md:absolute md:inset-0 md:py-0 md:pt-[clamp(1.5rem,4vw,3rem)]"
		>
			<div
				class="grid grid-cols-1 gap-8 md:h-full md:grid-cols-[minmax(0,1.2fr)_minmax(16rem,22rem)] md:gap-8 lg:gap-12"
			>
				<h2
					id="air-india-reimagining-title"
					class="type-label-lg whitespace-nowrap mt-5"
					style={`color: ${inkDeep}`}
				>
					Reimagining
					<br />
					the Boarding Pass
				</h2>

				<ul class="m-0 flex list-none flex-col gap-7 p-0 md:pt-1 mt-5">
					{
						reimagining.painPoints.map((point) => (
							<li class="grid grid-cols-[4.3rem_1fr] gap-x-3">
								<img
									src={point.icon.src}
									alt=""
									class="size-[4.3rem] object-contain opacity-40"
									width="69"
									height="69"
									loading="lazy"
									decoding="async"
									aria-hidden="true"
								/>
								<div>
									<p
										class="font-label text-lg font-bold uppercase leading-[1.3]"
										style={`color: #7f4a51`}
									>
										{point.title}
									</p>
									<p class="mt-2.5 font-body text-[0.9375rem] leading-5 text-ink">
										{point.body.map((part) =>
											part.bold ? (
												<strong class="font-bold">{part.text}</strong>
											) : (
												part.text
											),
										)}
									</p>
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<figure class="m-0">
			<img
				src={reimagining.visual.src}
				alt={reimagining.visual.alt}
				class="block h-auto w-full"
				width="1919"
				height="740"
				loading="lazy"
				decoding="async"
			/>
		</figure>
	</section>

	{/* Designing with Purpose — title/body HTML; sticky + heatmap in visual */}
	<section class="bg-white" aria-labelledby="air-india-purpose-title">
		<div class="relative mx-auto max-w-[75rem] px-[clamp(1rem,3vw,2rem)] py-[clamp(2rem,4vw,3rem)]">
			<div
				class="mb-6 max-w-[30.375rem] md:absolute md:left-[clamp(1rem,3vw,2rem)] md:top-[clamp(3.5rem,6vw,5.5rem)] md:z-10 md:mb-0"
			>
				<h2
					id="air-india-purpose-title"
					class="type-label-lg"
					style={`color: ${inkDeep}`}
				>
					{designingPurpose.title}
				</h2>
				<p class="mt-4 font-body text-lg leading-[1.4375rem] text-ink">
					{
						designingPurpose.body.map((line, index) => (
							<>
								{index > 0 ? <br /> : null}
								{line}
							</>
						))
					}
				</p>
			</div>

			<figure class="m-0">
				<img
					src={designingPurpose.visual.src}
					alt={designingPurpose.visual.alt}
					class="block h-auto w-full"
					width="1183"
					height="817"
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	{/* Boarding showcase — top: stack + intro/reverse; bottom: hand + features */}
	<section
		class="overflow-x-clip"
		style={`background-color: ${roseSoft}`}
		aria-labelledby="air-india-boarding-title"
	>
		{/* Top half */}
		<div
			class="mx-auto grid max-w-[75rem] grid-cols-1 items-start gap-8 px-[clamp(1rem,3vw,2rem)] pt-[clamp(2rem,4vw,3rem)] md:grid-cols-2 md:items-stretch md:gap-10 lg:gap-12"
		>
			<figure class="m-0">
				<img
					src={boardingShowcase.stack.src}
					alt={boardingShowcase.stack.alt}
					class="block h-auto w-full"
					width="487"
					height="421"
					loading="lazy"
					decoding="async"
				/>
			</figure>

			<div class="flex flex-col gap-6 md:h-full md:justify-between md:gap-0 md:pt-2">
				<div>
					<p
						class="font-label text-xl font-normal uppercase tracking-[0.175rem]"
						style={`color: ${accent}`}
					>
						{boardingShowcase.eyebrow}
					</p>
					<h2
						id="air-india-boarding-title"
						class="mt-2 font-display text-[clamp(1.75rem,2.5vw,2rem)] font-bold uppercase leading-[1.0625]"
						style={`color: ${inkDeep}`}
					>
						{boardingShowcase.title}
					</h2>
					<p class="mt-3 max-w-[31rem] font-body text-lg font-normal leading-[1.4375rem] tracking-[-0.01125rem] text-ink">
						{boardingShowcase.lead}
					</p>
				</div>

				<figure class="m-0">
					<img
						src={boardingShowcase.reverse.src}
						alt={boardingShowcase.reverse.alt}
						class="block h-auto w-full rounded-[10px]"
						width="494"
						height="204"
						loading="lazy"
						decoding="async"
					/>
				</figure>
			</div>
		</div>

		{/* Bottom half — hand bleeds to viewport left; features stay in content column */}
		<div
			class="mx-auto max-w-[75rem] overflow-x-clip px-[clamp(1rem,3vw,2rem)] pt-10 pb-[clamp(2rem,4vw,3rem)] md:overflow-visible md:pt-12"
		>
			<div
				class="grid grid-cols-1 items-center gap-10 md:grid-cols-2 md:gap-10 lg:gap-12"
			>
				<figure
					class="m-0 max-md:-mx-[clamp(1rem,3vw,2rem)] md:-ml-[calc((100vw-min(100vw,75rem))/2+clamp(1rem,3vw,2rem))] md:w-[calc(100%+((100vw-min(100vw,75rem))/2)+clamp(1rem,3vw,2rem))] md:max-w-none"
				>
					<img
						src={boardingShowcase.hand.src}
						alt={boardingShowcase.hand.alt}
						class="block h-auto w-full"
						width="1050"
						height="591"
						loading="lazy"
						decoding="async"
					/>
				</figure>

				<div>
					<h3
						class="type-label-lg"
						style={`color: ${inkDeep}`}
					>
						{boardingShowcase.featuresTitle}
					</h3>
					<ul class="m-0 mt-6 flex list-none flex-col gap-7 p-0">
						{
							boardingShowcase.features.map((feature) => (
								<li>
									<p
										class="font-label text-xl font-bold capitalize leading-normal"
										style={`color: ${accent}`}
									>
										{feature.title}
									</p>
									<p
										class="mt-2 max-w-[29.375rem] font-body text-xl font-normal leading-7"
										style={`color: ${inkDeep}`}
									>
										{feature.body.map((part) =>
											part.bold ? (
												<strong class="font-semibold">{part.text}</strong>
											) : (
												part.text
											),
										)}
									</p>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</section>

	{/* CEO quote */}
	<section
		class="bg-white"
		aria-labelledby="air-india-quote-attribution"
	>
		<div
			class="mx-auto flex max-w-[75rem] flex-col items-center gap-8 px-[clamp(1rem,3vw,2rem)] py-[clamp(2.5rem,5vw,4rem)] md:flex-row md:items-center md:justify-start md:gap-10 lg:gap-14"
		>
			<div class="flex shrink-0 flex-col items-center text-center">
				<img
					src={quote.photo.src}
					alt={quote.photo.alt}
					class="size-[6.9rem] rounded-full border border-[#d0afd5] object-cover"
					width="111"
					height="111"
					loading="lazy"
					decoding="async"
				/>
				<p
					id="air-india-quote-attribution"
					class="mt-3 font-label text-lg font-bold leading-[1.3] text-ink"
				>
					{quote.name}
				</p>
				<p class="font-label text-[0.9375rem] leading-[1.3] text-ink">
					{quote.role}
				</p>
			</div>

			<blockquote class="m-0 flex max-w-[45rem] items-start gap-4 md:gap-6">
				<img
					src={quote.markSrc}
					alt=""
					class="mt-1 w-[5.5rem] shrink-0 opacity-40 md:w-[8.6rem]"
					width="138"
					height="129"
					loading="lazy"
					decoding="async"
					aria-hidden="true"
				/>
				<p class="font-body text-2xl leading-normal tracking-[0.01em] text-ink">
					{quote.text}
				</p>
			</blockquote>
		</div>
	</section>

	{/* Touchpoints intro + stats */}
	<section
		class="mx-auto max-w-[75rem] "
		aria-labelledby="air-india-touchpoints-title"
	>
		<div class="grid grid-cols-1 md:grid-cols-2">
			<div class="bg-canvas py-10 md:px-10 md:py-12">
				<h2
					id="air-india-touchpoints-title"
					class="type-label-lg max-w-[20rem]"
					style={`color: ${inkDeep}`}
				>
					{touchpointsIntro.title}
				</h2>
				<p class="mt-5 max-w-[30rem] font-body text-xl leading-7" style={`color: ${inkDeep}`}>
					{
						touchpointsIntro.body.map((part) =>
							part.bold ? (
								<strong class="font-bold">{part.text}</strong>
							) : (
								part.text
							),
						)
					}
				</p>
			</div>
			<div
				class="flex flex-col items-center justify-center px-8 py-10 text-center md:px-10 md:py-12"
				style={`background-color: ${roseStat}`}
			>
				<p
					class="font-display text-[clamp(2rem,4vw,2.5rem)] font-bold uppercase leading-[1.15]"
					style={`color: #6e000e`}
				>
					{touchpointsIntro.stat}
				</p>
				<p class="mt-3 max-w-[24rem] font-body text-xl leading-7" style={`color: ${inkDeep}`}>
					{
						touchpointsIntro.statBody.map((part) =>
							part.bold ? (
								<strong class="font-bold">{part.text}</strong>
							) : (
								part.text
							),
						)
					}
				</p>
			</div>
		</div>
	</section>

	{/* Collaterals — tags, stickers, e-ticket, lounge */}
	<section
		class="mx-auto"
		aria-label="Passenger collaterals"
	>
		<figure class="m-0">
			<img
				src={collaterals.src}
				alt={collaterals.alt}
				class="block h-auto w-full"
				width="1920"
				height="2008"
				loading="lazy"
				decoding="async"
			/>
		</figure>
	</section>

	{/* Environmental graphics */}
	<section
		class=""
		aria-label="Environmental graphics"
	>
		<figure class="m-0">
			<img
				src={environmental.src}
				alt={environmental.alt}
				class="block h-auto w-full"
				width="1920"
				height="2475"
				loading="lazy"
				decoding="async"
			/>
		</figure>
	</section>

	{/* Overall process */}
	<section
		class="mx-auto mt-12 max-w-[75rem] pb-4 md:mt-16"
		aria-labelledby="air-india-process-title"
	>
		<figure class="m-0 mt-4">
			<img
				src={process.diagram.src}
				alt={process.diagram.alt}
				class="block h-auto w-full"
				width="1275"
				height="440"
				loading="lazy"
				decoding="async"
			/>
		</figure>
	</section>
</div>
