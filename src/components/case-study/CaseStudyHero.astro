---
/**
 * Case study header chrome — shared by every case study page.
 *
 * Structure (Figma Project 07 / reusable landing):
 * 1. Full-bleed band behind page-top inset + Navbar + title stack
 * 2. Hero image whose vertical midpoint is the band → canvas break
 *
 * Layout navbar must be off (`showNavbar={false}`) when `overlayNavbar` is true.
 */
import Navbar from '../Navbar.astro';

interface Props {
	readonly number: string;
	readonly category: string;
	readonly title: string;
	readonly client: string;
	readonly imageSrc: string;
	readonly imageAlt: string;
	/**
	 * Landing band color. Per-project accent (e.g. taupe, lavender).
	 * @default '#e2e0d9'
	 */
	readonly bandColor?: string;
	/**
	 * Where the band yields to canvas, as % of hero image height.
	 * Figma mid-image break ≈ 50–60.
	 * @default 50
	 */
	readonly bandBreakPercent?: number;
	readonly currentPath?: string;
	readonly overlayNavbar?: boolean;
}

const {
	number,
	category,
	title,
	client,
	imageSrc,
	imageAlt,
	bandColor = '#e2e0d9',
	bandBreakPercent = 50,
	currentPath = '/work',
	overlayNavbar = true,
} = Astro.props;

const breakPercent = Math.min(100, Math.max(0, bandBreakPercent));
---

<header
	class="case-study-hero relative -mt-[var(--spacing-page-top)]"
	aria-labelledby="case-study-title"
	style={`--case-study-band: ${bandColor}; --case-study-band-break: ${breakPercent}%;`}
>
	{/* Band: page inset + navbar + title stack + gap above image */}
	<div class="case-study-hero__band bg-[var(--case-study-band)] pt-[var(--spacing-page-top)]">
		{overlayNavbar && <Navbar currentPath={currentPath} />}

		<div
			class="mx-auto max-w-[75rem] px-[clamp(1rem,3vw,2rem)] pt-[clamp(2.5rem,6vw,5.5rem)] pb-[clamp(2.5rem,5vw,5.25rem)] text-center"
		>
			<p
				class="case-study-hero__number font-label text-[clamp(2.5rem,5vw,4rem)] font-light leading-none text-ink"
				aria-hidden="true"
			>
				{number}
			</p>

			<p class="type-label-lg mt-5 font-light text-ink md:mt-6">{category}</p>

			<h1
				id="case-study-title"
				class="type-h1 mx-auto mt-3 max-w-[65rem] uppercase text-ink md:mt-4"
			>
				{title}
			</h1>

			<p class="type-label-lg mt-3 font-normal text-ink md:mt-4">{client}</p>
		</div>
	</div>

	{/*
	  Media block height === image height, so the gradient break lands
	  exactly at bandBreakPercent of the hero image — no margin collapse.
	*/}
	<div
		class="case-study-hero__media"
		style={`background: linear-gradient(
			to bottom,
			var(--case-study-band) 0%,
			var(--case-study-band) var(--case-study-band-break),
			var(--color-canvas) var(--case-study-band-break),
			var(--color-canvas) 100%
		)`}
	>
		<figure class="mx-auto m-0 max-w-[75rem] px-[clamp(1rem,3vw,2rem)]">
			<img
				src={imageSrc}
				alt={imageAlt}
				class="mx-auto block h-auto w-full"
				width="1200"
				height="420"
				fetchpriority="high"
				decoding="async"
			/>
		</figure>
	</div>
</header>
