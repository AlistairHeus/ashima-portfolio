---
/**
 * Case study header chrome — shared by every case study page.
 *
 * Structure (CSS grid):
 *  Row 1 — navbar + title stack
 *  Row 2 — top of hero image (band color + watermark), height = bandBreakPercent
 *  Row 3 — bottom of hero image (canvas), height = remainder
 *
 * Watermark lives in an atmosphere layer spanning rows 1–2 and is
 * bottom-aligned to the band→canvas break (halfway mark of the image).
 * Title row stays empty band color near the navbar.
 *
 * Layout navbar must be on when `overlayNavbar` is false (default for
 * case studies — keeps nav in the root stacking context above page content).
 * Set `overlayNavbar` only for rare standalone surfaces without Layout nav.
 */
import Navbar from '../Navbar.astro';
import MagneticChars from '../MagneticChars.astro';
import type { CaseStudyHeroLayer } from '../../data/case-studies';
import OptimizedImage from '../OptimizedImage.astro';
import type { WorkProject } from '../../data/work';

interface Props {
	readonly number: string;
	readonly category: string;
	readonly title: string;
	readonly client: string;
	readonly imageSrc: string;
	readonly imageAlt: string;
	readonly bandColor?: string;
	readonly bandBreakPercent?: number;
	readonly watermarkSrc?: string;
	readonly heroBackdrop?: string;
	readonly heroLayers?: readonly CaseStudyHeroLayer[];
	readonly currentPath?: string;
	readonly overlayNavbar?: boolean;
	/** Circular previous / next published case studies for hero arrows. */
	readonly adjacent?: {
		readonly previous: WorkProject;
		readonly next: WorkProject;
	} | null;
}

const {
	number,
	category,
	title,
	client,
	imageSrc,
	imageAlt,
	bandColor = '#efe8e0',
	bandBreakPercent = 50,
	watermarkSrc,
	heroBackdrop,
	heroLayers,
	currentPath = '/work',
	overlayNavbar = false,
	adjacent = null,
} = Astro.props;

const arrowLinkClass =
	'case-study-hero__adjacent-link inline-flex items-center justify-center border-0 bg-transparent p-0 text-heading no-underline transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';

const breakPercent = Math.min(100, Math.max(0, bandBreakPercent));
const remainPercent = 100 - breakPercent;
const useLayers = Boolean(heroLayers && heroLayers.length > 0);
---

<header
	class="case-study-hero relative -mt-[var(--spacing-page-chrome)] grid grid-cols-1 overflow-hidden bg-[var(--case-study-band)]"
	aria-labelledby="case-study-title"
	style={`--case-study-band: ${bandColor}; --case-study-band-break: ${breakPercent}%; grid-template-rows: auto minmax(0, ${breakPercent}fr) minmax(0, ${remainPercent}fr);`}
>
	{/*
	  Atmosphere: title row + top slice of the hero image.
	  Watermark is full-bleed and scales with viewport width; its focal
	  point (Mythila circle ≈ 25.5% from image top) is pinned to the
	  project number so MacBook and wide monitors stay aligned.
	*/}
	<div
		class="pointer-events-none relative col-start-1 row-start-1 row-end-3 z-0 overflow-hidden"
		aria-hidden="true"
	>
		{
			watermarkSrc && (
				<div class="case-study-hero__watermark absolute left-1/2 w-full max-w-none">
					<OptimizedImage
						src={watermarkSrc}
						alt=""
						aria-hidden="true"
						class="h-auto w-full max-w-none select-none opacity-90"
						widths={[640, 960, 1280, 1600, 1920]}
						sizes="100vw"
						decoding="async"
					/>
				</div>
			)
		}
	</div>

	{/* Canvas fill for the lower slice of the hero image */}
	<div
		class="pointer-events-none col-start-1 row-start-3 z-0 bg-[var(--color-canvas)]"
		aria-hidden="true"
	>
	</div>

	{/* Titles — transparent over the atmosphere; pad for fixed nav chrome */}
	<div class="case-study-hero__band relative z-[1] col-start-1 row-start-1 pt-[var(--spacing-page-chrome)]">
		{overlayNavbar && <Navbar currentPath={currentPath} />}

		<div
			class="page-shell relative pt-[clamp(2.5rem,6vw,5.5rem)] pb-[clamp(2.5rem,5vw,5.25rem)] text-center"
		>
			{
				adjacent && (
					<nav
						class="case-study-hero__adjacent pointer-events-none absolute inset-x-0 top-1/2 z-[2] flex -translate-y-1/2 items-center justify-between"
						aria-label="Adjacent case studies"
					>
						<a
							href={adjacent.previous.href}
							class:list={[arrowLinkClass, 'pointer-events-auto']}
							aria-label={`Previous project: ${adjacent.previous.title}`}
						>
							<span
								class="case-study-hero__arrow case-study-hero__arrow--prev"
								aria-hidden="true"
							></span>
						</a>
						<a
							href={adjacent.next.href}
							class:list={[arrowLinkClass, 'pointer-events-auto']}
							aria-label={`Next project: ${adjacent.next.title}`}
						>
							<span
								class="case-study-hero__arrow case-study-hero__arrow--next"
								aria-hidden="true"
							></span>
						</a>
					</nav>
				)
			}

			<div class:list={[adjacent && 'px-[clamp(2.5rem,7vw,4rem)]']}>
				<p
					class="case-study-hero__number font-label text-[clamp(2.5rem,5vw,4rem)] font-light leading-none text-ink"
					aria-hidden="true"
					data-cs-intro="number"
				>
					{number}
				</p>

				<p
					class="type-label-lg mt-5 font-light text-ink md:mt-6"
					data-cs-intro="category"
				>
					{category}
				</p>

				<h1
					id="case-study-title"
					class="type-h3 mx-auto mt-3 max-w-[65rem] cursor-default uppercase text-ink md:mt-4"
					data-magnetic-root
					data-magnetic-invert
					data-magnetic-rest="400"
					style="--magnetic-rest: 400"
				>
					<MagneticChars text={title} />
				</h1>

				{client ? (
					<p
						class="type-label-lg mt-3 font-normal text-ink md:mt-4"
						data-cs-intro="client"
					>
						{client}
					</p>
				) : null}
			</div>
		</div>
	</div>

	{/* Hero media spans the band-break split (rows 2–3) */}
	<div
		class="case-study-hero__media relative z-[1] col-start-1 row-start-2 row-end-4"
		data-cs-intro="media"
	>
		<figure class="page-shell relative m-0">
			{
				useLayers ? (
					<div
						class="relative aspect-[1200/420] w-full overflow-hidden"
						style={heroBackdrop ? `background-color: ${heroBackdrop}` : undefined}
						role="img"
						aria-label={imageAlt}
					>
						{heroLayers!.map((layer) => (
							<OptimizedImage
								src={layer.src}
								alt={layer.alt}
								class={layer.className}
								loading="eager"
								decoding="async"
								fetchpriority="high"
								widths={[640, 960, 1280, 1600]}
								sizes="(min-width: 75rem) 75rem, 100vw"
							/>
						))}
					</div>
				) : (
					<OptimizedImage
						src={imageSrc}
						alt={imageAlt}
						class="mx-auto block aspect-[1200/420] h-auto w-full object-cover object-center"
						width={1200}
						height={420}
						loading="eager"
						fetchpriority="high"
						decoding="async"
						widths={[640, 960, 1280, 1600]}
						sizes="(min-width: 75rem) 75rem, 100vw"
					/>
				)
			}
		</figure>
	</div>
</header>

<style>
	/*
	  Pin watermark focal point to the project number.
	  top = chrome + title stack padding + half number height
	  translateY = −circle center in the asset (~25.5% of 707px)
	*/
	.case-study-hero__watermark {
		top: calc(
			var(--spacing-page-chrome) + clamp(2.5rem, 6vw, 5.5rem) +
				clamp(1.25rem, 2.5vw, 2rem)
		);
		transform: translate(-50%, -25.5%);
	}

	.case-study-hero__arrow {
		display: block;
		width: 2rem;
		height: 2.25rem;
		background-color: currentColor;
		-webkit-mask-size: contain;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-position: center;
		mask-position: center;
	}

	.case-study-hero__arrow--prev {
		-webkit-mask-image: url('/icons/arrow-left.svg');
		mask-image: url('/icons/arrow-left.svg');
		transform: rotate(180deg);
	}

	.case-study-hero__arrow--next {
		-webkit-mask-image: url('/icons/arrow-right.svg');
		mask-image: url('/icons/arrow-right.svg');
	}

	@media (width >= 48rem) {
		.case-study-hero__arrow {
			width: 2.5rem;
			height: 2.75rem;
		}
	}

	@media (width >= 64rem) {
		.case-study-hero__arrow {
			width: 2.75rem;
			height: 3rem;
		}
	}
</style>
