---
/**
 * Full case study landing — the reusable top-of-page composition:
 * Title stack → hero image (band/canvas break) → intro.
 *
 * Navbar stays in Layout (topmost stacking context). Pass a different
 * `bandColor` per project.
 */
import CaseStudyHero from './CaseStudyHero.astro';
import CaseStudyIntro from './CaseStudyIntro.astro';
import type { CaseStudy, NamedWorkProject } from '../../data/case-studies';

interface Props {
	readonly study: CaseStudy;
	readonly number: string;
	readonly currentPath?: string;
	/** Circular previous / next published case studies for hero arrows. */
	readonly adjacent?: {
		readonly previous: NamedWorkProject;
		readonly next: NamedWorkProject;
	} | null;
}

const { study, number, currentPath = '/work', adjacent = null } = Astro.props;
---

<div class="case-study-landing" data-case-study-landing data-case-study-intro="pending">
	<CaseStudyHero
		number={number}
		category={study.category}
		title={study.title}
		client={study.client}
		imageSrc={study.hero.src}
		imageAlt={study.hero.alt}
		bandColor={study.heroBandColor}
		watermarkSrc={study.heroWatermarkSrc}
		heroBackdrop={study.heroBackdrop}
		heroLayers={study.heroLayers}
		currentPath={currentPath}
		overlayNavbar={false}
		adjacent={adjacent}
	/>

	<div data-cs-intro="overview">
		<CaseStudyIntro
			description={study.description}
			skills={study.skills}
			tools={study.tools}
		/>
	</div>
</div>

<style>
	/* Hide intro targets until GSAP runs. :global — children live in CaseStudyHero. */
	@media (prefers-reduced-motion: no-preference) {
		[data-case-study-landing][data-case-study-intro='pending'] :global([data-cs-intro]),
		[data-case-study-landing][data-case-study-intro='pending']
			:global(#case-study-title [data-magnetic-char]),
		[data-case-study-landing][data-case-study-intro='running'] :global([data-cs-intro]),
		[data-case-study-landing][data-case-study-intro='running']
			:global(#case-study-title [data-magnetic-char]) {
			opacity: 0;
		}
	}
</style>

<script is:inline>
	(() => {
		const root = document.querySelector('[data-case-study-landing]');
		if (!root) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			root.setAttribute('data-case-study-intro', 'done');
			return;
		}
		root.setAttribute('data-case-study-intro', 'pending');
	})();
</script>

<script>
	import { initCaseStudyIntro } from '../../scripts/case-study-intro';
	import { initMagneticTypeAll } from '../../scripts/magnetic-type';

	const boot = () => {
		initCaseStudyIntro(() => {
			initMagneticTypeAll();
		});
	};

	void Promise.all([document.fonts?.ready ?? Promise.resolve()]).then(boot);
</script>
