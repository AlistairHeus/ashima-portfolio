---
/**
 * Vivan Hospital body — branded application gallery matching Figma Project 08.
 *
 * Layout (content width 1200):
 * 1. Social phones (690) + poster (486)
 * 2. Print billboard (588) + ID cards (588)
 * 3. Brochure full-bleed panel
 * 4. Outdoor billboard full width
 * 5. Interior photos (690 + 486)
 */
import type { VivanCaseStudyContent } from '../../data/case-studies';
import OptimizedImage from '../OptimizedImage.astro';

interface Props {
	readonly content: VivanCaseStudyContent;
}

const { content } = Astro.props;

const gap = 'gap-[clamp(0.75rem,1.5vw,1.5rem)]';
---

<div class="vivan-body page-shell mt-12 md:mt-16">
	<section class={`grid grid-cols-1 ${gap} md:grid-cols-[minmax(0,1.42fr)_minmax(0,1fr)]`} aria-label="Social and poster">
		<figure class="m-0 overflow-hidden bg-white">
			<OptimizedImage
				src={content.socialPhones.src}
				alt={content.socialPhones.alt}
				class="block h-auto w-full"
				width={690}
				height={671}
				loading="lazy"
				decoding="async"
				widths={[480, 640, 960]}
				sizes="(min-width: 768px) 50vw, 100vw"
			/>
		</figure>
		<figure class="m-0 overflow-hidden bg-[#c2e2d7]">
			<OptimizedImage
				src={content.poster.src}
				alt={content.poster.alt}
				class="block h-auto w-full"
				width={486}
				height={671}
				loading="lazy"
				decoding="async"
				widths={[480, 640, 960]}
				sizes="(min-width: 768px) 50vw, 100vw"
			/>
		</figure>
	</section>

	<section class={`mt-[clamp(0.75rem,1.5vw,1.5rem)] grid grid-cols-1 ${gap} md:grid-cols-2`} aria-label="Print and ID">
		<figure class="m-0 overflow-hidden">
			<OptimizedImage
				src={content.billboardPrint.src}
				alt={content.billboardPrint.alt}
				class="block h-auto w-full"
				width={588}
				height={446}
				loading="lazy"
				decoding="async"
				widths={[480, 640, 960]}
				sizes="(min-width: 768px) 50vw, 100vw"
			/>
		</figure>
		<figure class="m-0 overflow-hidden bg-[#eadeed]">
			<OptimizedImage
				src={content.idCards.src}
				alt={content.idCards.alt}
				class="block h-auto w-full"
				width={588}
				height={446}
				loading="lazy"
				decoding="async"
				widths={[480, 640, 960]}
				sizes="(min-width: 768px) 50vw, 100vw"
			/>
		</figure>
	</section>

	<section class="mt-[clamp(0.75rem,1.5vw,1.5rem)]" aria-label="Brochure">
		<figure class="m-0 overflow-hidden bg-[#dae6e2]">
			<OptimizedImage
				src={content.brochure.src}
				alt={content.brochure.alt}
				class="block h-auto w-full"
				width={1200}
				height={766}
				loading="lazy"
				decoding="async"
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 75rem) 75rem, 100vw"
			/>
		</figure>
	</section>

	<section class="mt-[clamp(0.75rem,1.5vw,1.5rem)]" aria-label="Outdoor billboard">
		<figure class="m-0 overflow-hidden">
			<OptimizedImage
				src={content.billboardOutdoor.src}
				alt={content.billboardOutdoor.alt}
				class="block h-auto w-full"
				width={1200}
				height={526}
				loading="lazy"
				decoding="async"
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 75rem) 75rem, 100vw"
			/>
		</figure>
	</section>

	<section
		class={`mt-[clamp(0.75rem,1.5vw,1.5rem)] grid grid-cols-1 ${gap} md:grid-cols-[minmax(0,1.42fr)_minmax(0,1fr)]`}
		aria-label="Environmental graphics"
	>
		<figure class="m-0 overflow-hidden">
			<OptimizedImage
				src={content.interiorLeft.src}
				alt={content.interiorLeft.alt}
				class="block h-auto w-full"
				width={690}
				height={532}
				loading="lazy"
				decoding="async"
				widths={[480, 640, 960]}
				sizes="(min-width: 768px) 50vw, 100vw"
			/>
		</figure>
		<figure class="m-0 overflow-hidden">
			<OptimizedImage
				src={content.interiorRight.src}
				alt={content.interiorRight.alt}
				class="block h-auto w-full"
				width={486}
				height={532}
				loading="lazy"
				decoding="async"
				widths={[480, 640, 960]}
				sizes="(min-width: 768px) 50vw, 100vw"
			/>
		</figure>
	</section>
</div>
