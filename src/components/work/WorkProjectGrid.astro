---
/**
 * Responsive 2-column work project grid.
 * Single responsibility: lay out ProjectCards — no data ownership.
 */
import ProjectCard from '../ProjectCard.astro';
import type { NamedWorkProject } from '../../data/case-studies';

interface Props {
	readonly projects: readonly NamedWorkProject[];
	readonly class?: string;
}

const { projects, class: className } = Astro.props;
---

<ul
	class:list={[
		'm-0 grid list-none grid-cols-1 gap-x-8 gap-y-10 p-0 md:grid-cols-2 md:gap-x-10 md:gap-y-12 2xl:gap-x-16 2xl:gap-y-16',
		className,
	]}
>
	{
		projects.map((project) => (
			<li class="min-w-0" data-work-intro="card">
				<ProjectCard project={project} />
			</li>
		))
	}
</ul>
