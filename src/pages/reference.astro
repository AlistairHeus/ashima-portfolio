---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ProjectFolder from "../components/ProjectFolder.astro";
import Polaroid from "../components/Polaroid.astro";

const colors = [
    {
        name: "Canvas",
        token: "canvas",
        value: "#F7F1EC",
        className: "bg-canvas",
    },
    { name: "Ink", token: "ink", value: "#181818", className: "bg-ink" },
    {
        name: "Heading",
        token: "heading",
        value: "#4C4C4C",
        className: "bg-heading",
    },
    {
        name: "Primary",
        token: "primary",
        value: "#60728C",
        className: "bg-primary",
    },
    {
        name: "Primary soft",
        token: "primary-soft",
        value: "#AAD0F1",
        className: "bg-primary-soft",
    },
    { name: "Muted", token: "muted", value: "#636363", className: "bg-muted" },
    {
        name: "Outline",
        token: "outline",
        value: "#9BA1A5",
        className: "bg-outline",
    },
    {
        name: "On surface variant",
        token: "on-surface-variant",
        value: "#49454F",
        className: "bg-on-surface-variant",
    },
];

const typeStyles = [
    {
        element: "H1",
        className: "type-h1",
        sample: "Design with clarity and character.",
        details: "Amarna · Regular 400 · 56/65",
        usage: "Featured and project titles",
    },
    {
        element: "H2",
        className: "type-h2",
        sample: "Hello! I’m Ashima Kaushik",
        details: "Amarna · Regular 400 · 48/56 · −1.92 tracking",
        usage: "Home introduction",
    },
    {
        element: "H3",
        className: "type-h3",
        sample: "Case study section",
        details: "Amarna · Regular 400 · 40/48",
        usage: "Major section headings",
    },
    {
        element: "H4",
        className: "type-h4",
        sample: "What’s next?",
        details: "Amarna · Bold 700 · 36/44 · 6.48 tracking",
        usage: "Footer callout",
    },
    {
        element: "H5",
        className: "type-h5",
        sample: "Other projects",
        details: "Amarna · Regular 400 · 32/40",
        usage: "Section dividers",
    },
    {
        element: "H6",
        className: "type-h6",
        sample: "Maahi: Logo Design",
        details: "Amarna · Bold 700 · 28/34",
        usage: "Project card titles",
    },
];

const bodyStyles = [
    {
        name: "Body large",
        className: "type-body-lg",
        details: "Mukta · Regular 400 · 24/32",
        sample: "Used for prominent project descriptions and supporting statements.",
    },
    {
        name: "Body medium",
        className: "type-body-md",
        details: "Mukta · Regular 400 · 20/27",
        sample: "Used for contact details, introductions, and secondary copy.",
    },
    {
        name: "Body",
        className: "type-body",
        details: "Mukta · Regular 400 · 18/25",
        sample: "Used for case-study narratives, summaries, and project card descriptions.",
    },
];
---

<Layout
    title="Ashima Kaushik — Style Guide"
    description="The typography and color foundations for Ashima Kaushik's portfolio."
    currentPath="/"
>
    <main>
        <div class="mx-auto max-w-7xl px-6 py-16 md:px-12 lg:px-20">
            <section aria-labelledby="components-title" class="mb-24">
                <div class="mb-10 border-b border-outline/45 pb-5">
                    <p class="type-label-md mb-2 text-primary">
                        00 — Components
                    </p>
                    <h2 id="components-title" class="type-h3 text-footer-ink">
                        Site shell
                    </h2>
                </div>

                <p class="type-body mb-8 max-w-2xl text-muted">
                    Navbar and Footer are shared via Layout. Page-top inset is
                    <code class="text-ink">--spacing-page-top</code> (64px). Live
                    chrome is at the top and bottom of this page; demos below are
                    isolated.
                </p>

                <div class="space-y-6">
                    <article
                        class="overflow-hidden rounded-2xl border border-outline/45"
                    >
                        <p
                            class="type-chip border-b border-outline/45 px-5 py-3 text-muted"
                        >
                            Navbar — active “Work”
                        </p>
                        <div class="bg-canvas py-2">
                            <Navbar currentPath="/work" />
                        </div>
                    </article>

                    <article
                        class="overflow-hidden rounded-2xl border border-outline/45"
                    >
                        <p
                            class="type-chip border-b border-outline/45 px-5 py-3 text-muted"
                        >
                            Footer
                        </p>
                        <Footer />
                    </article>

                    <article
                        class="overflow-hidden rounded-2xl border border-outline/45"
                    >
                        <p
                            class="type-chip border-b border-outline/45 px-5 py-3 text-muted"
                        >
                            ProjectFolder — visual only (slot below is optional)
                        </p>
                        <div class="bg-canvas p-8">
                            <ProjectFolder
                                number="01"
                                imageSrc="/images/project-folder-demo.png"
                                imageAlt="Air India brand extension project thumbnail"
                                href="/work"
                            />
                        </div>
                    </article>

                    <article
                        class="overflow-hidden rounded-2xl border border-outline/45"
                    >
                        <p
                            class="type-chip border-b border-outline/45 px-5 py-3 text-muted"
                        >
                            Polaroid — classic / caption / sticker
                        </p>
                        <div
                            class="grid gap-10 bg-canvas p-8 sm:grid-cols-2 lg:grid-cols-3 lg:items-start"
                        >
                            <div>
                                <p class="type-chip mb-4 text-muted">
                                    classic · −2°
                                </p>
                                <Polaroid
                                    imageSrc="/images/polaroid-hero-demo.png"
                                    imageAlt="Portrait photo in a classic Polaroid frame"
                                    variant="classic"
                                    rotate={-2}
                                    aspectRatio="341 / 493"
                                />
                            </div>
                            <div>
                                <p class="type-chip mb-4 text-muted">
                                    caption · −2°
                                </p>
                                <Polaroid
                                    imageSrc="/images/polaroid-caption-demo.png"
                                    imageAlt="Workshop photo with handwritten caption"
                                    variant="caption"
                                    rotate={-2}
                                    caption="Co-creation & iterations with artists to improve letterforms"
                                    aspectRatio="412 / 300"
                                    class="max-w-[440px]"
                                />
                            </div>
                            <div>
                                <p class="type-chip mb-4 text-muted">
                                    sticker · +2°
                                </p>
                                <Polaroid
                                    imageSrc="/images/polaroid-logo-demo.png"
                                    imageAlt="IGL logo mark in a sticker Polaroid frame"
                                    variant="sticker"
                                    rotate={2}
                                    aspectRatio="424 / 332"
                                    class="max-w-[451px]"
                                />
                            </div>
                        </div>
                    </article>
                </div>
            </section>

            <section aria-labelledby="fonts-title" class="mb-24">
                <div class="mb-10 border-b border-outline/45 pb-5">
                    <p class="type-label-md mb-2 text-primary">
                        01 — Foundations
                    </p>
                    <h2 id="fonts-title" class="type-h3 text-footer-ink">
                        Font families
                    </h2>
                </div>

                <div
                    class="grid gap-px overflow-hidden rounded-2xl border border-outline/45 bg-outline/45 md:grid-cols-2"
                >
                    <article class="bg-canvas p-8">
                        <p class="type-chip mb-8 text-muted">
                            DISPLAY / AMARNA
                        </p>
                        <p
                            class="font-display text-5xl leading-tight text-heading"
                        >
                            Ashima Kaushik
                        </p>
                        <p class="type-body mt-5 text-muted">
                            Light, regular, and bold weights
                        </p>
                    </article>
                    <article class="bg-canvas p-8">
                        <p class="type-chip mb-8 text-muted">BODY / MUKTA</p>
                        <p
                            class="font-body text-5xl leading-tight text-heading"
                        >
                            Thoughtful stories
                        </p>
                        <p class="type-body mt-5 text-muted">
                            Regular, medium, and bold weights
                        </p>
                    </article>
                    <article class="bg-canvas p-8">
                        <p class="type-chip mb-8 text-muted">LABEL / LATO</p>
                        <p
                            class="font-label text-4xl font-bold tracking-[0.16em] text-heading uppercase"
                        >
                            Case studies
                        </p>
                        <p class="type-body mt-5 text-muted">
                            Light, regular, and bold weights
                        </p>
                    </article>
                    <article class="bg-canvas p-8">
                        <p class="type-chip mb-8 text-muted">
                            ACCENT / BETANIA PATMOS
                        </p>
                        <p
                            class="font-hand text-5xl leading-tight text-primary"
                        >
                            Specialised in
                        </p>
                        <p class="type-body mt-5 text-muted">
                            Used sparingly for handwritten accents
                        </p>
                    </article>
                </div>
            </section>

            <section aria-labelledby="hierarchy-title" class="mb-24">
                <div class="mb-10 border-b border-outline/45 pb-5">
                    <p class="type-label-md mb-2 text-primary">
                        02 — Typography
                    </p>
                    <h2 id="hierarchy-title" class="type-h3 text-footer-ink">
                        Heading hierarchy
                    </h2>
                </div>

                <div
                    class="divide-y divide-outline/45 border-y border-outline/45"
                >
                    {
                        typeStyles.map((style) => (
                            <article class="grid gap-6 py-9 lg:grid-cols-[7rem_1fr_18rem] lg:items-center">
                                <div>
                                    <p class="type-label-md text-primary">
                                        {style.element}
                                    </p>
                                    <p class="type-chip mt-2 text-muted">
                                        .{style.className}
                                    </p>
                                </div>
                                <p
                                    class:list={[
                                        style.className,
                                        "text-heading",
                                    ]}
                                >
                                    {style.sample}
                                </p>
                                <div>
                                    <p class="type-body text-ink">
                                        {style.details}
                                    </p>
                                    <p class="type-chip mt-2 text-muted">
                                        {style.usage}
                                    </p>
                                </div>
                            </article>
                        ))
                    }
                </div>
            </section>

            <section aria-labelledby="body-title" class="mb-24">
                <div class="mb-10 border-b border-outline/45 pb-5">
                    <p class="type-label-md mb-2 text-primary">
                        03 — Typography
                    </p>
                    <h2 id="body-title" class="type-h3 text-footer-ink">
                        Body and labels
                    </h2>
                </div>

                <div class="grid gap-6 lg:grid-cols-3">
                    {
                        bodyStyles.map((style) => (
                            <article class="rounded-2xl border border-outline/45 p-7">
                                <p class="type-label-md text-primary">
                                    {style.name}
                                </p>
                                <p class="type-chip mt-2 text-muted">
                                    {style.details}
                                </p>
                                <p
                                    class:list={[
                                        style.className,
                                        "mt-8 text-ink",
                                    ]}
                                >
                                    {style.sample}
                                </p>
                            </article>
                        ))
                    }
                </div>

                <div class="mt-6 grid gap-6 lg:grid-cols-3">
                    <article class="rounded-2xl border border-outline/45 p-7">
                        <p class="type-label-lg text-footer-ink">Book design</p>
                        <p class="type-chip mt-5 text-muted">
                            Lato · Bold 700 · 24/32 · 4.32 tracking
                        </p>
                    </article>
                    <article class="rounded-2xl border border-outline/45 p-7">
                        <p class="type-label-md text-primary">
                            Skills &amp; tools
                        </p>
                        <p class="type-chip mt-5 text-muted">
                            Lato · Bold 700 · 16/24 · 2.56 tracking
                        </p>
                    </article>
                    <article class="rounded-2xl border border-outline/45 p-7">
                        <span
                            class="type-chip inline-flex rounded-lg border border-outline px-4 py-1.5 text-on-surface-variant"
                        >
                            Brand systems
                        </span>
                        <p class="type-chip mt-5 text-muted">
                            Mukta · Medium 500 · 12/20 · 0.1 tracking
                        </p>
                    </article>
                </div>
            </section>

            <section aria-labelledby="color-title">
                <div class="mb-10 border-b border-outline/45 pb-5">
                    <p class="type-label-md mb-2 text-primary">
                        04 — Foundations
                    </p>
                    <h2 id="color-title" class="type-h3 text-footer-ink">
                        Core colors
                    </h2>
                </div>

                <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                    {
                        colors.map((color) => (
                            <article class="overflow-hidden rounded-2xl border border-outline/45">
                                <div class:list={[color.className, "h-32"]} />
                                <div class="p-5">
                                    <p class="type-body text-ink">
                                        {color.name}
                                    </p>
                                    <p class="type-chip mt-1 text-muted">
                                        --color-{color.token}
                                    </p>
                                    <p class="type-chip mt-4 text-muted">
                                        {color.value}
                                    </p>
                                </div>
                            </article>
                        ))
                    }
                </div>
            </section>
        </div>
    </main>
</Layout>
