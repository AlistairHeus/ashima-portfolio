---
/**
 * Work page — Figma Work Page_Final (149:558).
 * Assembles shared Layout / Navbar / Footer with reusable work components.
 */
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkProjectGrid from '../components/work/WorkProjectGrid.astro';
import { caseStudies, otherWorkProjects } from '../data/work';
---

<Layout
	title="Work — Ashima Kaushik"
	description="Selected case studies and projects by Ashima Kaushik — brand identity, typography, editorial and design research."
	currentPath="/work"
>
	<main class="bg-canvas">
		<div class="mx-auto max-w-[75rem] px-[clamp(1rem,3vw,2rem)] pb-20 pt-10 md:pb-28 md:pt-14">
			<section aria-labelledby="case-studies-heading" class="scroll-mt-8">
				<SectionHeading id="case-studies-heading" title="Case Studies" />
				<div class="mt-10 md:mt-14">
					<WorkProjectGrid projects={caseStudies} />
				</div>
			</section>

			<section
				aria-labelledby="other-projects-heading"
				class="mt-20 scroll-mt-8 md:mt-28"
			>
				<SectionHeading id="other-projects-heading" title="Other Projects" />
				<div class="mt-10 md:mt-14">
					<WorkProjectGrid projects={otherWorkProjects} />
				</div>
			</section>
		</div>
	</main>
</Layout>
