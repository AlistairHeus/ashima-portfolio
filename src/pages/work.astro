---
/**
 * Work page — Figma Work Page_Final (149:558).
 * Assembles shared Layout / Navbar / Footer with reusable work components.
 */
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkProjectGrid from '../components/work/WorkProjectGrid.astro';
import { caseStudies, otherWorkProjects } from '../data/work';
import { withCaseStudyTitle } from '../data/case-studies';

const namedCaseStudies = caseStudies.map(withCaseStudyTitle);
const namedOtherProjects = otherWorkProjects.map(withCaseStudyTitle);
---

<Layout
	title="Work — Ashima Kaushik"
	description="Selected case studies and projects by Ashima Kaushik — brand identity, typography, editorial and design research."
	currentPath="/work"
>
	<main class="bg-canvas" data-work-page data-work-intro="pending">
		<div class="work-page page-shell pb-16 pt-8 md:pb-20 md:pt-10 2xl:pb-28 2xl:pt-14">
			<section aria-labelledby="case-studies-heading" class="scroll-mt-8">
				<div data-work-intro="heading">
					<SectionHeading id="case-studies-heading" title="Case Studies" />
				</div>
				<div class="mt-8 md:mt-10 2xl:mt-14">
					<WorkProjectGrid projects={namedCaseStudies} />
				</div>
			</section>

			<section
				aria-labelledby="other-projects-heading"
				class="mt-16 scroll-mt-8 md:mt-20 2xl:mt-28"
			>
				<div data-work-intro="heading">
					<SectionHeading id="other-projects-heading" title="Other Projects" />
				</div>
				<div class="mt-8 md:mt-10 2xl:mt-14">
					<WorkProjectGrid projects={namedOtherProjects} />
				</div>
			</section>
		</div>
	</main>
</Layout>

<style>
	/* 75rem measure is already full at 1200px; keep 13-inch at 75% until 2xl. */
	.work-page {
		max-width: 56.25rem;
	}

	@media (width >= 96rem) {
		.work-page {
			max-width: 75rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		[data-work-page][data-work-intro='pending'] [data-work-intro='heading'],
		[data-work-page][data-work-intro='pending'] [data-work-intro='card'],
		[data-work-page][data-work-intro='running'] [data-work-intro='heading'],
		[data-work-page][data-work-intro='running'] [data-work-intro='card'] {
			opacity: 0;
		}
	}
</style>

<script is:inline>
	(() => {
		const root = document.querySelector('[data-work-page]');
		if (!root) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			root.setAttribute('data-work-intro', 'done');
			return;
		}
		root.setAttribute('data-work-intro', 'pending');
	})();
</script>

<script>
	import { initWorkIntro } from '../scripts/work-intro';

	const boot = () => {
		initWorkIntro();
	};

	void Promise.all([document.fonts?.ready ?? Promise.resolve()]).then(boot);
</script>
