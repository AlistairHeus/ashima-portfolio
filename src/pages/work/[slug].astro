---
/**
 * Case study detail page — shared shell for per-project narratives.
 * Landing (nav/hero/intro) is identical across studies; body content varies.
 */
import Layout from '../../layouts/Layout.astro';
import CaseStudyLanding from '../../components/case-study/CaseStudyLanding.astro';
import CaseStudyGallery from '../../components/case-study/CaseStudyGallery.astro';
import MythilaCaseStudyBody from '../../components/case-study/MythilaCaseStudyBody.astro';
import VivanCaseStudyBody from '../../components/case-study/VivanCaseStudyBody.astro';
import IglCaseStudyBody from '../../components/case-study/IglCaseStudyBody.astro';
import ConvergenceCaseStudyBody from '../../components/case-study/ConvergenceCaseStudyBody.astro';
import AksharChitraCaseStudyBody from '../../components/case-study/AksharChitraCaseStudyBody.astro';
import AirIndiaCaseStudyBody from '../../components/case-study/AirIndiaCaseStudyBody.astro';
import CaseStudyNav from '../../components/case-study/CaseStudyNav.astro';
import {
	caseStudyDetails,
	getAdjacentProjects,
	getCaseStudyById,
	allWorkProjects,
} from '../../data/case-studies';

export function getStaticPaths() {
	return caseStudyDetails.map((study) => ({
		params: { slug: study.id },
	}));
}

const { slug } = Astro.params;
const study = getCaseStudyById(slug ?? '');

if (!study) {
	throw new Error(`Unknown case study slug: ${slug}`);
}

const catalogueProject = allWorkProjects.find((project) => project.id === study.id);
const { previous, next } = getAdjacentProjects(study.id);

const pageTitle = `${study.title} — Ashima Kaushik`;
const pageDescription = study.description[0] ?? study.title;
const body = study.body ?? 'gallery';
const displayNumber = catalogueProject?.number ?? study.number ?? '';
---

<Layout
	title={pageTitle}
	description={pageDescription}
	currentPath="/work"
>
	<main class="bg-canvas">
		<CaseStudyLanding
			study={study}
			number={displayNumber}
			currentPath="/work"
		/>

		{
			body === 'mythila' && study.mythila ? (
				<MythilaCaseStudyBody content={study.mythila} />
			) : body === 'vivan' && study.vivan ? (
				<VivanCaseStudyBody content={study.vivan} />
			) : body === 'igl' && study.igl ? (
				<IglCaseStudyBody content={study.igl} />
			) : body === 'convergence' && study.convergence ? (
				<ConvergenceCaseStudyBody content={study.convergence} />
			) : body === 'akshar-chitra' && study.aksharChitra ? (
				<AksharChitraCaseStudyBody content={study.aksharChitra} />
			) : body === 'air-india' && study.airIndia ? (
				<AirIndiaCaseStudyBody content={study.airIndia} />
			) : (
				study.gallery &&
				study.feature && (
					<CaseStudyGallery gallery={study.gallery} feature={study.feature} />
				)
			)
		}

		<CaseStudyNav previous={previous} next={next} />
	</main>
</Layout>
