---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import FeaturedCaseStudies from '../components/home/FeaturedCaseStudies.astro';
import OtherProjects from '../components/home/OtherProjects.astro';
---

<Layout
	title="Ashima Kaushik — Visual Communication Designer"
	description="Portfolio of Ashima Kaushik — visual communication design through research, strategy, typography and storytelling."
	currentPath="/"
>
	<main>
		<Hero />
		{/* Opaque panels slide over the fixed hero */}
		<div class="relative z-10">
			<FeaturedCaseStudies />
			<OtherProjects />
		</div>
	</main>
</Layout>
